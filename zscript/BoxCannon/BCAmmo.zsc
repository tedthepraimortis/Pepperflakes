//   The L&M Box Cannon Assembly-24 became the official carry of WAC Operatives
// shortly after the faliure to stop the cult at Conluz when the cult shut
// themselves in after they began losing manpower to the experienced military
// unit. Despite best efforts of the W.I.N.G. Unit that infiltrated to stop the
// cult at the source, Conluz finally succedded in summoned mass swathes of
// demons that all parties were powerless to stop as they took over surrounding
// areas and pushed back humanity.
//   Now the WAC is tasked with reclaiming land by force, while the special
// operatives of the W.I.N.G. Unit reclaim more sensitive locations that cannot
// support or fit troops larger than a small squad.
//   New demons have been spotted, recognized as forces of the Tyrant showing up
// in former Conluz occupied territory. Perhaps the well goes deeper than the
// WAC could have possibly thought... (i added this just for the line count lol.)

const HDLD_MAUSCLIP="910";
const ENC_MAUSCLIP_EMPTY=(ENC_776CLIP_EMPTY*0.8);

class HD9mClip:HDMagAmmo{
	default{
		hdmagammo.maxperunit 10;
		hdmagammo.roundtype "HDPistolAmmo";
		hdmagammo.roundbulk ENC_9;
		hdmagammo.inserttime 4;
		hdmagammo.extracttime 3;
		hdmagammo.magbulk ENC_MAUSCLIP_EMPTY;
		hdpickup.refid HDLD_MAUSCLIP;
		tag "9mm clip";
		inventory.pickupmessage "Picked up a 9mm clip.";
		scale 0.6;
		inventory.maxamount 1000;
	}
	override string,string,name,double getmagsprite(int thismagamt){
		string magsprite;
		if(thismagamt>8)magsprite="9CLPA0";
		else if(thismagamt>6)magsprite="9CLPB0";
		else if(thismagamt>4)magsprite="9CLPC0";
		else if(thismagamt>2)magsprite="9CLPD0";
		else if(thismagamt>0)magsprite="9CLPE0";
		else magsprite="9CLPF0";
		return magsprite,"PRNDA0","HDPistolAmmo",1.5;
	}
	override void GetItemsThatUseThis(){
		itemsthatusethis.push("HDBoxCannon");
	}
	states(actor){
	spawn:
		9CLP ABCDE -1 nodelay{
			int amt=mags[0];
			if(amt>8)frame=0;
			else if(amt>6)frame=1;
			else if(amt>4)frame=2;
			else if(amt>2)frame=3;
			else if(amt>0)frame=4;
		}stop;
	spawnempty:
		9CLP F -1{
			brollsprite=true;brollcenter=true;
			roll=randompick(1,1,1,1,3,3,3,3,0,2)*90;
		}stop;
	}
}
class HD9mClipEmpty:IdleDummy{
	override void postbeginplay(){
		super.postbeginplay();
		HDMagAmmo.SpawnMag(self,"HD9mClip",0);
		destroy();
	}
}
// Nice line count ;D