class HDBreakerp90:PGWeapon{ //The actual gun representative of Breaker
	default{
		+hdweapon.fitsinbackpack
		weapon.selectionorder 25;
		weapon.slotnumber 2;
		weapon.slotpriority 1.15;
		inventory.pickupsound "misc/w_pkup";
		inventory.pickupmessage "$PEPPER_PICKUP_P90";
		inventory.maxamount 3;
		scale 0.4;
		weapon.bobrangex 0.22;
		weapon.bobrangey 0.9;
		obituary "$PEPPER_OBITUARY_P90";
		hdweapon.refid "p90";
		tag "$PEPPER_TAG_P90";
		inventory.icon "PNTKA0";
		hdweapon.barrelsize 19,0.5,1;
		
		hdweapon.loadoutcodes "
			\cufiremode - 0/1, 0 Semiauto, 1 Auto
			\cucivilian - 0/1, Semi-Only Civilian Model
			\cugrip - 0/1, Foregrip (Civilian Only)";
	}
	override bool AddSpareWeapon(actor newowner){return AddSpareWeaponRegular(newowner);}
	override hdweapon GetSpareWeapon(actor newowner,bool reverse,bool doselect){return GetSpareWeaponRegular(newowner,reverse,doselect);}
	override void tick(){
		super.tick();
		drainheat(PEENS_HEAT,12);
	}
	override void postbeginplay(){
		super.postbeginplay();
		weaponspecial=1337; //weppin sling
		if(weaponstatus[0]&PEENF_CIVVIE){
			weaponstatus[PEENS_AUTO]=0;
			barrellength=28;
		}
	}
	override double gunmass(){
			return 6.0+weaponstatus[PEENS_MAG]*0.01;
	}
	override string,double getpickupsprite(){
		string spr="PNTK";

		//set to no-mag frame
		if(weaponstatus[0]&PEENF_CIVVIE){
			if(weaponstatus[PEENS_UB]==0)spr=(weaponstatus[PEENS_MAG]<0?spr.."D":spr.."C");
			if(weaponstatus[PEENS_UB]==1)spr=(weaponstatus[PEENS_MAG]<0?spr.."F":spr.."E");
			if(weaponstatus[PEENS_UB]==2)spr=(weaponstatus[PEENS_MAG]<0?spr.."H":spr.."G");
		}
		else spr=(weaponstatus[PEENS_MAG]<0?spr.."B":spr.."A");;

		return spr.."0",1.;
	}
	override void DrawHUDStuff(HDStatusBar sb,HDWeapon hdw,HDPlayerPawn hpl){
		if(sb.hudlevel==1){
			int nextmagloaded=sb.GetNextLoadMag(hdmagammo(hpl.findinventory("HDNDMBigMag")));
			if(nextmagloaded>50){
				sb.drawimage("PNMGB0",(-46,-3),sb.DI_SCREEN_CENTER_BOTTOM);
			}else if(nextmagloaded<1){
				sb.drawimage("PNMGA0",(-46,-3),sb.DI_SCREEN_CENTER_BOTTOM,alpha:nextmagloaded?0.6:1.);
			}else sb.drawbar(
				"PNMGB0","PNEMPTY", //full,empty
				nextmagloaded,50,
				(-46,-3),-1,
				sb.SHADER_VERT,sb.DI_SCREEN_CENTER_BOTTOM
			);
			sb.drawnum(hpl.countinv("HDNDMBigMag"),-43,-8,sb.DI_SCREEN_CENTER_BOTTOM);
		}
		if(hd_debug){
			sb.drawnum(hdw.weaponstatus[PEENS_HEAT],-16,-18,sb.DI_SCREEN_CENTER_BOTTOM);
		}


		if(!(hdw.weaponstatus[0]&PEENF_CIVVIE))sb.drawwepcounter(hdw.weaponstatus[PEENS_AUTO],
			-22,-10,"RBRSA3A7","STFULAUT"
		);
		int lod=clamp(hdw.weaponstatus[PEENS_MAG],0,50);
		sb.drawwepnum(lod,50);
		int njm=hdw.weaponstatus[0]&PEENF_PUSSY;
		if(hdw.weaponstatus[0]&PEENF_CHAMBER){
			sb.drawrect(-19,(njm?-11:-10),3,1);
			lod++;
		}
	}
	override string gethelptext(){
		return
		LWPHELP_FIRESHOOT
		..LWPHELP_RELOAD.."  Put mag in\n"
		..((weaponstatus[0]&PEENF_CIVVIE)?"":
			(LWPHELP_FIREMODE.."  Switch to "..(weaponstatus[PEENS_AUTO]>0?"Semi":"Auto").." mode\n")
		)
		..LWPHELP_MAGMANAGER
		..LWPHELP_UNLOAD..(weaponstatus[0]&PEENF_JAMMED?" Unjam gun\n":" Take mag out\n")
		;
	}
	override void DrawSightPicture(
		HDStatusBar sb,HDWeapon hdw,HDPlayerPawn hpl,
		bool sightbob,vector2 bob,double fov,bool scopeview,actor hpc,string whichdot
	){
		int cx,cy,cw,ch;
		[cx,cy,cw,ch]=screen.GetClipRect();
		sb.SetClipRect(
			-8+bob.x,-4+bob.y,16,16,
			sb.DI_SCREEN_CENTER
		);
		vector2 bobb=bob*1.18;
		if(hdw.weaponstatus[0]&PEENF_EIGHT){
			sb.drawimage(
				(hdw.weaponstatus[0]&PEENF_JAMMED?"br8klmao":"8TOTHE8"),(0,-8)+bobb,sb.DI_SCREEN_CENTER|sb.DI_ITEM_TOP,
				alpha:0.9,scale:(0.6,0.6)
			);
		}else{
			sb.drawimage(
				(hdw.weaponstatus[0]&PEENF_JAMMED?"PNFSjamd":"PNFrntST"),(0,-8)+bobb,sb.DI_SCREEN_CENTER|sb.DI_ITEM_TOP,
				alpha:0.9,scale:(0.6,0.6)
			);
		}
		sb.SetClipRect(cx,cy,cw,ch);
		sb.drawimage(
			"PNBackST",(0,-8)+bob,sb.DI_SCREEN_CENTER|sb.DI_ITEM_TOP,
			scale:(0.6,0.6)
		);
	}
	override double weaponbulk(){
		double blx=80;
		int mgg=weaponstatus[PEENS_MAG];
		bool civ=weaponstatus[0]&PEENF_CIVVIE;
		int ubr=weaponstatus[PEENS_UB];
		return blx+(mgg<0?0:(ENC_P90MAG_LOADED+mgg*ENC_9_LOADED))+(civ?5:0)+(ubr>0?10:0);
	}
	override void failedpickupunload(){
		failedpickupunloadmag(PEENS_MAG,"HDNDMBigMag");
	}
	override void DropOneAmmo(int amt){
		if(owner){
			amt=clamp(amt,1,10);
			if(owner.countinv("HDNDMLoose"))owner.A_DropInventory("HDNDMLoose",amt*50);
			else owner.A_DropInventory("HDNDMBigMag",amt);
		}
	}
	override void ForceBasicAmmo(){
		owner.A_TakeInventory("HDNDMLoose");
		owner.A_TakeInventory("HDNDMBigMag");
		owner.A_GiveInventory("HDNDMBigMag");
	}
	override inventory createtossable(){
		let ctt=HDBreakerp90(super.createtossable());
		if(!ctt)return null;
		if(ctt.bmissile){
			if(ctt.weaponstatus[0]&PEENF_JAMMED&&random(1,7)==7)ctt.weaponstatus[0]&=~PEENF_JAMMED;
			else ctt.weaponstatus[0]|=PEENF_JAMMED;
		}
		return ctt;
	}
	action void A_SpillNDM(){ //spill a single round of NDM
		double fc=max(pitch*0.01,5);
		double cosp=cos(pitch);
		actor ndmsp;
		[cosp,ndmsp]=A_SpawnItemEx("HDNDMLoose",
			cosp*12,0,height-12-sin(pitch)*12,
			cosp*fc,0.2*random(-3,3),-sin(pitch)*fc,
			0,SXF_NOCHECKPOSITION|SXF_TRANSFERPITCH
		);
		ndmsp.vel+=vel;
	}
	action void A_CheckPNSprite(){ //>arrive at the gym on PNS inspection day >try to leave >the doors are already locked >mfw
		bool hasmag=invoker.weaponstatus[PEENS_MAG]>=0; //no mag loaded
		if(hasmag)player.getpsprite(PSP_WEAPON).sprite=getspriteindex("BTPNA0");
		else player.getpsprite(PSP_WEAPON).sprite=getspriteindex("BTPEA0");
	}
	states{
	ready:
		BTPN A 0 {
			A_CheckPNSprite();
			A_CheatFail();
		}
		#### A 1 A_WeaponReady(WRF_ALL); 
		goto readyend;
	firemode:
		---- A 1{
			if(!(invoker.weaponstatus[0]&PEENF_CIVVIE))
			{
				if(invoker.weaponstatus[PEENS_AUTO]>=1)invoker.weaponstatus[PEENS_AUTO]=0;  
				else invoker.weaponstatus[PEENS_AUTO]++;
				A_SetHelpText();
				A_WeaponReady(WRF_NONE);
			}
		}
		goto nope;

	select0:
		BTPN A 0;
		#### A 0 A_CheckPNSprite();
		goto select0big;
	deselect0:
		BTPN A 0;
		#### A 0 A_CheckPNSprite();
		goto deselect0big;
	flash:
		BTPN F 1 bright{
			double cvel=1.16;
			double cacc=1.24;
			if(invoker.weaponstatus[0]&PEENF_CIVVIE){
				cvel=1.26;
				cacc=1.14;
			}
			A_Light1();
			HDFlashAlpha(-16);
			A_StartSound("weapons/bp90fire",CHAN_WEAPON);
			A_ZoomRecoil(max(0.95,1.-0.05*min(invoker.weaponstatus[PEENS_AUTO],3)));

			double brnd=(invoker.weaponstatus[PEENS_HEAT]);
			HDBulletActor.FireBullet(self,"HDB_NDM",
				spread:cacc,speedfactor:cvel
			);
			if(invoker.weaponstatus[PEENS_UB]==1)
				A_MuzzleClimb(
					-frandom(0.1,0.12),-frandom(0.15,0.13),
					-frandom(0.1,0.12),-frandom(0.15,0.13)
				);
			else A_MuzzleClimb(
					-frandom(0.24,0.30),-frandom(0.32,0.4),
					-frandom(0.24,0.30),-frandom(0.32,0.4)
				);
			invoker.weaponstatus[PEENS_HEAT]+=random(3,5);
			invoker.weaponstatus[PEENS_FLAGS]&=~PEENF_CHAMBER;
			A_AlertMonsters(256);
		}
		goto lightdone;
	jam:
		---- A 0{if(
					(!(invoker.weaponstatus[0]&PEENF_CHAMBER)&&invoker.weaponstatus[PEENS_MAG]<1)
					||invoker.weaponstatus[0]&PEENF_PUSSY
				){
				invoker.weaponstatus[0]&=~PEENF_JAMMED;
				setweaponstate("ready");
				}
			}
		---- A 4 offset(-1,36)A_WeaponBusy();
		---- A 8 offset(-3,42){A_StartSound("weapons/bp90click",CHAN_WEAPON);}
		---- A 3 offset(-1,36);
		---- A 0 offset(0,34);
		goto nope;
	fire:
		---- A 0{
			if(invoker.weaponstatus[0]&PEENF_JAMMED)setweaponstate("jam");
			if(invoker.weaponstatus[PEENS_AUTO]>0)A_SetTics(1);
			}
		---- A 2 A_JumpIf(!(invoker.weaponstatus[PEENS_AUTO]),"shootgun");
		---- A 1;
		goto shootgun;
	hold:
		---- A 0 A_JumpIf(invoker.weaponstatus[PEENS_AUTO],"shootgun");
	althold:
		---- A 1;
		---- A 0 A_Refire();
		goto ready;
	shootgun:
		---- A 0;
		---- A 1{
			if(invoker.weaponstatus[0]&PEENF_JAMMED)setweaponstate("jam");
			else if(
					!(invoker.weaponstatus[PEENS_FLAGS]&PEENF_CHAMBER)
					&&invoker.weaponstatus[PEENS_MAG]<1
			){
				setweaponstate("nope");
			}else if(!(invoker.weaponstatus[PEENS_FLAGS]&PEENF_CHAMBER)){
				//no shot but can chamber
				setweaponstate("chamber_manual");
			}else{
				A_GunFlash();
				A_EjectCasing("HDSpentNDM",
				frandom(-0.5,0.5),
				(frandom(-0.5,0.5),frandom(-0.5,0.5),-4),
				(-4,0,-6)
				);
				A_WeaponReady(WRF_NONE);
			}
		}
	chamber:
		---- A 0 offset(0,32){
			if(invoker.weaponstatus[PEENS_MAG]<1){
				setweaponstate("nope");
				return;
			}
			if(invoker.weaponstatus[PEENS_MAG]>0){  
				invoker.weaponstatus[PEENS_MAG]--;
				invoker.weaponstatus[PEENS_FLAGS]|=PEENF_CHAMBER;
			}else{
				invoker.weaponstatus[PEENS_MAG]=min(invoker.weaponstatus[PEENS_MAG],0);
				A_StartSound("weapons/bp90chamber",CHAN_WEAPON,CHANF_OVERLAP);
			}
			if(random(1,300)<(invoker.weaponstatus[PEENS_HEAT]-1))
				invoker.weaponstatus[0]|=PEENF_JAMMED;
			A_WeaponReady(WRF_NOFIRE);
		}
		---- A 0 A_JumpIf(invoker.weaponstatus[PEENS_AUTO]<1,"nope");
		---- A 1 A_JumpIf(invoker.weaponstatus[PEENS_AUTO]>1,1); //Determines firing speed
		---- A 0 A_Refire();
		goto ready;

	user3:
		---- A 0 A_MagManager("HDNDMBigMag");
		goto ready;

	user4:
	unload:
		---- A 0{
			if(
				invoker.weaponstatus[PEENS_MAG]>=0  
			){
				setweaponstate("unloadmag");
			}else if(
				invoker.weaponstatus[PEENS_FLAGS]&PEENF_CHAMBER
			){
				setweaponstate("unloadchamber");
			}else{
				setweaponstate("nope");
			}
		}
		goto nope;
	reload:
		---- A 0{
			if(
				invoker.weaponstatus[PEENS_MAG]>=50
			){
				setweaponstate("nope");
			}else if(!HDMagAmmo.NothingLoaded(self,"HDNDMBigMag")
				&&invoker.weaponstatus[PEENS_MAG]<0){
				setweaponstate("loadmag");
			}
			else if(invoker.weaponstatus[PEENS_MAG]<0&&countinv("HDNDMLoose")>0){
				setweaponstate("loadchamber");
			}
		}goto nope;
	unloadmag:
		---- A 1 offset(0,33);
		---- A 1 offset(-3,34);
		---- A 1 offset(-8,37);
		---- A 2 offset(-11,39){
			if(	//no mag, skip unload
				invoker.weaponstatus[PEENS_MAG]<0
			){
				setweaponstate("magout");
			}
		}
		---- A 4 offset(-12,40){
			A_SetPitch(pitch-0.3,SPF_INTERPOLATE);
			A_SetAngle(angle-0.3,SPF_INTERPOLATE);
			A_StartSound("weapons/bp90unload",CHAN_WEAPON);
		}
		---- A 0{if(invoker.weaponstatus[0]&PEENF_JAMMED)setweaponstate("unjamstart");}
		BTPE A 24 offset(-14,44){
			//A_CheckPNSprite();
			int inmag=invoker.weaponstatus[PEENS_MAG];
			invoker.weaponstatus[PEENS_MAG]=-1;
			if(
				!PressingUnload()&&!PressingReload()
				||A_JumpIfInventory("HDNDMBigMag",0,"null")
			){
				HDMagAmmo.SpawnMag(self,"HDNDMBigMag",inmag);
				A_SetTics(1);
			}else{
				HDMagAmmo.GiveMag(self,"HDNDMBigMag",inmag);
				A_StartSound("weapons/pocket",CHAN_WEAPON);
			}
		}
		goto reloadend;
	unjamstart:
		BTPE A 24 offset(-14,44){
			A_WeaponBusy();
			A_SetTics(1);
		}
	spaghettimag: //All of the rounds, all of them
		---- A 1{
			invoker.weaponstatus[PEENS_MAG]--;
			A_SpillNDM();
			A_StartSound("weapons/bp90chamber",8);
		}
		---- A 0{
			if(invoker.weaponstatus[PEENS_MAG]>0)setweaponstate("spaghettimag");
		}
		---- A 1{
			invoker.weaponstatus[0]&=~PEENF_CHAMBER;
			A_SpillNDM();
			A_StartSound("weapons/bp90chamber",8);
		}
		---- A 0{
			HDMagAmmo.SpawnMag(self,"HDNDMBigMag",0);
			invoker.weaponstatus[PEENS_MAG]=-1;
			invoker.weaponstatus[0]&=~PEENF_JAMMED;
		}
		goto nope;
	loadmag:
		---- A 1 offset(0,33);
		---- A 1 offset(-3,34);
		---- A 1 offset(-8,37);
		---- A 2 offset(-11,39);
		---- A 16 offset(-15,45)A_StartSound("weapons/bp90load",CHAN_WEAPON);
		BTPN A 1 offset(-14,44){
			let PNMG=HDNDMBigMag(findinventory("HDNDMBigMag"));
			if(!PNMG){setweaponstate("reloadend");return;}
			invoker.weaponstatus[PEENS_MAG]=PNMG.TakeMag(true);
			A_StartSound("weapons/bp90click2",CHAN_WEAPON);
		}goto reloadend;
	reloadend:
		---- A 2 offset(-11,39);
		---- A 1 offset(-8,37) A_MuzzleClimb(frandom(0.2,-2.4),frandom(0.2,-1.4));
		---- A 1 offset(-3,34);
		goto chamber_manual;

	chamber_manual:
		---- A 0 A_JumpIf(invoker.weaponstatus[PEENS_FLAGS]&PEENF_CHAMBER,"nope");
		---- A 4 offset(-1,36)A_WeaponBusy();
		---- A 8 offset(-3,42){
			if(!invoker.weaponstatus[PEENS_MAG])invoker.weaponstatus[PEENS_MAG]=0;
			if(
				!(invoker.weaponstatus[PEENS_FLAGS]&PEENF_CHAMBER)
				&& !(invoker.weaponstatus[PEENS_FLAGS]&PEENF_CHAMBER)
				&& invoker.weaponstatus[PEENS_MAG]>0
			){
				A_StartSound("weapons/bp90click",CHAN_WEAPON);
				invoker.weaponstatus[PEENS_MAG]--;
				invoker.weaponstatus[PEENS_FLAGS]|=PEENF_CHAMBER;
			}else setweaponstate("nope");
		}
		---- A 3 offset(-1,36);
		---- A 0 offset(0,34);
		goto nope;

	loadchamber:
		---- A 0 A_JumpIf(invoker.weaponstatus[0]&PEENF_CHAMBER,"nope");
		---- A 1 offset(0,36) A_StartSound("weapons/pocket",9);
		---- A 1 offset(2,40);
		---- A 1 offset(2,50);
		---- A 1 offset(3,60);
		---- A 2 offset(5,90);
		---- A 2 offset(7,80);
		---- A 2 offset(10,90);
		---- A 2 offset(8,96);
		---- A 3 offset(6,88){
			if(countinv("HDNDMLoose")){
				A_TakeInventory("HDNDMLoose",1,TIF_NOTAKEINFINITE);
				invoker.weaponstatus[0]|=PEENF_CHAMBER;
				A_StartSound("weapons/bp90chamber",8);
			}
		}
		---- A 2 offset(5,76);
		---- A 1 offset(4,64);
		---- A 1 offset(3,56);
		---- A 1 offset(2,48);
		---- A 2 offset(1,38);
		---- A 3 offset(0,34);
		goto readyend;
	unloadchamber:
		---- A 1 offset(-3,34);
		---- A 1 offset(-9,39);
		---- A 3 offset(-19,44) A_MuzzleClimb(frandom(-0.4,0.4),frandom(-0.4,0.4));
		---- A 2 offset(-16,42){
			if(invoker.weaponstatus[0]&PEENF_JAMMED)invoker.weaponstatus[0]&=~PEENF_JAMMED;
			A_MuzzleClimb(frandom(-0.4,0.4),frandom(-0.4,0.4));
			if(
				invoker.weaponstatus[PEENS_FLAGS]&PEENF_CHAMBER
			){
				A_SpawnItemEx("HDNDMLoose",0,0,20,
					random(4,7),random(-2,2),random(-2,1),0,
					SXF_NOCHECKPOSITION
				);
				invoker.weaponstatus[PEENS_FLAGS]&=~PEENF_CHAMBER;
				A_StartSound("weapons/bp90click2",CHAN_WEAPON,CHANF_OVERLAP);
			}
		}goto reloadend;
		
	spawn:
		PNTK ABCDEFGHIJKLMNOP -1{
			int mag=invoker.weaponstatus[PEENS_MAG];
			int ub=invoker.weaponstatus[PEENS_UB];
			
			//set to no-mag frame
			if(invoker.weaponstatus[0]&PEENF_EIGHT){
				if(invoker.weaponstatus[0]&PEENF_CIVVIE){
					if(ub==0)frame=(mag<0?11:10);
					if(ub==1)frame=(mag<0?13:12);
					if(ub==2)frame=(mag<0?15:14);
				}
				else frame=(mag<0?9:8);
			}
			else if(invoker.weaponstatus[0]&PEENF_CIVVIE){
				if(ub==0)frame=(mag<0?3:2);
				if(ub==1)frame=(mag<0?5:4);
				if(ub==2)frame=(mag<0?7:6);
			}
			else frame=(mag<0?1:0);
		}
	}
	override void InitializeWepStats(bool idfa){
		weaponstatus[0]|=PEENF_CHAMBER;
		weaponstatus[0]&=~PEENF_JAMMED;
		weaponstatus[PEENS_MAG]=50;
		if(!idfa && !owner){
			weaponstatus[PEENS_AUTO]=0; 
			weaponstatus[PEENS_HEAT]=0;
		}
	}
	override void loadoutconfigure(string input){
		weaponstatus[0]|=PEENF_CHAMBER;
		int firemode=getloadoutvar(input,"firemode",1);
		if(firemode>=0){
			weaponstatus[PEENS_AUTO]=clamp(firemode,0,1);
		}
		int civvie=getloadoutvar(input,"civ",1);
		if(civvie>=0)weaponstatus[0]|=PEENF_CIVVIE;
		int grip=getloadoutvar(input,"grip",1);
		if(grip>=0){
			weaponstatus[PEENS_UB]=1;
			weaponstatus[0]|=PEENF_CIVVIE;
		}
		int nades=getloadoutvar(input,"gl",1); //non-functional at the current moment
		if(nades>=0){
			weaponstatus[PEENS_UB]=2;
			weaponstatus[0]|=PEENF_CIVVIE;
		}
		int loser=getloadoutvar(input,"wahhhjammingtooscawwy",1); //filtered lmao
		if(
			loser>=0
			&&pepper_cheats
		)weaponstatus[0]|=PEENF_PUSSY;
		else if(loser>0)weaponstatus[0]|=CHEATF_FAIL;
		int eight=getloadoutvar(input,"eightfold",1);
		if(eight>=0)weaponstatus[0]|=PEENF_EIGHT;
		int vris=getloadoutvar(input,"too_l8_to_kiss_me_too_l8_to_kill_me",1);//add special later, for the freaks willing to type it out
		if(vris>=0){
			weaponstatus[0]|=PEENF_EIGHT;
			weaponstatus[0]&=~PEENF_CIVVIE;
			weaponstatus[PEENS_UB]=0;
		}
	}
}

//None of these values are correct, please edit.
const ENC_P90MAG=6;
const ENC_P90MAG_EMPTY=ENC_P90MAG*0.5;
const ENC_P90MAG_LOADED=ENC_P90MAG_EMPTY*0.5;
const HDLD_PRNMAG="n50";
class HDNDMBigMag:HDMagAmmo{
	default{
		+hdpickup.norandombackpackspawn;
		hdmagammo.maxperunit 50;
		hdmagammo.roundtype "HDNDMLoose";
		hdmagammo.roundbulk ENC_9_LOADED;
		hdmagammo.magbulk ENC_P90MAG_EMPTY;
		hdmagammo.inserttime 10;
		hdmagammo.extracttime 2;
		scale .5;

		tag "BreakerTek Mag";
		hdpickup.refid HDLD_PRNMAG;
		inventory.pickupmessage "Picked up a plastic BreakerTek Mag.";
	}

	override void GetItemsThatUseThis(){
		itemsthatusethis.push("HDBreakerp90");
	}
	override string,string,name,double getmagsprite(int thismagamt){
		string magsprite=(thismagamt>0)?"PNMGB0":"PNMGA0";
		return magsprite,"NRNDA0","HDNDMLoose",0.6;
	}
	states{
	spawn:
		PNMG B -1 nodelay;
		stop;
	spawnempty:
		PNDM A -1{
			brollsprite=true;brollcenter=true;
			roll=randompick(0,2)*90;
		}stop;
	}
}
class HDNDMBigEmptyMag:IdleDummy{
	override void postbeginplay(){
		super.postbeginplay();
		HDMagAmmo.SpawnMag(self,"HDNDMBigMag",0);
		destroy();
	}
}

enum peeninetystatus{
	PEENF_CHAMBER=1,
	PEENF_CIVVIE=2,
	PEENF_JAMMED=4,
	PEENF_EIGHT=8,
	PEENF_PUSSY=16,

	PEENS_FLAGS=0,
	PEENS_MAG=1, //-1 is empty
	PEENS_AUTO=2, //2 is burst, 2-5 counts ratchet
	PEENS_HEAT=3,	
	PEENS_UB=4, //0 Empty, 1 grip, 2 masterkey
};

class PNSpawn:IdleDummy{
	override void postbeginplay(){
		super.postbeginplay();
		A_SpawnItemEx("HDNDMBigMag",-1,-1,flags:SXF_NOCHECKPOSITION);
		if(random(0,2))A_SpawnItemEx("HDFragGrenadeAmmo",-3,-3,flags:SXF_NOCHECKPOSITION);
		if(random(0,2))A_SpawnItemEx("HDFragGrenadeAmmo",-3,-3,flags:SXF_NOCHECKPOSITION);

		bool _; Actor wep;
		[_, wep] = A_SpawnItemEx("HDBreakerp90",1,1,flags:SXF_NOCHECKPOSITION);
		HDF.TransferSpecials(self, wep);

		destroy();
	}
}
