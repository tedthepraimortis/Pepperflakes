class HDOddball:PGWeapon{
	default{
		+hdweapon.fitsinbackpack
		+hdweapon.reverseguninertia
		Weapon.SelectionOrder 60;
		Weapon.SlotNumber 2;
		weapon.slotpriority 1.1;
		scale 0.6;
		weapon.bobrangex 0.22;
		weapon.bobrangey 0.9;
		PGWeapon.CustomPickupMsg True;
		Inventory.PickupMessage "$PEPPER_PICKUP_ODDBALL";
		obituary "$PEPPER_OBITUARY_ODDBALL";
		hdweapon.refid "odd";
		hdweapon.barrelsize 20,0.3,0.5;
		Tag "$PEPPER_TAG_ODDBALL";
		inventory.maxamount 3;
		
		hdweapon.loadoutcodes "
			\cupump - 0/1, Changes the crank for a pump
			\cu(This is useful for multiplayer or lag)";
	}
	override double weaponbulk(){
		return 69; //it was gonna be 70 blocks anyways
	}
	override double gunmass(){
		return 5.5; //previous 11
	}
	override void consolidate(){
		weaponstatus[ODDS_BATTERY]=60;
	}
	override string,double getpickupsprite(){return "ODPAA0",1.;}
	override void DrawHUDStuff(HDStatusBar sb,HDWeapon hdw,HDPlayerPawn hpl){
		int bat=hdw.weaponstatus[ODDS_BATTERY];
		sb.drawwepnum(clamp(bat,0,15),15);
		sb.drawwepnum(clamp(bat-15,0,15),15,posy:-8);
		sb.drawwepnum(clamp(bat-30,0,15),15,posy:-10);
		sb.drawwepnum(clamp(bat-45,0,15),15,posy:-12);
		sb.drawnum(hdw.weaponstatus[ODDS_BATTERY],-44,-14,sb.DI_SCREEN_CENTER_BOTTOM|sb.DI_TEXT_ALIGN_RIGHT,Font.CR_LIGHTBLUE);
	}
	override string gethelptext(){
		return
		LWPHELP_FIRE..(weaponstatus[0]&ODDF_CRANK?" / "..LWPHELP_ALTFIRE..(weaponstatus[0]&ODDF_PUMP?" Slide Pump\n":"  Turn Crank\n"):"  Shoot\n")
		..LWPHELP_RELOAD.." / "..LWPHELP_UNLOAD..(weaponstatus[0]&ODDF_PUMP?
		(weaponstatus[0]&ODDF_CRANK?"  Release Slide\n":"  Grab Slide\n"):
		(weaponstatus[0]&ODDF_CRANK?"  Release Crank\n":"  Grab Crank\n"))
		..LWPHELP_MAGMANAGER
		;
	}
	override void DrawSightPicture(
		HDStatusBar sb,HDWeapon hdw,HDPlayerPawn hpl,
		bool sightbob,vector2 bob,double fov,bool scopeview,actor hpc,string whichdot
	){
		int cx,cy,cw,ch;
		[cx,cy,cw,ch]=screen.GetClipRect();
		vector2 scc;
		vector2 bobb=bob*1.3;
		{
			sb.SetClipRect(
				-8+bob.x,-4+bob.y,16,10,
				sb.DI_SCREEN_CENTER
			);
			scc=(0.8,0.8);
		}
		sb.drawimage(
			"oddbfrst",(0,0)+bobb,sb.DI_SCREEN_CENTER|sb.DI_ITEM_TOP,
			alpha:0.9,scale:scc
		);
		sb.SetClipRect(cx,cy,cw,ch);
		sb.drawimage(
			"oddbbkst",(0,0)+bob,sb.DI_SCREEN_CENTER|sb.DI_ITEM_TOP,
			scale:scc
		);
	}
	override void DetachFromOwner(){
		weaponstatus[0]&=~ODDF_CRANK;
		weaponstatus[0]&=~ODDF_RIGHT;
		weaponstatus[0]&=~ODDF_LEFT;
		Super.DetachFromOwner();
	}
	action void A_CrankinIt(){ //Charging your crystals with a bro
		if(invoker.weaponstatus[ODDS_BATTERY]<60)
		invoker.weaponstatus[ODDS_BATTERY]++;
		A_AlertMonsters();
	}
	override bool AddSpareWeapon(actor newowner){return AddSpareWeaponRegular(newowner);}
	override hdweapon GetSpareWeapon(actor newowner,bool reverse,bool doselect){return GetSpareWeaponRegular(newowner,reverse,doselect);}
	states{
	Spawn:
		ODPA A -1;
		stop;
	Select0:
		TNT1 A 0{
			invoker.weaponstatus[0]&=~ODDF_CRANK;
			invoker.weaponstatus[0]&=~ODDF_RIGHT;
			invoker.weaponstatus[0]&=~ODDF_LEFT;
			}
	Riseup:
		D3UP AA 0 A_raise;
		D3UP AAAAA 0 A_raise;
		ODBL A 1;
		loop;
	
	Ready:
		ODBL A 1{
			A_weaponready(WRF_ALL);
			A_WeaponBusy(false);
			A_CheatFail();
			}
		goto Readyend;
	Deselect0:
		TNT1 A 0{
			A_JumpIf(invoker.weaponstatus[0]&ODDF_RIGHT,"RightSwitchAway");
			A_JumpIf(invoker.weaponstatus[0]&ODDF_LEFT,"LeftSwitchAway");
			}
		ODBL A 1 A_lower;
		TNT1 AAA 0 A_lower;
		ODBL A 1 A_lower;
		loop;
	RightSwitchAway:
		TNT1 A 0{
			invoker.weaponstatus[0]&=~ODDF_CRANK;
			invoker.weaponstatus[0]&=~ODDF_RIGHT;
			invoker.weaponstatus[0]&=~ODDF_LEFT;
			}
		ODBL G 2;
		ODBL CB 1;
		ODBL A 1 offset(1,31);
		goto Deselect0;
	LeftSwitchAway:
		TNT1 A 0{
			invoker.weaponstatus[0]&=~ODDF_CRANK;
			invoker.weaponstatus[0]&=~ODDF_RIGHT;
			invoker.weaponstatus[0]&=~ODDF_LEFT;
			}
		ODBL LMNG 2;
		ODBL CB 1;
		ODBL A 1 offset(1,31);
		goto Deselect0;
		
	Fire:
		TNT1 A 0{
			if(invoker.weaponstatus[0]&ODDF_CRANK){
				if(invoker.weaponstatus[0]&ODDF_PUMP)setweaponstate("PumpCheck");
				else setweaponstate("RightCrankCheck");
				}
			}
		TNT1 A 0{
			if(invoker.weaponstatus[ODDS_BATTERY]>0){
				A_AlertMonsters();
				setweaponstate("NormalShot");
			}
		}
		goto ready;
	Altfire:
		TNT1 A 0{
			if(invoker.weaponstatus[0]&ODDF_CRANK){
				if(invoker.weaponstatus[0]&ODDF_PUMP)setweaponstate("PumpCheck");
				else setweaponstate("LeftCrankCheck");
				}
			}
		ODBL A 1;
		goto ready;
		
	NormalShot:
		TNT1 A 0{
			bool nut=invoker.weaponstatus[0]&ODDF_NUT;
			A_GunFlash("OddFlash");
			A_PlaySound("Oddball/NormalShot", CHAN_WEAPON);
			int chg=invoker.weaponstatus[ODDS_BATTERY];
			let bbb=HDBulletActor.FireBullet(self,"HDB_ODD",spread:nut?18:2.,speedfactor:frandom(0.97,1.03),nut?chg:1);
			if(nut)invoker.weaponstatus[ODDS_BATTERY]=0;
			else invoker.weaponstatus[ODDS_BATTERY]--;
			A_MuzzleClimb(-frandom(-0.2,0.2),-frandom(0.2,0.3));
			}
		ODBL A 1 offset(-2,35);
		ODBL A 0 A_JumpIf(invoker.weaponstatus[ODDS_BATTERY]>16,3);
		ODBL A 1 offset(1,32);
		ODBL A 1 offset(-1,32);
		ODBL A 1 offset(2,32);
		TNT1 A 0 A_JumpIf(PressingFire(),"fire");
		goto ready;
	OddFlash:
		TNT1 A 0;
		ODBF A 1 bright;
		stop;
	Unload:
	Reload:
		TNT1 A 0 A_JumpIf(invoker.weaponstatus[0]&ODDF_CRANK,"StopThatCrap");
		ODBL A 1 offset(1,31);
		ODBL A 1 offset(2,30);
		TNT1 A 0 {
			A_weaponready(WRF_NOFIRE|WRF_NOSWITCH);
			if(invoker.weaponstatus[0]&ODDF_PUMP){
				setweaponstate("PumpReload");
				invoker.weaponstatus[0]|=ODDF_CRANK;
				A_SetHelpText();
				}
			}
		ODBL BC 2;
		ODBL DEFGH 2;
		TNT1 A 0{
			invoker.weaponstatus[0]|=ODDF_RIGHT;
			invoker.weaponstatus[0]|=ODDF_CRANK;
			A_SetHelpText();
		}
		goto RightCrankWait;
	PumpReload:
		ODPM AB 2;
		ODPM CDEF 2;
		TNT1 A 0{invoker.weaponstatus[0]|=ODDF_CRANK;}
		goto pumpwait;
	//Using the multiplayer-friendly pump-style mode.
	PumpWait: //ready to start jerkin' it
		ODPM F 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOBOB);
		loop;
	PumpCheck:
		TNT1 A 0 A_PlaySound("Oddball/PumpUp",0);
		TNT1 A 0 offset(1,29);
		ODPM GH 2{
			if(!PressingFire()&&!PressingAltFire())
			setweaponstate("PumpFail");
			}
		ODPM H 1 offset(0,30);
		ODPM H 0{
			if(!PressingFire()&&!PressingAltFire())
			setweaponstate("PumpFail");
			}
		TNT1 A 0 offset(-1,31);
		TNT1 A 0{A_CrankinIt();A_CrankinIt();A_CrankinIt();}
	MidCheck: //succeed and hold, anything before this ends prematurely
		ODPM I 1;
		TNT1 A 0 A_JumpIf(PressingFire()||PressingAltFire(),"MidCheck");
		goto pumpfinish;
	PumpFail: 
		ODPM JK 2 offset(-1,35);
		ODPM K 1 offset(0,34);
		ODPM F 1 offset(1,33);
		TNT1 A 0 offset(0,32);
		goto pumpwait;
	PumpFinish:
		TNT1 A 0 offset(-1,35);
		TNT1 A 0{
			A_PlaySound("Oddball/PumpDown",0);
			A_CrankinIt();
			}
		ODPM JK 2 {A_CrankinIt();A_CrankinIt();}
		ODPM K 1 offset(0,34);
		ODPM F 1 offset(1,33);
		TNT1 A 0 offset(0,32);
		goto pumpwait;
	
	//Waiting while the handle is all the way to the right
	RightCrankWait:
		ODBL H 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOBOB);
		loop;
	
	//If the player fucks up here it means they're actually on the left side
	RightCrankCheck:
		TNT1 A 0 A_JumpIf(invoker.weaponstatus[0]&ODDF_RIGHT,"RightCrank");
		TNT1 A 0 A_PlaySound("OddBall/Woopsie",0);
		ODBL L 2 offset(1,31);
		ODBL L 2 offset(-1,33);
		ODBL L 2 offset(1,31);
		ODBL L 2 offset(-1,33);
		ODBL L 2 offset(1,31);
		ODBL L 2 offset(-1,33);
		ODBL L 2 offset(1,31);
		ODBL L 2 offset(-1,33);
		ODBL L 10;
		goto LeftCrankWait;
	RightCrank:
		TNT1 A 0;
		TNT1 A 0{invoker.weaponstatus[0]&=~ODDF_RIGHT;}
		TNT1 A 0{invoker.weaponstatus[0]|=ODDF_LEFT;}
		TNT1 A 0 offset(1,29);
		TNT1 A 0 A_PlaySound("Oddball/Crank",0);
		ODBL HI 2 A_CrankinIt();
		TNT1 A 0 offset(0,30);
		ODBL JK 2 A_CrankinIt();
		TNT1 A 0 offset(-1,31);
		ODBL LL 2 A_CrankinIt();
		TNT1 A 0 offset(0,32);
		goto LeftCrankWait;
	
	//Waiting while the handle is all the way to the left
	LeftCrankWait:
		ODBL L 1 A_weaponready (WRF_ALLOWRELOAD|WRF_NOBOB);
		Loop;
	
	//If the player fucks up here it means they're actually on the right side
	LeftCrankCheck:
		TNT1 A 0 A_JumpIf(invoker.weaponstatus[0]&ODDF_LEFT,"LeftCrank");
		TNT1 A 0 A_PlaySound("OddBall/Woopsie",0);
		ODBL H 2 offset(-1,33);
		ODBL H 2 offset(1,31);
		ODBL H 2 offset(-1,33);
		ODBL H 2 offset(1,31);
		ODBL H 2 offset(-1,33);
		ODBL H 2 offset(1,31);
		ODBL H 2 offset(-1,33);
		ODBL H 2 offset(1,31);
		ODBL H 10;
		goto RightCrankWait;
	LeftCrank:
		TNT1 A 0 offset(-1,35);
		TNT1 A 0{
			invoker.weaponstatus[0]&=~ODDF_LEFT;
			invoker.weaponstatus[0]|=ODDF_RIGHT;
			A_PlaySound("Oddball/Crank",0);
		}
		ODBL LM 2 A_CrankinIt();
		TNT1 A 0 offset(0,34);
		ODBL NG 2 A_CrankinIt();
		TNT1 A 0 offset(1,33);
		ODBL HH 2 A_CrankinIt();
		TNT1 A 0 offset(0,32);
		goto RightCrankWait;
		
	Stopthatcrap:
		TNT1 A 0{
			invoker.weaponstatus[0]&=~ODDF_CRANK;
			invoker.weaponstatus[0]&=~ODDF_LEFT;
			A_SetHelpText();
			if(invoker.weaponstatus[0]&ODDF_PUMP)setweaponstate("Pumpstop");
			else if(invoker.weaponstatus[0]&ODDF_RIGHT)setweaponstate("Rightstop");
			invoker.weaponstatus[0]&=~ODDF_RIGHT;
			}
		ODBL LMNG 2;
		goto CrankStop;
	Rightstop:
		ODBL G 2{invoker.weaponstatus[0]&=~ODDF_RIGHT;}
		goto crankstop;
	Pumpstop:
		ODPM MNBA 2 A_SetCrosshair(21);
		goto ready;
	CrankStop:
		ODBL FOP 2{invoker.weaponstatus[0]&=~ODDF_RIGHT;}
		ODBL CB 2 A_SetCrosshair(21);
		ODBL A 1 offset(2,30);
		ODBL A 1 offset(1,31);
		TNT1 A 0 A_weaponready (WRF_NOFIRE|WRF_NOSWITCH);
		ODBL A 1;
		goto ready;
	user3:
		---- A 0 A_MagManager("HDBattery");
		goto ready;
	}
	override void initializewepstats(bool idfa){
		weaponstatus[ODDS_BATTERY]=60;
	}
	override void loadoutconfigure(string input){
		weaponstatus[0]&=~ODDF_CRANK;
		weaponstatus[0]&=~ODDF_RIGHT;
		weaponstatus[0]&=~ODDF_LEFT;
		int pump=getloadoutvar(input,"pump",1);
		if(pump>0)weaponstatus[0]|=ODDF_PUMP;
		int gforce=getloadoutvar(input,"gforceexperience",1); //and then passing out
		if(gforce>0){
			if(pepper_cheats)weaponstatus[0]|=ODDF_NUT;
			else weaponstatus[0]|=CHEATF_FAIL;
		}
	}
}
class OddballSpawn:IdleDummy{
	states{
	spawn:
		TNT1 A 0 nodelay{
			let zzz=HDOddball(spawn("HDOddball",pos,ALLOW_REPLACE));
			if(!zzz)return;
			HDF.TransferSpecials(self,zzz);
			for(int i=0;i<5;i++)zzz.args[i]=args[i];
			if(!random(0,2)){
				zzz.weaponstatus[0]|=ODDF_PUMP;
			}
		}stop;
	}
}

enum oddballstatus{
	ODDF_CRANK=1,
	ODDF_LEFT=2,
	ODDF_RIGHT=4,
	ODDF_PUMP=8,
	ODDF_NUT=16,

	ODDS_FLAGS=0,
	ODDS_BATTERY=1,
	ODDS_CHARGE=2
};
