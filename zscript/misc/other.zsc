const HDMLD_PGBLUR="blr";
const HDMLD_PGPOTION="pot";
const HDLD_PGRANDOM="pg?";
class Eric_Precious:HDPickupGiver{
	default{
		-hdpickup.fitsinbackpack
		hdpickup.refid HDMLD_PGBLUR;
		hdpickupgiver.pickuptogive "HDBlursphere";
		hdpickup.bulk ENC_DERP;
		tag "Blursphere";
	}
}

