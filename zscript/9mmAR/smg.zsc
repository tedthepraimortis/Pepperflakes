class HDHLAR:HDWeapon{
	default{
		//$Category "Weapons/Hideous Destructor"
		//$Title "SMG"
		//$Sprite "HLPIA0"

		+hdweapon.fitsinbackpack
		obituary "$PEPPER_OBITUARY_HLAR";
		weapon.selectionorder 30;
		weapon.slotnumber 2;
		weapon.slotpriority 0.5;
		weapon.kickback 30;
		weapon.bobrangex 0.3;
		weapon.bobrangey 0.6;
		weapon.bobspeed 2.5;
		scale 0.55;
		inventory.pickupmessage "$PEPPER_PICKUP_HLAR";
		hdweapon.barrelsize 26,0.5,1;
		hdweapon.refid "hlr";
		tag "$PEPPER_TAG_HLAR";
		inventory.icon "HLPIA0";
		
		hdweapon.loadoutcodes "
			\cufiremode - 0-2, 0 Semiauto, 1 Burst, 2 Auto
			\cuglready - 0/1, Hairtrigger GL Loaded
			\curevised - 0/1, Revised Trigger Group";
	}
	override bool AddSpareWeapon(actor newowner){return AddSpareWeaponRegular(newowner);}
	override hdweapon GetSpareWeapon(actor newowner,bool reverse,bool doselect){return GetSpareWeaponRegular(newowner,reverse,doselect);}
	override double gunmass(){
		return 6.5+((weaponstatus[HLARS_MAG]<0)?-0.5:(weaponstatus[HLARS_MAG]*0.05)+(weaponstatus[0]&HLARF_GRENADELOADED?1.:0.));
	}
	override double weaponbulk(){
		double blx=125;
		if(weaponstatus[0]&HLARF_GRENADELOADED)blx+=ENC_ROCKETLOADED;
		int mgg=weaponstatus[HLARS_MAG];
		return blx+(mgg<0?0:(+ENC_9MAG30_LOADED+mgg*ENC_9_LOADED));
	}
	override void failedpickupunload(){
		failedpickupunloadmag(HLARS_MAG,"HD9mMag30");
	}
	override void DropOneAmmo(int amt){
		if(owner){
			amt=clamp(amt,1,10);
			if(owner.countinv("HDPistolAmmo"))owner.A_DropInventory("HDPistolAmmo",amt*30);
			else {
				double angchange=-10;
				if(angchange)owner.angle-=angchange;
				owner.A_DropInventory("HD9mMag30",amt);
				if(angchange){
					owner.angle+=angchange*2;
					owner.A_DropInventory("HDRocketAmmo",amt);
					owner.angle-=angchange;
				}
			}
		}
	}
	override void postbeginplay(){
		super.postbeginplay();
		if(weaponstatus[HLARS_AUTO]>0){
		switch(weaponstatus[HLARS_SWITCHTYPE]){
		case 1:
			weaponstatus[HLARS_AUTO]=0;
			break;
		case 2:
			weaponstatus[HLARS_AUTO]=1;
			break;
		case 3:
			weaponstatus[HLARS_AUTO]=2;
			break;
		default:
			break;
		}}
		weaponspecial=1337;
	}
	override void ForceBasicAmmo(){
		owner.A_TakeInventory("HDPistolAmmo");
		ForceOneBasicAmmo("HD9mMag30");
	}
	override string,double getpickupsprite(){
		return "HLPI"..((weaponstatus[HLARS_MAG]<0)?"B":"A").."0",1.;
	}
	override void DrawHUDStuff(HDStatusBar sb,HDWeapon hdw,HDPlayerPawn hpl){
		if(sb.hudlevel==1){
			int nextmagloaded=sb.GetNextLoadMag(hdmagammo(hpl.findinventory("HD9mMag30")));
			if(nextmagloaded>=30){
				sb.drawimage("CLP3A0",(-46,-3),sb.DI_SCREEN_CENTER_BOTTOM,scale:(3,3));
			}else if(nextmagloaded<1){
				sb.drawimage("CLP3B0",(-46,-3),sb.DI_SCREEN_CENTER_BOTTOM,alpha:nextmagloaded?0.6:1.,scale:(3,3));
			}else sb.drawbar(
				"CLP3NORM","CLP3GREY",
				nextmagloaded,30,
				(-46,-3),-1,
				sb.SHADER_VERT,sb.DI_SCREEN_CENTER_BOTTOM
			);
			sb.drawnum(hpl.countinv("HD9mMag30"),-43,-8,sb.DI_SCREEN_CENTER_BOTTOM);
			sb.drawimage("ROQPA0",(-62,-4),sb.DI_SCREEN_CENTER_BOTTOM,scale:(0.6,0.6));
			sb.drawnum(hpl.countinv("HDRocketAmmo"),-56,-8,sb.DI_SCREEN_CENTER_BOTTOM);
		}
		if(weaponstatus[HLARS_SWITCHTYPE]!=1)sb.drawwepcounter(hdw.weaponstatus[HLARS_AUTO],
			-22,-10,"RBRSA3A7","STBURAUT","STFULAUT"
		);
		sb.drawwepnum(hdw.weaponstatus[HLARS_MAG],30);
		if(hdw.weaponstatus[0]&HLARF_GRENADELOADED)sb.drawrect(-20,-14,4,2.6);
		if(hdw.weaponstatus[HLARS_CHAMBER]==2)sb.drawrect(-19,-10,3,1);
		if(hdw.weaponstatus[0]&HLARF_GLMODE){
			DrawRifleGrenadeStatus(sb,hdw);
		}
	}
	override string gethelptext(){
		bool gl=(weaponstatus[0]&HLARF_ALTTRIGGER);
		bool glmode=gl&&(weaponstatus[0]&HLARF_GLMODE);
		return
		LWPHELP_FIRESHOOT
		..(gl?(LWPHELP_ALTFIRE..(glmode?("  SMG mode\n"):("  GL mode\n"))):LWPHELP_ALTFIRE.."  Shoot GL\n")
		..LWPHELP_RELOAD.."  Reload mag\n"
		..LWPHELP_ALTRELOAD.."	Reload GL\n"
		..LWPHELP_USE.."+"..LWPHELP_RELOAD.."  Reload chamber\n"
		..(glmode?(LWPHELP_FIREMODE.."+"..LWPHELP_UPDOWN.."  Airburst\n")
			:(
			(LWPHELP_FIREMODE.."  Semi/Burst/Auto\n")))
		..LWPHELP_MAGMANAGER
		..LWPHELP_UNLOAD..(glmode?("  Unload GL"):("  Unload mag \(Hold "..LWPHELP_FIREMODE.." to unload GL\)\n"))
		;
	}
	override void DrawSightPicture(
		HDStatusBar sb,HDWeapon hdw,HDPlayerPawn hpl,
		bool sightbob,vector2 bob,double fov,bool scopeview,actor hpc,string whichdot
	){
		int scaledyoffset=47;
		if(hdw.weaponstatus[0]&HLARF_GLMODE)sb.drawgrenadeladder(hdw.airburst,bob);
		else{
			int cx,cy,cw,ch;
			[cx,cy,cw,ch]=screen.GetClipRect();
			sb.SetClipRect(
				-24+bob.x,-26+bob.y,40,32,
				sb.DI_SCREEN_CENTER
			);
			vector2 bobb=bob*1.18;
			sb.drawimage(
				"9arftst",(0,-9)+bobb,sb.DI_SCREEN_CENTER|sb.DI_ITEM_TOP,
				alpha:0.8
			);
			sb.SetClipRect(cx,cy,cw,ch);
			sb.drawimage(
				"backsite",(0,0)+bob,sb.DI_SCREEN_CENTER|sb.DI_ITEM_TOP
			);
		}
	}
	states{
	select0:
		HLAR A 0 {
		if(!countinv("NulledWeapon"))invoker.weaponstatus[0]&=~HLARF_GLMODE;
		}goto select0big;
	deselect0:
		HLAR A 0;
		goto deselect0big;
		HLAR AB 0;
		SMSG AB 0;

	ready:
		HLAR A 0;
		#### A 1{
			A_SetCrosshair(21);
			invoker.weaponstatus[HLARS_RATCHET]=0;
			A_WeaponReady(WRF_ALL);
		}
		goto readyend;
	user3:
		---- A 0 A_MagManager("HD9mMag30");
		goto ready;
	althold:
		goto nope;
	hold:
		#### A 0 A_JumpIf(invoker.weaponstatus[0]&HLARF_GLMODE,"firefrag");
		#### A 0{
			if(
				//full auto
				invoker.weaponstatus[HLARS_AUTO]==2
			)setweaponstate("fire2");
			else if(
				//burst
				invoker.weaponstatus[HLARS_AUTO]<1
				||invoker.weaponstatus[HLARS_RATCHET]>2
			)setweaponstate("nope");
		}goto fire;
	user2:
	firemode:
		---- A 0 A_JumpIf(invoker.weaponstatus[0]&HLARF_GLMODE,"abadjust");
		---- A 1{
			if(invoker.weaponstatus[HLARS_AUTO]>=2)invoker.weaponstatus[HLARS_AUTO]=0;  
			else invoker.weaponstatus[HLARS_AUTO]++;
			A_WeaponReady(WRF_NONE);
		}
	firemodehold:
		HLAR A 1{
			if(pressingunload()
			&&(invoker.weaponstatus[HLARS_FLAGS]&HLARF_GRENADELOADED)){
			if(invoker.weaponstatus[HLARS_AUTO]==0)invoker.weaponstatus[HLARS_AUTO]=2;  
			else invoker.weaponstatus[HLARS_AUTO]--;
				invoker.weaponstatus[HLARS_FLAGS]|=HLARF_JUSTUNLOAD;
				setweaponstate("unloadgrenade");
			}else A_WeaponReady(WRF_NONE);
		}
		HLAR A 0 A_JumpIf(pressingfiremode()&&(invoker.weaponstatus[HLARS_FLAGS]&HLARF_GRENADELOADED),"firemodehold");
		goto nope;
	fire:
		#### A 0{
			if(!(invoker.weaponstatus[0]&HLARF_GLMODE))return;
			setweaponstate("firefrag");
			}
	fire2:
		#### B 1{
			if(invoker.weaponstatus[HLARS_CHAMBER]==2)A_GunFlash();
			else setweaponstate("chamber_manual");
		}
		#### A 1;
		#### A 1{
			if(invoker.weaponstatus[HLARS_CHAMBER]==1){
                A_EjectCasing("HDSpent9mm",
					frandom(-1,2),
					(frandom(0.2,0.3),-frandom(7,7.5),frandom(0,0.2)),
					(0,0,-2)
				);
				invoker.weaponstatus[HLARS_CHAMBER]=0;
			}
			if(invoker.weaponstatus[HLARS_MAG]>0){
				invoker.weaponstatus[HLARS_MAG]--;
				invoker.weaponstatus[HLARS_CHAMBER]=2;
			}
			A_WeaponReady(WRF_NOFIRE);
		}
		#### A 0 A_ReFire();
		goto ready;
		
	firefrag:
		HLAR A 1 A_JumpIf(invoker.weaponstatus[HLARS_FLAGS]&HLARF_GRENADELOADED,1);
		goto nope;
		HLAR A 1;
		HLAR A 3 A_Gunflash("nadeflash");
		goto nope;
		
	flash:
		#### B 0{
			let bbb=HDBulletActor.FireBullet(self,"HDB_9",speedfactor:1.30);
			A_AlertMonsters();

			A_ZoomRecoil(0.990);
			A_StartSound("weapons/hlar",CHAN_WEAPON,volume:0.7);
			invoker.weaponstatus[HLARS_RATCHET]++;
			invoker.weaponstatus[HLARS_CHAMBER]=1;
		}
		SMGF A 1 bright{
			HDFlashAlpha(-200);
			A_Light1();
		}
		TNT1 A 0 A_MuzzleClimb(-frandom(0.16,0.20),-frandom(0.24,0.30),-frandom(0.16,0.20),-frandom(0.24,0.30));
		goto lightdone;


	unloadchamber:
		#### B 4 A_JumpIf(invoker.weaponstatus[HLARS_CHAMBER]<1,"nope");
		#### B 10{
			class<actor>which=invoker.weaponstatus[HLARS_CHAMBER]>1?"HDPistolAmmo":"HDSpent9mm";
			invoker.weaponstatus[HLARS_CHAMBER]=0;
			A_SpawnItemEx(which,
				cos(pitch)*10,0,height-8-sin(pitch)*10,
				vel.x,vel.y,vel.z,
				0,SXF_ABSOLUTEMOMENTUM|SXF_NOCHECKPOSITION|SXF_TRANSFERPITCH
			);
		}goto readyend;
	loadchamber:
		---- A 0 A_JumpIf(invoker.weaponstatus[HLARS_CHAMBER]>0,"nope");
		---- A 0 A_JumpIf(!countinv("HDPistolAmmo"),"nope");
		---- A 1 offset(0,34) A_StartSound("weapons/pocket",9);
		---- A 1 offset(2,36);
		---- A 1 offset(2,44);
		#### B 1 offset(5,58);
		#### B 2 offset(7,70);
		#### B 6 offset(8,80);
		#### A 10 offset(8,87){
			if(countinv("HDPistolAmmo")){
				A_TakeInventory("HDPistolAmmo",1,TIF_NOTAKEINFINITE);
				invoker.weaponstatus[HLARS_CHAMBER]=2;
				A_StartSound("weapons/hlarchamber",8);
			}else A_SetTics(4);
		}
		#### A 3 offset(9,76);
		---- A 2 offset(5,70);
		---- A 1 offset(5,64);
		---- A 1 offset(5,52);
		---- A 1 offset(5,42);
		---- A 1 offset(2,36);
		---- A 2 offset(0,34);
		goto nope;
	user4:
	unload:
		#### A 0{
			invoker.weaponstatus[0]|=HLARF_JUSTUNLOAD;
			if(
				invoker.weaponstatus[HLARS_FLAGS]&HLARF_GLMODE
			){
				setweaponstate("unloadgrenade");
			}else if(
				invoker.weaponstatus[HLARS_MAG]>=0
			)setweaponstate("unmag");
			else if(invoker.weaponstatus[HLARS_CHAMBER]>0)setweaponstate("unloadchamber");
		}goto nope;
	reload:
		#### A 0{
			invoker.weaponstatus[0]&=~HLARF_JUSTUNLOAD;
			bool nomags=HDMagAmmo.NothingLoaded(self,"HD9mMag30");
			if(invoker.weaponstatus[HLARS_MAG]>=30)setweaponstate("nope");
			else if(
				invoker.weaponstatus[HLARS_MAG]<1
				&&(
					pressinguse()
					||nomags
				)
			){
				if(
					countinv("HDPistolAmmo")
				)setweaponstate("loadchamber");
				else setweaponstate("nope");
			}else if(nomags)setweaponstate("nope");
		}goto unmag;
	unmag:
		#### A 1 offset(0,34) A_SetCrosshair(21);
		#### A 1 offset(5,38);
		#### A 1 offset(10,42);
		#### B 2 offset(20,46);
		#### B 4 offset(30,52){
			A_MuzzleClimb(0.3,0.4);
			A_StartSound("weapons/hlarunload",8,CHANF_OVERLAP);
		}
		#### B 0{
			int magamt=invoker.weaponstatus[HLARS_MAG];
			if(magamt<0){
				setweaponstate("magout");
				return;
			}
			invoker.weaponstatus[HLARS_MAG]=-1;
			if(
				(!PressingUnload()&&!PressingReload())
				||A_JumpIfInventory("HD9mMag30",0,"null")
			){
				HDMagAmmo.SpawnMag(self,"HD9mMag30",magamt);
				setweaponstate("magout");
			}else{
				HDMagAmmo.GiveMag(self,"HD9mMag30",magamt);
				A_StartSound("weapons/pocket",9);
				setweaponstate("pocketmag");
			}
		}
	pocketmag:
		#### BB 7 offset(34,54) A_MuzzleClimb(frandom(0.2,-0.8),frandom(-0.2,0.4));
	magout:
		#### B 0{
			if(invoker.weaponstatus[0]&HLARF_JUSTUNLOAD)setweaponstate("reloadend");
			else setweaponstate("loadmag");
		}

	loadmag:
		#### B 0 A_StartSound("weapons/pocket",9);
		#### B 6 offset(34,54) A_MuzzleClimb(frandom(0.2,-0.8),frandom(-0.2,0.4));
		#### B 7 offset(34,52) A_MuzzleClimb(frandom(0.2,-0.8),frandom(-0.2,0.4));
		#### B 10 offset(32,50);
		#### B 3 offset(32,49){
			let mmm=hdmagammo(findinventory("HD9mMag30"));
			if(mmm){
				invoker.weaponstatus[HLARS_MAG]=mmm.TakeMag(true);
				A_StartSound("weapons/hlarload",8,CHANF_OVERLAP);
			}
			if(
				invoker.weaponstatus[HLARS_MAG]<1
				||invoker.weaponstatus[HLARS_CHAMBER]>0
			)setweaponstate("reloadend");
		}
		goto reloadend;

	reloadend:
		#### B 3 offset(30,52);
		#### B 2 offset(20,46);
		#### A 1 offset(10,42);
		#### A 1 offset(5,38);
		#### A 1 offset(0,34);
		goto chamber_manual;

	chamber_manual:
		#### A 0 A_JumpIf(
			invoker.weaponstatus[HLARS_MAG]<1
			||invoker.weaponstatus[HLARS_CHAMBER]==2
		,"nope");
		#### B 2 offset(3,32){
			A_StartSound("weapons/hlarchamber",8,CHANF_OVERLAP);
			A_WeaponBusy();
			invoker.weaponstatus[HLARS_MAG]--;
			invoker.weaponstatus[HLARS_CHAMBER]=2;
		}
		#### B 3 offset(5,35);
		#### A 1 offset(3,32);
		#### A 1 offset(2,31);
		goto nope;

	nadeflash:
		TNT1 A 0 A_JumpIf(invoker.weaponstatus[HLARS_FLAGS]&HLARF_GRENADELOADED,1);
		stop;
		TNT1 A 2{
			A_FireHDGL(firingsound:"weapons/hlargrenadeshot");
			invoker.weaponstatus[HLARS_FLAGS]&=~HLARF_GRENADELOADED;
			A_ZoomRecoil(0.95);
		}
		TNT1 A 2 A_MuzzleClimb(
			0,0,0,0,
			-1.2,-3.,
			-1.,-2.8
		);
		stop;

	altfire:
		HLAR A 0 {
			if(!(invoker.weaponstatus[0]&HLARF_ALTTRIGGER))return;
			invoker.weaponstatus[0]^=HLARF_GLMODE;
			invoker.airburst=0;
			A_SetCrosshair(21);
			A_SetHelpText();
			setweaponstate("nope");
		}
		HLAR A 1 A_JumpIf(invoker.weaponstatus[HLARS_FLAGS]&HLARF_GRENADELOADED,1);
		goto nope;
		HLAR A 1;
		HLAR A 3 {
		invoker.airburst=0;
		A_Gunflash("nadeflash");
		}
		goto nope;

	altreload:
		HLAR A 0{
			invoker.weaponstatus[HLARS_FLAGS]&=~HLARF_JUSTUNLOAD;
			if(
				!(invoker.weaponstatus[HLARS_FLAGS]&HLARF_GRENADELOADED)
				&&countinv("HDRocketAmmo")
			)setweaponstate("unloadgrenade");
		}goto nope;
	unloadgrenade:
		HLAR A 0{
			A_SetCrosshair(21);
			A_MuzzleClimb(-0.3,-0.3);
		}
		HLAR A 2 offset(0,34);
		HLAR A 1 offset(4,38){
			A_MuzzleClimb(-0.3,-0.3);
		}
		HLAR A 2 offset(8,48){
			A_StartSound("weapons/hlargrenopen",CHAN_WEAPon,CHANF_OVERLAP);
			A_MuzzleClimb(-0.3,-0.3);
			if(invoker.weaponstatus[HLARS_FLAGS]&HLARF_GRENADELOADED)A_StartSound("weapons/grenreload",CHAN_WEAPON);
		}
		HLAR A 8 offset(10,49){
			if(!(invoker.weaponstatus[HLARS_FLAGS]&HLARF_GRENADELOADED)){
				if(!(invoker.weaponstatus[HLARS_FLAGS]&HLARF_JUSTUNLOAD))A_SetTics(3);
				return;
			}
			invoker.weaponstatus[HLARS_FLAGS]&=~HLARF_GRENADELOADED;
			if(
				!PressingUnload()
				||A_JumpIfInventory("HDRocketAmmo",0,"null")
			){
				A_SpawnItemEx("HDRocketAmmo",
					cos(pitch)*10,0,height-10-10*sin(pitch),vel.x,vel.y,vel.z,0,
					SXF_ABSOLUTEMOMENTUM|SXF_NOCHECKPOSITION|SXF_TRANSFERPITCH
				);
			}else{
				A_StartSound("weapons/pocket",CHAN_WEAPON,CHANF_OVERLAP);
				A_GiveInventory("HDRocketAmmo",1);
				A_MuzzleClimb(frandom(0.8,-0.2),frandom(0.4,-0.2));
			}
		}
		HLAR A 0 A_JumpIf(invoker.weaponstatus[HLARS_FLAGS]&HLARF_JUSTUNLOAD,"greloadend");
	loadgrenade:
		HLAR A 2 offset(10,50) A_StartSound("weapons/pocket",CHAN_WEAPON,CHANF_OVERLAP);
		HLAR ABB 5 offset(10,50) A_MuzzleClimb(frandom(-0.2,0.8),frandom(-0.2,0.4));
		HLAR A 15 offset(8,50){
			A_TakeInventory("HDRocketAmmo",1,TIF_NOTAKEINFINITE);
			invoker.weaponstatus[HLARS_FLAGS]|=HLARF_GRENADELOADED;
			A_StartSound("weapons/hlargrenload",CHAN_WEAPON);
		}
	greloadend:
		HLAR A 4 offset(4,44) A_StartSound("weapons/hlargrenopen",CHAN_WEAPON);
		HLAR A 1 offset(0,40);
		HLAR A 1 offset(0,34) A_MuzzleClimb(frandom(-2.4,0.2),frandom(-1.4,0.2));
		goto nope;

	spawn:
		TNT1 A 1;
		HLPI A -1{
			if(invoker.weaponstatus[HLARS_MAG]<0)frame=1;
		}
		stop;
	}
	override void initializewepstats(bool idfa){
		weaponstatus[HLARS_MAG]=30;
		weaponstatus[HLARS_CHAMBER]=2;
		weaponstatus[0]|=HLARF_GRENADELOADED;
	}
	override void loadoutconfigure(string input){
		int firemode=getloadoutvar(input,"firemode",1);
		if(firemode>=0)weaponstatus[HLARS_AUTO]=clamp(firemode,0,2);
		
		int glready=getloadoutvar(input,"glready",1);
		if(!glready){weaponstatus[0]&=~HLARF_GRENADELOADED;}
		else if(glready>=0){weaponstatus[0]|=HLARF_GRENADELOADED;}
		
		int revised=getloadoutvar(input,"revised",1);
		if(!revised){weaponstatus[0]&=~HLARF_ALTTRIGGER;}
		else if(revised>=0){weaponstatus[0]|=HLARF_ALTTRIGGER;}
	}
}
enum hlarstatus{
	HLARF_JUSTUNLOAD=1,
	HLARF_GRENADELOADED=2,
	HLARF_ALTTRIGGER=4,
	HLARF_GLMODE=8,

	HLARN_SEMIONLY=1,
	HLARN_BURSTONLY=2,
	HLARN_FULLONLY=3,

	HLARS_FLAGS=0,
	HLARS_MAG=1,
	HLARS_CHAMBER=2, //0 empty, 1 spent, 2 loaded
	HLARS_AUTO=3, //0 semi, 1 burst, 2 auto
	HLARS_RATCHET=4,
	HLARS_SWITCHTYPE=5,
	HLARS_AIRBURST=6,
};

class ClipBoxPickupHLAR:IdleDummy{
	override void postbeginplay(){
		super.postbeginplay();
		A_SpawnItemEx("HD9mMag30",flags:SXF_NOCHECKPOSITION);
		if(random(0,2))A_SpawnItemEx("HDFragGrenadeAmmo",-3,-3,flags:SXF_NOCHECKPOSITION);
		if(random(0,2))A_SpawnItemEx("HD9mMag30",3,3,flags:SXF_NOCHECKPOSITION);
		A_SpawnItemEx("HDRocketAmmo",3,3,flags:SXF_NOCHECKPOSITION);

		bool _; Actor wep;
		[_, wep] = A_SpawnItemEx("HDHLARRandom",1,1,flags:SXF_NOCHECKPOSITION);
		HDF.TransferSpecials(self, wep);

		destroy();
	}
}

class HDHLARRandom:IdleDummy{
	states{
	spawn:
		TNT1 A 0 nodelay{
			let lll=HDHLAR(spawn("HDHLAR",pos,ALLOW_REPLACE));
			if(!lll)return;
			HDF.TransferSpecials(self, lll);
			if(!random(0,2))lll.weaponstatus[0]|=HLARF_ALTTRIGGER;
		}stop;
	}
}
