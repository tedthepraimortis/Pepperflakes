const HDLD_LAUNCHINATOR = "zml";
class HDZMLauncher:HDWeapon{
	default{
		//$Category "Weapons/Hideous Destructor"
		//$Title "Grenade Launcher"
		//$Sprite "BLOPA0"

		+weapon.explosive
		+hdweapon.fitsinbackpack
		weapon.selectionorder 93;
		weapon.slotnumber 5;
		weapon.slotpriority 3;
		scale 0.6;
		inventory.pickupmessage "You got the ZM Launcher!"; //wprking title
		obituary "";
		hdweapon.barrelsize 28,4.2,3;
		tag "ZM Launcher"; //make cool name later
		hdweapon.refid HDLD_LAUNCHINATOR;

		//hdweapon.ammo1 "ZM66AssaultRifle",1; not a valid ammotype lol
	}
	override bool AddSpareWeapon(actor newowner){return AddSpareWeaponRegular(newowner);}
	override hdweapon GetSpareWeapon(actor newowner,bool reverse,bool doselect){return GetSpareWeaponRegular(newowner,reverse,doselect);}
	override double gunmass(){
		return weaponstatus[0]&ZMLF_LOADED?6:4;
	}
	override double weaponbulk(){
		return 172+(
				weaponstatus[ZMLS_SCRAP]*0.36	
				+weaponstatus[ZMLS_FUEL]*0.14
				+weaponstatus[ZMLS_FRAG]*0.25
				+weaponstatus[ZMLS_FOUR]*0.25
			)*0.68; //loaded reduction	
	}
	override string,double getpickupsprite(){return "ZLNPA0",1.;}
	override void DrawHUDStuff(HDStatusBar sb,HDWeapon hdw,HDPlayerPawn hpl){
		if(sb.hudlevel==1){
			/*sb.drawimage("RIFLA0",(-52,-4),sb.DI_SCREEN_CENTER_BOTTOM,scale:(0.6,0.6));
			sb.drawnum(hpl.countinv("ZM66AssaultRifle"),-45,-8,sb.DI_SCREEN_CENTER_BOTTOM);
			*/
		}
		int bat=hdw.weaponstatus[ZMLS_BATTERY];
		if(bat>0)sb.drawwepnum(bat,20);
		else if(!bat)sb.drawstring( //empty battery
			sb.mamountfont,"000000",
			(-16,-9),sb.DI_TEXT_ALIGN_RIGHT|sb.DI_TRANSLATABLE|sb.DI_SCREEN_CENTER_BOTTOM,
			Font.CR_DARKGRAY
		);
		if(hdw.weaponstatus[0]&ZMLF_LOADED)sb.drawrect(-21,-13,5,3);
/*		sb.drawwepnum(
			hpl.countinv("ZM66AssaultRifle"),
			(HDCONST_MAXPOCKETSPACE/ENC_ROCKET)
		);
*/		
		if(hd_debug){
			sb.drawnum(hdw.weaponstatus[ZMLS_SCRAP],-35,-28,sb.DI_SCREEN_CENTER_BOTTOM);
			sb.drawnum(hdw.weaponstatus[ZMLS_FUEL],-35,-34,sb.DI_SCREEN_CENTER_BOTTOM);
			sb.drawnum(hdw.weaponstatus[ZMLS_FRAG],-35,-40,sb.DI_SCREEN_CENTER_BOTTOM);
			sb.drawnum(hdw.weaponstatus[ZMLS_FOUR],-35,-46,sb.DI_SCREEN_CENTER_BOTTOM);
		}
	}
	override string gethelptext(){
		LocalizeHelp();
		return
		LWPHELP_FIRESHOOT
		..LWPHELP_RELOAD.."  Grind facing ZM66\n"
		..LWPHELP_ALTRELOAD.."  Load Battery\n"
		..LWPHELP_UNLOAD.."  Unload Battery\n"
		;
	}
	override void DrawSightPicture(
		HDStatusBar sb,HDWeapon hdw,HDPlayerPawn hpl,
		bool sightbob,vector2 bob,double fov,bool scopeview,actor hpc
	){
		sb.drawgrenadeladder(hdw.airburst,bob);
	}
	override void DropOneAmmo(int amt){
		if(owner){
			owner.A_DropInventory("ZM66AssaultRifle",1);
		}
	}
	override void ForceBasicAmmo(){
		owner.A_SetInventory("ZM66AssaultRifle",1);
	}
	action void A_GetLinetrace(){
		flinetracedata frt;
		linetrace(
			angle,2*HDCONST_ONEMETRE,pitch,
			flags:TRF_NOSKY|-TRF_SOLIDACTORS,
			offsetz:height-6,
			data:frt
		);
	}
	action void A_FireZMChunks(){
		int scrp = invoker.weaponstatus[ZMLS_SCRAP];
		int fuel = invoker.weaponstatus[ZMLS_FUEL];
		int frag = invoker.weaponstatus[ZMLS_FRAG];
		int mag = invoker.weaponstatus[ZMLS_FOUR];
		int four = random(mag/2,mag);
		
		
		HDBulletActor.FireBullet(self,"HDB_scrap", //centre
				spread:80,
				speedfactor:1+(0.05*fuel),
				amount:(scrp)*1.8
			);
		HDBulletActor.FireBullet(self,"HDB_frag",
				spread:140,
				speedfactor:0.7+(0.03*fuel),
				amount:frag
			);
		HDBulletActor.FireBullet(self,"HDB_426",
				spread:140,
				speedfactor:0.5+(0.01*fuel),
				amount:abs(four/3)
			);
			
		HDBulletActor.FireBullet(self,"HDB_scrap", //left
				spread:80,
				aimoffx:-6,
				speedfactor:1+(0.05*fuel),
				amount:(scrp)*1.8
			);
		HDBulletActor.FireBullet(self,"HDB_frag",
				spread:140,
				aimoffx:-6,
				speedfactor:0.7+(0.03*fuel),
				amount:frag
			);
		HDBulletActor.FireBullet(self,"HDB_426",
				spread:140,
				aimoffx:-6,
				speedfactor:0.5+(0.01*fuel),
				amount:abs(four/3)
			);
			
		HDBulletActor.FireBullet(self,"HDB_scrap", //right
				spread:80,
				aimoffx:6,
				speedfactor:1+(0.03*fuel),
				amount:(scrp)*1.8
			);
		HDBulletActor.FireBullet(self,"HDB_frag",
				spread:140,
				aimoffx:6,
				speedfactor:0.7+(0.03*fuel),
				amount:frag
			);
		HDBulletActor.FireBullet(self,"HDB_426",
				spread:140,
				aimoffx:6,
				speedfactor:0.5+(0.01*fuel),
				amount:abs(four/3)
			);
			
			
		invoker.weaponstatus[0]&=~ZMLF_LOADED;
		invoker.weaponstatus[ZMLS_SCRAP] = 0;
		invoker.weaponstatus[ZMLS_FUEL] = 0;
		invoker.weaponstatus[ZMLS_FRAG] = 0;
		invoker.weaponstatus[ZMLS_FOUR] = 0;
		invoker.weaponstatus[ZMLS_BATTERY]--;
		
		A_StartSound("weapons/rocklaunch",CHAN_WEAPON,CHANF_OVERLAP); //replace with better sounds & sndinfo them separate
		A_StartSound("weapons/hunter",CHAN_WEAPON,CHANF_OVERLAP);
	}
	states{
	select0:
		ZMLN A 0;
		goto select0small;
	deselect0:
		ZMLN A 0;
		goto deselect0small;

	ready:
		ZMLN A 1 {
			A_WeaponReady(WRF_ALL);
			int scrap=invoker.weaponstatus[ZMLS_SCRAP];
			int fuel=invoker.weaponstatus[ZMLS_FUEL];
			int frag=invoker.weaponstatus[ZMLS_FRAG];
			int four=invoker.weaponstatus[ZMLS_FOUR];
			if((scrap+fuel+frag+four)>800){
				switch(random(1,4)){
					case 1:
						invoker.weaponstatus[ZMLS_SCRAP]-=random(4,12);
						break;
					case 2:
						invoker.weaponstatus[ZMLS_FUEL]-=random(4,12);
						break;
					case 3:
						invoker.weaponstatus[ZMLS_FRAG]-=random(4,12);
						break;
					case 4:
						invoker.weaponstatus[ZMLS_FOUR]-=random(4,12);
						break;
				}
				A_SpawnItemEx(
					"WallChunk",
					12,0,height-12,	 
					4,frandom(-2,2),frandom(.4,1),
					0,SXF_TRANSFERPITCH
				);
			}
		}
		goto readyend;
	hold:
	altfire:
		ZMLN A 0{invoker.airburst=0;}
		goto nope;

	fire:
		ZMLN B 0 A_JumpIf(invoker.weaponstatus[0]&ZMLF_LOADED,"reallyshoot");
		goto nope;
	reallyshoot:
		ZMLN F 1{
			A_FireZMChunks();
			invoker.weaponstatus[0]&=~ZMLF_LOADED;
		}
		ZMLN F 1 offset(0,34);
		ZMLN B 0{
			A_ZoomRecoil(0.9);
			A_MuzzleClimb(-frandom(2.,12.4),-frandom(3.4,16.2));
		}
		goto nope;
	unload:
		---- A 0{
			invoker.weaponstatus[0]|=ZMLF_JUSTUNLOAD;
			if(invoker.weaponstatus[ZMLS_BATTERY]>=0)setweaponstate("unmag");
		}goto nope;
	altreload: //for Batteries
		//Battery shit goes here
		---- A 0{
			invoker.weaponstatus[0]&=~ZMLF_JUSTUNLOAD;
			bool nomags=HDMagAmmo.NothingLoaded(self,"HDBattery");
			if(invoker.weaponstatus[ZMLS_BATTERY]>=20)setweaponstate("nope");
			else if(
				invoker.weaponstatus[ZMLS_BATTERY]<1
				&&(
					pressinguse()
					||nomags
				)
			){
				setweaponstate("nope");
			}else if(nomags)setweaponstate("nope");
		}goto unmag;
	unmag:
		---- A 1 offset(0,34) A_SetCrosshair(21);
		---- A 1 offset(1,38);
		---- A 2 offset(2,42);
		---- A 3 offset(3,46) A_StartSound("weapons/pismagclick",8,CHANF_OVERLAP);
		---- A 0{
			int bat=invoker.weaponstatus[ZMLS_BATTERY];
			invoker.weaponstatus[ZMLS_BATTERY]=-1;
			if(bat<0)setweaponstate("magout");
			else if(
				(!PressingUnload()&&!PressingReload())
				||A_JumpIfInventory("HDBattery",0,"null")
			){
				HDMagAmmo.SpawnMag(self,"HDBattery",bat);
				setweaponstate("magout");
			}
			else{
				HDMagAmmo.GiveMag(self,"HDBattery",bat);
				A_StartSound("weapons/pocket",9);
				setweaponstate("pocketmag");
			}
		}
	pocketmag:
		---- AAA 5 offset(0,46) A_MuzzleClimb(frandom(-0.2,0.8),frandom(-0.2,0.4));
		goto magout;
	magout:
		---- A 0{
			if(invoker.weaponstatus[0]&ZMLF_JUSTUNLOAD)setweaponstate("reloadend");
			else setweaponstate("loadmag");
		}
	loadmag:
		---- A 4 offset(0,46) A_MuzzleClimb(frandom(-0.2,0.8),frandom(-0.2,0.4));
		---- A 0 A_StartSound("weapons/pocket",9);
		---- A 5 offset(0,46) A_MuzzleClimb(frandom(-0.2,0.8),frandom(-0.2,0.4));
		---- A 3;
		---- A 0{
			let mmm=hdmagammo(findinventory("HDBattery"));
			if(mmm){
				invoker.weaponstatus[ZMLS_BATTERY]=mmm.TakeMag(true);
				A_StartSound("weapons/pismagclick",8);
			}
		}
		goto reloadend;
		
		
	reload: //for ZM66s
		#### B 0{
			flinetracedata frt;
			linetrace(
				angle,2*HDCONST_ONEMETRE,pitch,
				flags:TRF_NOSKY|-TRF_SOLIDACTORS,
				offsetz:height-6,
				data:frt
			);
			if(frt.hitactor){
				if(
					(
						invoker.weaponstatus[ZMLS_SCRAP]
						+invoker.weaponstatus[ZMLS_FUEL]
						+invoker.weaponstatus[ZMLS_FRAG]
						+invoker.weaponstatus[ZMLS_FOUR]
					)<800
				){
					if(
						ZM66AssaultRifle(frt.hitactor)
						&& !(invoker.weaponstatus[0]&ZMLF_LOADED)
					)setweaponstate("rfromground");
					else if(HDCandle(frt.hitactor))setweaponstate("rcandle");
					else if(HDRocketAmmo(frt.hitactor))setweaponstate("rbomb");
					//else if(PGUBGLKit(frt.hitactor))setweaponstate("rubgl");
				}
				else setweaponstate("nope");
			}
			else setweaponstate("nope");
			
		}
	rfromground:	//mulch zm on floor
		ZMLN B 0{
			flinetracedata frt;
			linetrace(
				angle,2*HDCONST_ONEMETRE,pitch,
				flags:TRF_NOSKY|-TRF_SOLIDACTORS,
				offsetz:height-6,
				data:frt
			);
			if(ZM66AssaultRifle(frt.hitactor)){
				let zm=ZM66AssaultRifle(frt.hitactor);
				if(zm){
					int mag = zm.weaponstatus[ZM66S_MAG];
					bool fs = !(zm.weaponstatus[0]&ZM66F_NOFIRESELECT);
					
					invoker.weaponstatus[ZMLS_SCRAP] += 42;
					if(mag>-1){
						invoker.weaponstatus[ZMLS_SCRAP] += abs(mag*0.8);
						invoker.weaponstatus[ZMLS_FUEL] += abs(mag*1.2);
						invoker.weaponstatus[ZMLS_FOUR] += mag;
					};
					if(fs)invoker.weaponstatus[ZMLS_SCRAP] += 8;
					if(zm.weaponstatus[0]&ZM66F_GRENADELOADED){
						invoker.weaponstatus[ZMLS_SCRAP] += 32;
						invoker.weaponstatus[ZMLS_FUEL] += 42;
						invoker.weaponstatus[ZMLS_FRAG] += 30; //rocquette unique projectile
					}
					if(!(zm.weaponstatus[0]&ZM66F_NOLAUNCHER))invoker.weaponstatus[ZMLS_SCRAP] += 24;
					invoker.weaponstatus[0]|=ZMLF_LOADED;
				}
				zm.destroy();
			}else setweaponstate("nope");
			
		}goto loadcommon;
	rcandle:	//eat candle
		ZMLN B 0{
			flinetracedata frt;
			linetrace(
				angle,2*HDCONST_ONEMETRE,pitch,
				flags:TRF_NOSKY|-TRF_SOLIDACTORS,
				offsetz:height-6,
				data:frt
			);
			if(HDCandle(frt.hitactor)){
				let candle=HDCandle(frt.hitactor);
				invoker.weaponstatus[ZMLS_FUEL] += 30; //"DONT YOU LECTURE ME WITH YOUR 30 BULK CANDLE"
				candle.destroy();
			}else setweaponstate("nope");
			
		}goto loadcommon;
	rbomb:	//rocquette into bonus
		ZMLN B 0{
			flinetracedata frt;
			linetrace(
				angle,2*HDCONST_ONEMETRE,pitch,
				flags:TRF_NOSKY|-TRF_SOLIDACTORS,
				offsetz:height-6,
				data:frt
			);
			if(HDRocketAmmo(frt.hitactor)){
				let bomb=HDRocketAmmo(frt.hitactor);
				invoker.weaponstatus[ZMLS_SCRAP] += 332;
				invoker.weaponstatus[ZMLS_FUEL] += 342;
				invoker.weaponstatus[ZMLS_FRAG] += 330;
				bomb.destroy();
			}else setweaponstate("nope");
			
		}goto loadcommon;
	rubgl:	//ubgl is a zm66 part technically
		ZMLN B 0{
			flinetracedata frt;
			linetrace(
				angle,2*HDCONST_ONEMETRE,pitch,
				flags:TRF_NOSKY|-TRF_SOLIDACTORS,
				offsetz:height-6,
				data:frt
			);
			/*if(PGUBGLKit(frt.hitactor)){
				let gl=PGUBGLKit(frt.hitactor);
				invoker.weaponstatus[ZMLS_SCRAP] += 24;
				gl.destroy();
			}else*/ setweaponstate("nope");
			
		}goto loadcommon;
/*	rfrominv:	//take zm from inventory
		ZMLN B 0 A_JumpIf(
			invoker.weaponstatus[0]&ZMLF_LOADED
			||!countinv("ZM66AssaultRifle"),
			"nope"
		);
		ZMLN B 0{
			let zm=hdweapon(findinventory("ZM66AssaultRifle"));
			if(zm){
				int mag = zm.weaponstatus[ZM66S_MAG];
				bool fs = !(zm.weaponstatus[0]&ZM66F_NOFIRESELECT);
				
				invoker.weaponstatus[ZMLS_SCRAP] += 42;
				if(mag>-1){
					invoker.weaponstatus[ZMLS_SCRAP] += abs(mag*0.8);
					invoker.weaponstatus[ZMLS_FUEL] += abs(mag*1.2);
				};
				if(fs)invoker.weaponstatus[ZMLS_SCRAP] += 8;
				if(zm.weaponstatus[0]&ZM66F_GRENADELOADED)invoker.weaponstatus[ZMLS_SCRAP] += 32;
				else if(!(zm.weaponstatus[0]&ZM66F_NOLAUNCHER))invoker.weaponstatus[ZMLS_SCRAP] += 24;
				invoker.weaponstatus[0]|=ZMLF_LOADED;
			}
		}goto loadcommon;
*/
	loadcommon:
		ZMLN B 1 offset(2,34)A_StartSound("weapons/rockopen",8);
		ZMLN B 1 offset(4,38)A_MuzzleClimb(-frandom(1.2,2.4),frandom(1.2,2.4));
		ZMLN B 1 offset(10,44);
		ZMLN B 2 offset(12,50)A_MuzzleClimb(-frandom(1.2,2.4),frandom(1.2,2.4));
		ZMLN B 3 offset(13,55) A_StartSound("weapons/rockopen2",8,CHANF_OVERLAP);
		ZMLN B 3 offset(14,60);
		ZMLN B 3 offset(11,64)A_StartSound("weapons/pocket",9);
		ZMLN B 7 offset(10,66);
		ZMLN B 0{
			if(health<40)A_SetTics(7);
			else if(health<60)A_SetTics(3);
		}
		ZMLN B 4 offset(12,68) A_StartSound("weapons/rockreload",8);
		ZMLN B 2 offset(10,66){
			if(invoker.weaponstatus[0]&ZMLF_JUSTUNLOAD){
				if(
					!(invoker.weaponstatus[0]&ZMLF_LOADED)
				)setweaponstate("reloadend");else{
					invoker.weaponstatus[0]&=~ZMLF_LOADED;
					if(
						(!PressingUnload()&&!PressingReload())
						||A_JumpIfInventory("ZM66AssaultRifle",0,"null")
					)
					A_SpawnItemEx(
						"ZM66AssaultRifle",10,0,height-16,vel.x,vel.y,vel.z+2,
						0,SXF_ABSOLUTEMOMENTUM|SXF_NOCHECKPOSITION
					);
					else{
						A_GiveInventory("ZM66AssaultRifle",1);
						A_StartSound("weapons/pocket",9);
						A_SetTics(4);
					}
				}
			}else{
				if(
					invoker.weaponstatus[0]&ZMLF_LOADED
					||!countinv("ZM66AssaultRifle")
				)setweaponstate("reloadend");else{
					A_TakeInventory("ZM66AssaultRifle",1,TIF_NOTAKEINFINITE);
					invoker.weaponstatus[0]|=ZMLF_LOADED;
					A_SetTics(5);
				}
			}
		}
	reloadend:
		ZMLN B 1 offset(12,68) A_StartSound("weapons/rockopen2",8);
		ZMLN B 1 offset(11,70);
		ZMLN B 4 offset(10,69);
		ZMLN B 0 A_StartSound("weapons/rockopen",8,CHANF_OVERLAP);
		ZMLN B 1 offset(9,66);
		ZMLN B 1 offset(9,60);
		ZMLN B 1 offset(8,53);
		ZMLN B 1 offset(8,48);
		ZMLN B 1 offset(6,43);
		ZMLN B 1 offset(4,38);
		ZMLN B 1 offset(2,34);
		goto ready;

	spawn:
		ZLNP A -1;
	}
	override void loadoutconfigure(string input){
		weaponstatus[0]|=ZMLF_LOADED;
		weaponstatus[ZMLS_BATTERY] = 20;
		weaponstatus[ZMLS_SCRAP] = 146; //full zm amount
		weaponstatus[ZMLS_FUEL] = 95;	//60 from 4mm*50, 35 from roquette123
		weaponstatus[ZMLS_FRAG] = 30;	//abstracted from roquette distance frags
		weaponstatus[ZMLS_FOUR] = 50; 	//50 shots from a full mag
	}
	override void InitializeWepStats(bool idfa){
		weaponstatus[0]|=ZMLF_LOADED;
		weaponstatus[ZMLS_BATTERY] = 20;
		weaponstatus[ZMLS_SCRAP] = 146;
		weaponstatus[ZMLS_FUEL] = 95;
		weaponstatus[ZMLS_FRAG] = 30;
		weaponstatus[ZMLS_FOUR] = 50;
	}
}
enum bloopstatus{
	ZMLF_LOADED=1,
	ZMLF_JUSTUNLOAD=2,

	ZMLS_SCRAP=1,
	ZMLS_FUEL=2,
	ZMLS_BATTERY=3,
	ZMLS_FRAG=4,
	ZMLS_FOUR=5
};