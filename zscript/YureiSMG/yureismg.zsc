const ENC_9MAG50_EMPTY=ENC_9MAG_EMPTY*2;
const ENC_9MAG50=ENC_9MAG50_EMPTY+ENC_9_LOADED*50;
const ENC_9MAG50_LOADED=ENC_9MAG50*0.8;

class HDYureiSMG:PGWeapon{
	default{
		+hdweapon.fitsinbackpack
		obituary "%o was haunted by %k's Yurei.";
		weapon.selectionorder 23;
		weapon.slotnumber 2;
		weapon.slotpriority 0.8;
		weapon.kickback 30;
		weapon.bobrangex 0.3;
		PGWeapon.CustomPickupMsg true;
		weapon.bobrangey 0.57;
		weapon.bobspeed 2.5;
		scale 0.65;
		inventory.pickupmessage "$PEPPER_PICKUP_YUREI";
		hdweapon.barrelsize 20,0.5,1;
		hdweapon.refid "yri";
		tag "$PEPPER_TAG_YUREI";
		inventory.icon "SPTNA0";
		
		hdweapon.loadoutcodes "
			\cufiremode - 0/1, semi/auto
			\cusemi - 0/1, semi only";

	}
	int afuck;
	override bool AddSpareWeapon(actor newowner){return AddSpareWeaponRegular(newowner);}
	override hdweapon GetSpareWeapon(actor newowner,bool reverse,bool doselect){return GetSpareWeaponRegular(newowner,reverse,doselect);}
	override double gunmass(){
		return 5+((weaponstatus[SPECTS_MAG]<0)?-0.5:(weaponstatus[SPECTS_MAG]*0.02));
	}
	override double weaponbulk(){
		int mg=weaponstatus[SPECTS_MAG];
		if(mg<0)return 77;
		else return (80+ENC_9MAG50_LOADED)+mg*ENC_9_LOADED;
	}
	override void failedpickupunload(){
		failedpickupunloadmag(SPECTS_MAG,"HD9mMag50");
	}
	override void DropOneAmmo(int amt){
		if(owner){
			amt=clamp(amt,1,10);
			if(owner.countinv("HDPistolAmmo"))owner.A_DropInventory("HDPistolAmmo",amt*30);
			else owner.A_DropInventory("HD9mMag50",amt);
		}
	}
	override void postbeginplay(){
		super.postbeginplay();
		if(weaponstatus[SPECTS_AUTO]>0){
		switch(weaponstatus[SPECTS_SWITCHTYPE]){
		case 1:
			weaponstatus[SPECTS_AUTO]=0;
			break;
		case 2:
			weaponstatus[SPECTS_AUTO]=1;
			break;
		/*case 3:
			weaponstatus[SPECTS_AUTO]=2;
			break;*/
		default:
			break;
		}}
	}
	override void ForceBasicAmmo(){
		owner.A_TakeInventory("HDPistolAmmo");
		owner.A_TakeInventory("HD9mMag50");
		owner.A_GiveInventory("HD9mMag50");
	}
	override string,double getpickupsprite(){
		return "SPTN"..((weaponstatus[SPECTS_MAG]<0)?"B":"A").."0",1.;
	}
	override void DrawHUDStuff(HDStatusBar sb,HDWeapon hdw,HDPlayerPawn hpl){
		if(sb.hudlevel==1){
			int nextmagloaded=sb.GetNextLoadMag(hdmagammo(hpl.findinventory("HD9mMag50")));
			if(nextmagloaded>=50){
				sb.drawimage("CL50A0",(-46,-3),sb.DI_SCREEN_CENTER_BOTTOM,scale:(3,3));
			}else if(nextmagloaded<1){
				sb.drawimage("CL50B0",(-46,-3),sb.DI_SCREEN_CENTER_BOTTOM,alpha:nextmagloaded?0.6:1.,scale:(3,3));
			}else sb.drawbar(
				"CL50NORM","CL50GREY",
				nextmagloaded,50,
				(-46,-3),-1,
				sb.SHADER_VERT,sb.DI_SCREEN_CENTER_BOTTOM
			);
			sb.drawnum(hpl.countinv("HD9mMag50"),-43,-8,sb.DI_SCREEN_CENTER_BOTTOM);
		}
		if(weaponstatus[SPECTS_SWITCHTYPE]!=1)sb.drawwepcounter(hdw.weaponstatus[SPECTS_AUTO],
			-22,-10,"RBRSA3A7",/*"STBURAUT",*/"STFULAUT"
		);
		sb.drawwepnum(hdw.weaponstatus[SPECTS_MAG],50);
		if(hdw.weaponstatus[SPECTS_CHAMBER]==2)sb.drawrect(-19,-11,3,1);
	}
	override string gethelptext(){
		return
		LWPHELP_FIRESHOOT
		..LWPHELP_RELOAD.."  Reload mag\n"
		..LWPHELP_USE.."+"..LWPHELP_RELOAD.."  Reload chamber\n"
		..LWPHELP_FIREMODE.."  Semi/Auto\n"
		..LWPHELP_MAGMANAGER
		..LWPHELP_UNLOADUNLOAD
		;
	}
	override void DrawSightPicture(
		HDStatusBar sb,HDWeapon hdw,HDPlayerPawn hpl,
		bool sightbob,vector2 bob,double fov,bool scopeview,actor hpc,string whichdot
	){
		vector2 bobb=bob*1.18;
			int cx,cy,cw,ch;
			[cx,cy,cw,ch]=screen.GetClipRect();
			sb.SetClipRect(
				-16+bob.x,-4+bob.y,32,16,
				sb.DI_SCREEN_CENTER
			);
			sb.drawimage(
				"spctfrnt",(0,0)+bobb,sb.DI_SCREEN_CENTER|sb.DI_ITEM_TOP
			);
			sb.SetClipRect(cx,cy,cw,ch);
			sb.drawimage(
				"spctback",(0,0)+bob,sb.DI_SCREEN_CENTER|sb.DI_ITEM_TOP,
				alpha:0.9
			);
	}
	/*action void A_CheckReflexSight(){
		if(
			invoker.weaponstatus[0]&SPECTF_REFLEXSIGHT
		)Player.GetPSprite(PSP_WEAPON).sprite=getspriteindex("SMSGA0");
		else Player.GetPSprite(PSP_WEAPON).sprite=getspriteindex("SMGGA0");
	}*/
	states{
	select0:
		SPTR A 0;
		goto select0small;
	deselect0:
		SPTR A 0;
		goto deselect0small;
		SPTR AB 0;
		SPTR AB 0;

	ready:
		SPTR A 0;
		#### A 1{
			A_SetCrosshair(21);
			invoker.weaponstatus[SPECTS_RATCHET]=0;
			A_WeaponReady(WRF_ALL);
		}
		goto readyend;
	user3:
		---- A 0 A_MagManager("HD9mMag50");
		goto ready;
	altfire:
		goto chamber_manual;
	althold:
		goto nope;
	hold:
		#### A 0{
			if(
				//full auto
				invoker.weaponstatus[SPECTS_AUTO]==1
			)setweaponstate("fire2");
			else if(
				//burst
				invoker.weaponstatus[SPECTS_AUTO]<1
				||invoker.weaponstatus[SPECTS_RATCHET]>2
			)setweaponstate("nope");
		}goto fire;
	user2:
	firemode:
		---- A 1{
			int canaut=invoker.weaponstatus[SPECTS_SWITCHTYPE];
			if(canaut==1){
				invoker.weaponstatus[SPECTS_AUTO]=0;
				return;
			}
			int maxmode=(canaut>0)?(canaut-1):1;
			int aut=invoker.weaponstatus[SPECTS_AUTO];
			if(aut>=maxmode)invoker.weaponstatus[SPECTS_AUTO]=0;
			//else if(aut<0)invoker.weaponstatus[SPECTS_AUTO]=0;
			//else if(canaut>0)invoker.weaponstatus[SPECTS_AUTO]=maxmode;
			else invoker.weaponstatus[SPECTS_AUTO]++;
		}goto nope;
	fire:
		#### A 1 { invoker.afuck = 0; }
	fire2:
		#### A 1{
			if(invoker.weaponstatus[SPECTS_CHAMBER]==2)A_GunFlash();
			else setweaponstate("chamber_manual");
			
			if(invoker.afuck < 2) invoker.afuck++;
			else invoker.afuck = 0;
		}
		#### B 0{
			if(invoker.afuck == 1) a_settics(0);
			else a_settics(1);
		}
		#### B 1{
			if(invoker.weaponstatus[SPECTS_CHAMBER]==1){
				A_EjectCasing("HDSpent9mm",
					frandom(-1,2),
					(frandom(0.2,0.3),-frandom(7,7.5),frandom(0,0.2)),
					(0,0,-2)
				);
				invoker.weaponstatus[SPECTS_CHAMBER]=0;
			}
			if(invoker.weaponstatus[SPECTS_MAG]>0){
				invoker.weaponstatus[SPECTS_MAG]--;
				invoker.weaponstatus[SPECTS_CHAMBER]=2;
			}
			if(invoker.weaponstatus[SPECTS_AUTO]==1)
			A_WeaponReady(WRF_NOFIRE);
		}
		#### A 0 A_ReFire();
		goto ready;
	flash:
		#### B 0{
			let bbb=HDBulletActor.FireBullet(self,"HDB_9",speedfactor:1.075);
			if(
				frandom(16,ceilingz-floorz)<bbb.speed*0.1
			)A_AlertMonsters();

			A_ZoomRecoil(0.995);
			A_StartSound("weapons/spectresmg",CHAN_WEAPON, pitch: frandom(0.9,1.1));
			//A_StartSound("weapons/spectresmg",CHAN_WEAPON, pitch: 1.1);
			invoker.weaponstatus[SPECTS_RATCHET]++;
			invoker.weaponstatus[SPECTS_CHAMBER]=1;
		}
		SPTF A 1 bright{
			HDFlashAlpha(-8);
			A_Light1();
		}
		TNT1 A 0 A_MuzzleClimb(-frandom(0.35,0.52),-frandom(0.7,0.96),-frandom(0.15,0.12),-frandom(0.1,0.16));
		goto lightdone;


	unloadchamber:
		#### B 4 A_JumpIf(invoker.weaponstatus[SPECTS_CHAMBER]<1,"nope");
		#### B 10{
			class<actor>which=invoker.weaponstatus[SPECTS_CHAMBER]>1?"HDPistolAmmo":"HDSpent9mm";
			invoker.weaponstatus[SPECTS_CHAMBER]=0;
			A_SpawnItemEx(which,
				cos(pitch)*10,0,height-8-sin(pitch)*10,
				vel.x,vel.y,vel.z,
				0,SXF_ABSOLUTEMOMENTUM|SXF_NOCHECKPOSITION|SXF_TRANSFERPITCH
			);
		}goto readyend;
	loadchamber:
		---- A 0 A_JumpIf(invoker.weaponstatus[SPECTS_CHAMBER]>0,"nope");
		---- A 0 A_JumpIf(!countinv("HDPistolAmmo"),"nope");
		---- A 1 offset(0,34) A_StartSound("weapons/pocket",9);
		---- A 1 offset(2,36);
		---- A 1 offset(2,44);
		#### B 1 offset(5,58);
		#### B 2 offset(7,70);
		#### B 6 offset(8,80);
		#### A 10 offset(8,87){
			if(countinv("HDPistolAmmo")){
				A_TakeInventory("HDPistolAmmo",1,TIF_NOTAKEINFINITE);
				invoker.weaponstatus[SPECTS_CHAMBER]=2;
				A_StartSound("weapons/smgchamber",8);
			}else A_SetTics(4);
		}
		#### A 3 offset(9,76);
		---- A 2 offset(5,70);
		---- A 1 offset(5,64);
		---- A 1 offset(5,52);
		---- A 1 offset(5,42);
		---- A 1 offset(2,36);
		---- A 2 offset(0,34);
		goto nope;
	user4:
	unload:
		#### A 0{
			invoker.weaponstatus[0]|=SPECTF_JUSTUNLOAD;
			if(
				invoker.weaponstatus[SPECTS_MAG]>=0
			)setweaponstate("unmag");
			else if(invoker.weaponstatus[SPECTS_CHAMBER]>0)setweaponstate("unloadchamber");
		}goto nope;
	reload:
		#### A 0{
			invoker.weaponstatus[0]&=~SPECTF_JUSTUNLOAD;
			bool nomags=HDMagAmmo.NothingLoaded(self,"HD9mMag50");
			if(invoker.weaponstatus[SPECTS_MAG]>=50)setweaponstate("nope");
			else if(
				invoker.weaponstatus[SPECTS_MAG]<1
				&&(
					pressinguse()
					||nomags
				)
			){
				if(
					countinv("HDPistolAmmo")
				)setweaponstate("loadchamber");
				else setweaponstate("nope");
			}else if(nomags)setweaponstate("nope");
		}goto unmag;
	unmag:
		#### A 1 offset(0,34) A_SetCrosshair(21);
		#### B 1 offset(5,38);
		#### C 1 offset(10,42);
		#### C 2 offset(20,46) A_StartSound("weapons/smgmagclick",8);
		#### C 4 offset(30,52){
			A_MuzzleClimb(0.3,0.4);
			A_StartSound("weapons/smgmagmove",8,CHANF_OVERLAP);
		}
		#### B 0{
			int magamt=invoker.weaponstatus[SPECTS_MAG];
			if(magamt<0){
				setweaponstate("magout");
				return;
			}
			invoker.weaponstatus[SPECTS_MAG]=-1;
			if(
				(!PressingUnload()&&!PressingReload())
				||A_JumpIfInventory("HD9mMag50",0,"null")
			){
				HDMagAmmo.SpawnMag(self,"HD9mMag50",magamt);
				setweaponstate("magout");
			}else{
				HDMagAmmo.GiveMag(self,"HD9mMag50",magamt);
				A_StartSound("weapons/pocket",9);
				setweaponstate("pocketmag");
			}
		}
	pocketmag:
		#### CC 7 offset(34,54) A_MuzzleClimb(frandom(0.2,-0.8),frandom(-0.2,0.4));
	magout:
		#### C 0{
			if(invoker.weaponstatus[0]&SPECTF_JUSTUNLOAD)setweaponstate("reloadend");
			else setweaponstate("loadmag");
		}

	loadmag:
		#### C 0 A_StartSound("weapons/pocket",9);
		#### C 6 offset(34,54) A_MuzzleClimb(frandom(0.2,-0.8),frandom(-0.2,0.4));
		#### C 7 offset(34,52) A_MuzzleClimb(frandom(0.2,-0.8),frandom(-0.2,0.4));
		#### C 10 offset(32,50);
		#### C 3 offset(32,49){
			let mmm=hdmagammo(findinventory("HD9mMag50"));
			if(mmm){
				invoker.weaponstatus[SPECTS_MAG]=mmm.TakeMag(true);
				A_StartSound("weapons/smgmagclick",8,CHANF_OVERLAP);
			}
			if(
				invoker.weaponstatus[SPECTS_MAG]<1
				||invoker.weaponstatus[SPECTS_CHAMBER]>0
			)setweaponstate("reloadend");
		}
		goto reloadend;

	reloadend:
		#### C 3 offset(30,52);
		#### C 2 offset(20,46);
		#### B 1 offset(10,42);
		#### B 1 offset(5,38);
		#### A 1 offset(0,34);
		goto chamber_manual;

	chamber_manual:
		#### A 0 A_JumpIf(
			invoker.weaponstatus[SPECTS_MAG]<1
			||invoker.weaponstatus[SPECTS_CHAMBER]==2
		,"nope");
		#### B 2 offset(3,32){
			A_WeaponBusy();
			invoker.weaponstatus[SPECTS_MAG]--;
			invoker.weaponstatus[SPECTS_CHAMBER]=2;
		}
		#### B 3 offset(5,35) A_StartSound("weapons/smgchamber",8,CHANF_OVERLAP);
		#### A 1 offset(3,32);
		#### A 1 offset(2,31);
		goto nope;


	spawn:
		TNT1 A 1;
		SPTP A -1{
			if(invoker.weaponstatus[SPECTS_MAG]<0)frame=1;
		}
		SPTN # -1;
		stop;
	}
	override void initializewepstats(bool idfa){
		weaponstatus[SPECTS_MAG]=50;
		weaponstatus[SPECTS_CHAMBER]=2;
	}
	override void loadoutconfigure(string input){
		int firemode=getloadoutvar(input,"firemode",1);
		if(firemode>=0)weaponstatus[SPECTS_AUTO]=clamp(firemode,0,1);

		int fireswitch=getloadoutvar(input,"semi",1);
		if(fireswitch>0)weaponstatus[SPECTS_SWITCHTYPE]=clamp(fireswitch,0,1);
	}
}
enum spectrestatus{
	SPECTF_JUSTUNLOAD=1,
	//SPECTF_REFLEXSIGHT=2,

	SPECTN_SEMIONLY=1,
	SPECTN_BURSTONLY=2,
	SPECTN_FULLONLY=3,

	SPECTS_FLAGS=0,
	SPECTS_MAG=1,
	SPECTS_CHAMBER=2, //0 empty, 1 spent, 2 loaded
	SPECTS_AUTO=3, //0 semi, 1 burst, 2 auto
	SPECTS_RATCHET=4,
	SPECTS_SWITCHTYPE=5,
};

class HD9mMag50:HD9mMag15{
	default{
		hdmagammo.maxperunit 50;
		hdmagammo.magbulk ENC_9MAG50_EMPTY;
		tag "$PEPPER_TAG_YUREIMAG";
		inventory.pickupmessage "$PEPPER_PICKUP_YUREIMAG";
		hdpickup.refid "950";
	}
	override string,string,name,double getmagsprite(int thismagamt){
		string magsprite=(thismagamt>0)?"CL50A0":"CL50B0";
		return magsprite,"PBRSA0","HDPistolAmmo",2.;
	}
	override void GetItemsThatUseThis(){
		itemsthatusethis.push("HDYureiSMG");
	}
	states{
	spawn:
		CL50 A -1;
		stop;
	spawnempty:
		CL50 B -1{
			brollsprite=true;brollcenter=true;
			roll=randompick(0,0,0,0,2,2,2,2,1,3)*90;
		}stop;
	}
}

class HD9mMag50Empty:IdleDummy{
	override void postbeginplay(){
		super.postbeginplay();
		HDMagAmmo.SpawnMag(self,"HD9mMag50",0);
		destroy();
	}
}

class HDYureiRandom:IdleDummy{
	states{
	spawn:
		TNT1 A 0 nodelay{
			let lll=HDYureiSMG(spawn("HDYureiSMG",pos,ALLOW_REPLACE));
			if(!lll)return;
			HDF.TransferSpecials(self,lll);
			if(!random(0,2))lll.weaponstatus[SPECTS_SWITCHTYPE]|=random(0,1);
		}stop;
	}
}

class HDYureiClipBox:IdleDummy{
	override void postbeginplay(){
		super.postbeginplay();
		A_SpawnItemEx("HD9mMag50",flags:SXF_NOCHECKPOSITION);
		if(!random(0,1))A_SpawnItemEx("HDFragGrenadeAmmo",-3,-3,flags:SXF_NOCHECKPOSITION);
		if(!random(0,3))A_SpawnItemEx("HD9mMag50",3,3,flags:SXF_NOCHECKPOSITION);
		//A_SpawnItemEx("HDYureiRandom",1,1,flags:SXF_NOCHECKPOSITION); -- this will likely not trigger specials
		if(!random(0, 63))A_SpawnItemEx("livereactiontenshi",flags:SXF_NOCHECKPOSITION);
			let lll=HDYureiSMG(spawn("HDYureiSMG",(pos.x+1,pos.y+1,pos.z),ALLOW_REPLACE));
			if(!lll)return;
			HDF.TransferSpecials(self,lll);
			if(!random(0,2))lll.weaponstatus[SPECTS_SWITCHTYPE]|=random(0,1);
		destroy();
	}
}

class livereactiontenshi: actor
{
	default
	{
		height 1;
		+NOINTERACTION
		+ROLLSPRITE
		+ROLLCENTER
		+FLATSPRITE
		+XFLIP
		scale 0.1;
	}
	double aFuck;
	states
	{
		spawn:
			TNKO A 0 A_LookEx(LOF_NOSOUNDCHECK, 0, 32);
			TNKO A 1 a_setroll(roll+5);
			loop;
		see:
			TNKO A 1
			{
				aFuck+=2.5;
				a_setroll(roll+5+aFuck);
				a_fadeout(0.01);
				a_changevelocity(0, 0, 0.2, CVF_REPLACE);
				
			}
			Loop;
	}
}
