// ------------------------------------------------------------
// Super Shotgun
// ------------------------------------------------------------
const HDLD_SAWED="swd";
class SawedSlayer:PGShotgun{
	default{
		//$Category "Weapons/Hideous Destructor"
		//$Title "Slayer"
		//$Sprite "SLAYA0"

		+hdweapon.fitsinbackpack
		+hdweapon.reverseguninertia
		weapon.selectionorder 30;
		weapon.slotnumber 3;
		weapon.slotpriority 3;
		PGShotgun.CustomPickupMsg true;
		inventory.pickupmessage "$PEPPER_PICKUP_SAWEDSHOTGUN";
		obituary "$PEPPER_OBITUARY_SAWEDSHOTGUN";
		weapon.bobrangex 0.1;
		weapon.bobrangey 0.6;
		weapon.bobspeed 2.5;
		weapon.bobstyle "normal";
		scale 0.6;
		hdweapon.barrelsize 6,1,1;
		tag "$PEPPER_TAG_SAWEDSLAYER";
		hdweapon.refid HDLD_SAWED;
	}
		bool wronghand;
		override bool AddSpareWeapon(actor newowner){return AddSpareWeaponRegular(newowner);}
		override hdweapon GetSpareWeapon(actor newowner,bool reverse,bool doselect){return GetSpareWeaponRegular(newowner,reverse,doselect);}
		action void A_SwapHandguns(){
		let mwt=SpareWeapons(findinventory("SpareWeapons"));
		if(!mwt){
			setweaponstate("whyareyousmiling");
			return;
		}
		int pistindex=mwt.weapontype.find(invoker.getclassname());
		if(pistindex==mwt.weapontype.size()){
			setweaponstate("whyareyousmiling");
			return;
		}
		A_WeaponBusy();

		array<string> wepstat;
		string wepstat2="";
		mwt.weaponstatus[pistindex].split(wepstat,",");
		for(int i=0;i<wepstat.size();i++){
			if(i)wepstat2=wepstat2..",";
			wepstat2=wepstat2..invoker.weaponstatus[i];
			invoker.weaponstatus[i]=wepstat[i].toint();
		}
		mwt.weaponstatus[pistindex]=wepstat2;

		invoker.wronghand=!invoker.wronghand;
	}
	static void Fire(actor caller,bool right,int choke=7){
		double shotpower=getshotpower();
		double spread=3.;
		double speedfactor=1.2;
		let sss=SawedSlayer(caller.findinventory("SawedSlayer"));
		if(sss){
			sss.shotpower=shotpower;
		}

		spread=12;
		speedfactor=0.95;

		spread*=shotpower;
		speedfactor*=shotpower;
		vector2 barreladjust=(0.8,-0.05);
		if(right)barreladjust=-barreladjust;
		HDBulletActor.FireBullet(caller,"HDB_wad",xyofs:barreladjust.x,aimoffx:barreladjust.y);
		let p=HDBulletActor.FireBullet(caller,"HDB_00",xyofs:barreladjust.x,
			spread:spread,aimoffx:barreladjust.y,speedfactor:speedfactor,amount:10
		);
		distantnoise.make(p,"world/shotgunfar");
	}
	override string,double getpickupsprite(){
		return "SGSWA0",1.;
	}
	override void DrawHUDStuff(HDStatusBar sb,HDWeapon hdw,HDPlayerPawn hpl){
		if(sb.hudlevel==1){
			sb.drawimage("SHL1A0",(-47,-10),sb.DI_SCREEN_CENTER_BOTTOM);
			sb.drawnum(hpl.countinv("HDShellAmmo"),-46,-8,sb.DI_SCREEN_CENTER_BOTTOM);
		}
		int loffs=-31;int rofs=-18;
		if(hdw.weaponstatus[0]&SAWDF_DOUBLE){
			loffs=-27;rofs=-23;
			sb.drawimage("STBURAUT",(-23,-17),sb.DI_SCREEN_CENTER_BOTTOM);
		}
		if(hdw.weaponstatus[SAWDS_CHAMBER1]>1){
			sb.drawrect(loffs,-15,3,5);
			sb.drawrect(loffs,-9,3,2);
		}else if(hdw.weaponstatus[SAWDS_CHAMBER1]>0){
			sb.drawrect(loffs,-9,3,2);
		}
		if(hdw.weaponstatus[SAWDS_CHAMBER2]>1){
			sb.drawrect(rofs,-15,3,5);
			sb.drawrect(rofs,-9,3,2);
		}else if(hdw.weaponstatus[SAWDS_CHAMBER2]>0){
			sb.drawrect(rofs,-9,3,2);
		}
	}
	override string gethelptext(){
		return
		LWPHELP_FIRE.."  Shoot Left\n"
		..LWPHELP_ALTFIRE.."  Shoot Right\n"
		..LWPHELP_RELOAD.."  Reload\n"
		..LWPHELP_ALTRELOAD.."  Quick-Swap (if available)\n"
		..LWPHELP_FIREMODE.."  Hold to force double shot\n"
		..LWPHELP_UNLOADUNLOAD
		;
	}
	override void DrawSightPicture(
		HDStatusBar sb,HDWeapon hdw,HDPlayerPawn hpl,
		bool sightbob,vector2 bob,double fov,bool scopeview,actor hpc,string whichdot
	){
		int cx,cy,cw,ch;
		[cx,cy,cw,ch]=screen.GetClipRect();
		sb.SetClipRect(
			-16+bob.x,-4+bob.y,32,12,
			sb.DI_SCREEN_CENTER
		);
		vector2 bobb=bob*1.2;
		bobb.y=clamp(bobb.y,-8,8);
		sb.SetClipRect(cx,cy,cw,ch);
		sb.drawimage(
			"dbbaksit",(0,0)+bob,sb.DI_SCREEN_CENTER|sb.DI_ITEM_TOP
		);
	}
	override double gunmass(){
		return 4;
	}
	action void A_CheckPistolHand(){
		if(invoker.wronghand)player.getpsprite(PSP_WEAPON).sprite=getspriteindex("SW2GA0");
	}
	override double weaponbulk(){
		return 45+weaponstatus[SHOTS_SIDESADDLE]*ENC_SHELLLOADED;
	}
	//so you don't switch to the hunter every IDFA in D1
	override void detachfromowner(){
		if(Wads.CheckNumForName("SHT2B0",wads.ns_sprites,-1,false)<0){
			weapon.detachfromowner();
		}else hdweapon.detachfromowner();
	}
	
	action void FDSingleHandSpriteCheck(int which){
		if(invoker.bplayingid)return;
		if(
			(
				countinv("HDShellAmmo")<2
			)
		){
			player.findPSprite(PSP_WEAPON).frame=which;
		}
	}
	transient cvar swapbarrels;
	states{
	select0:
		SWSG A 0{
			if(!countinv("NulledWeapon"))invoker.wronghand=false;
			A_TakeInventory("NulledWeapon");
			A_CheckPistolHand();
			}
		#### A 0{invoker.swapbarrels=cvar.getcvar("hd_swapbarrels",player);}
		goto select0small;
	deselect0:
		SWSG A 0 A_CheckPistolHand();
		goto deselect0small;
	fire:
	altfire:
		#### A 0 A_ClearRefire();
	ready:
		SWSG A 0 A_CheckPistolHand(); //let the PostBeginPlay handle the presence of the relevant sprite
		#### A 1{
			if(PressingFireMode()){
				invoker.weaponstatus[0]|=SAWDF_DOUBLE;
			}else invoker.weaponstatus[0]&=~SAWDF_DOUBLE;

			int pff;
			if(invoker.swapbarrels&&invoker.swapbarrels.getbool()){
				pff=PressingAltfire();
				if(PressingFire())pff|=2;
			}else{
				pff=PressingFire();
				if(PressingAltfire())pff|=2;
			}

			bool ch1=invoker.weaponstatus[SAWDS_CHAMBER1]==2;
			bool ch2=invoker.weaponstatus[SAWDS_CHAMBER2]==2;

			bool dbl=invoker.weaponstatus[0]&SAWDF_DOUBLE;
			if(ch1&&ch2){
				if(pff==3){
					A_Overlay(PSP_FLASH,"flashboth");
					return;
				}
				else if(pff&&dbl){
					setweaponstate("double");
					return;
				}
			}else if(pff&&dbl){
				if(ch1)A_Overlay(11,"flashleft");
				if(ch2)A_Overlay(12,"flashright");
			}
			if(ch1&&pff%2)A_Overlay(11,"flashleft");
			else if(ch2&&pff>1)A_Overlay(12,"flashright");
			else A_WeaponReady((WRF_ALL|WRF_NOFIRE)&~WRF_ALLOWUSER2);
		}
		#### A 0 A_WeaponReady();
		goto readyend;
	double:
		#### A 1 offset(0,34);
		#### A 1 offset(0,33);
		#### A 0 A_Overlay(PSP_FLASH,"flashboth");
		goto readyend;

	flashleft:
		SWSF A 0 A_JumpIf(invoker.wronghand,"flashright2");
		---- A 1 bright{
			A_Light2();
			HDFlashAlpha(64,false,overlayid());
			A_StartSound("weapons/sawedslayersingle",CHAN_WEAPON,CHANF_OVERLAP);
			A_ZoomRecoil(0.9);
			invoker.weaponstatus[SAWDS_CHAMBER1]=1;

			invoker.Fire(self,0);
		}
		TNT1 A 1{
			A_Light0();
			double shotpower=invoker.shotpower;
			A_MuzzleClimb(1.2*shotpower,-2.4*shotpower,1.2*shotpower,-2.4*shotpower);
		}goto flasheither;
	flashright:
		SWSF B 0 A_JumpIf(invoker.wronghand,"flashleft2");
		---- B 1 bright{
			A_Light2();
			HDFlashAlpha(64,false,overlayid());
			A_StartSound("weapons/sawedslayersingle",CHAN_WEAPON,CHANF_OVERLAP);
			A_ZoomRecoil(0.9);
			invoker.weaponstatus[SAWDS_CHAMBER2]=1;

			invoker.Fire(self,1);
		}
		TNT1 A 1{
			A_Light0();
			double shotpower=invoker.shotpower;
			A_MuzzleClimb(-1.2*shotpower,-2.4*shotpower,-1.2*shotpower,-2.4*shotpower);
		}goto flasheither;
	flasheither:
		TNT1 A 0 A_AlertMonsters();
		TNT1 A 0 setweaponstate("recoil");
		stop;
	flashboth:
		SWSF C 0 A_JumpIf(invoker.wronghand,"flashboth2");
		---- C 1 bright{
			A_Light2();
			HDFlashAlpha(128);
			A_StartSound("weapons/sawedslayersingle",CHAN_WEAPON,CHANF_OVERLAP);
			A_StartSound("weapons/sawedslayersingle",CHAN_WEAPON,CHANF_OVERLAP);
			A_ZoomRecoil(0.7);
			invoker.weaponstatus[SAWDS_CHAMBER1]=1;
			invoker.weaponstatus[SAWDS_CHAMBER2]=1;

			invoker.Fire(self,0);
			invoker.Fire(self,1);
		}
		TNT1 A 1{
			A_Light0();
			double shotpower=invoker.shotpower;
			double mlt=(invoker.bplayingid?0.9:-0.9)*shotpower;
			double mlt2=-4.*shotpower;
			A_MuzzleClimb(mlt,mlt2,mlt,mlt2);
		}goto flasheither;
		
	flashleft2:
		SW2F A 0 A_JumpIf(invoker.weaponstatus[SAWDS_CHAMBER2]>2,"nope");
		---- A 1 bright{
			A_Light2();
			HDFlashAlpha(64,false,overlayid());
			A_StartSound("weapons/sawedslayersingle",CHAN_WEAPON,CHANF_OVERLAP);
			A_ZoomRecoil(0.9);
			invoker.weaponstatus[SAWDS_CHAMBER2]=1;

			invoker.Fire(self,0);
		}
		TNT1 A 1{
			A_Light0();
			double shotpower=invoker.shotpower;
			A_MuzzleClimb(1.2*shotpower,-2.4*shotpower,1.2*shotpower,-2.4*shotpower);
		}goto flasheither;
	flashright2:
		SW2F B 0 A_JumpIf(invoker.weaponstatus[SAWDS_CHAMBER1]>2,"nope");
		---- B 1 bright{
			A_Light2();
			HDFlashAlpha(64,false,overlayid());
			A_StartSound("weapons/sawedslayersingle",CHAN_WEAPON,CHANF_OVERLAP);
			A_ZoomRecoil(0.9);
			invoker.weaponstatus[SAWDS_CHAMBER1]=1;

			invoker.Fire(self,1);
		}
		TNT1 A 1{
			A_Light0();
			double shotpower=invoker.shotpower;
			A_MuzzleClimb(-1.2*shotpower,-2.4*shotpower,-1.2*shotpower,-2.4*shotpower);
		}goto flasheither;
	flashboth2:
		SW2F C 0 {
			A_JumpIf(invoker.weaponstatus[SAWDS_CHAMBER1]>2,"nope");
			A_JumpIf(invoker.weaponstatus[SAWDS_CHAMBER2]>2,"nope");
			}
		---- C 1 bright{
			A_Light2();
			HDFlashAlpha(128);
			A_StartSound("weapons/sawedslayersingle",CHAN_WEAPON,CHANF_OVERLAP);
			A_StartSound("weapons/sawedslayersingle",CHAN_WEAPON,CHANF_OVERLAP);
			A_ZoomRecoil(0.7);
			invoker.weaponstatus[SAWDS_CHAMBER1]=1;
			invoker.weaponstatus[SAWDS_CHAMBER2]=1;

			invoker.Fire(self,0);
			invoker.Fire(self,1);
		}
		TNT1 A 1{
			A_Light0();
			double shotpower=invoker.shotpower;
			double mlt=(invoker.bplayingid?0.9:-0.9)*shotpower;
			double mlt2=-4.*shotpower;
			A_MuzzleClimb(mlt,mlt2,mlt,mlt2);
		}goto flasheither;
	recoil:
		#### K 1;
		goto ready;

	reload:
		#### A 0{
					if(
				invoker.weaponstatus[SLAYS_CHAMBER1]>1&&
				invoker.weaponstatus[SLAYS_CHAMBER2]>1
			)setweaponstate("nope");
			invoker.weaponstatus[0]&=~SAWDF_UNLOADONLY;
				if(countinv("HDShellAmmo"))
				invoker.weaponstatus[0]|=SAWDF_FROMPOCKETS;
			else setweaponstate("nope");
		}goto reloadstart;
	reloadstart:
	unloadstart:
		#### K 1 offset(0,34) EmptyHand();
		#### K 1 offset(0,40);
		#### K 2 offset(0,46);
		#### K 4 offset(0,47) A_StartSound("weapons/sawedsshoto",8);
		#### B 3 offset(0,46) A_MuzzleClimb(
			frandom(0.6,1.2),frandom(0.6,1.2),
			frandom(0.6,1.2),frandom(0.6,1.2),
			frandom(1.2,2.4),frandom(1.2,2.4)
		);
		#### C 2 offset(0,36){
			//eject whatever is already loaded
			for(int i=0;i<2;i++){
				int chm=invoker.weaponstatus[SAWDS_CHAMBER1+i];
				invoker.weaponstatus[SAWDS_CHAMBER1+i]=0;
				actor sss=null;
				if(chm>1)sss=spawn("HDUnspentShell",pos+HDMath.GetGunPos(self),ALLOW_REPLACE);
				else if(chm==1)sss=spawn("HDSpentShell",pos+HDMath.GetGunPos(self),ALLOW_REPLACE);
				if(!!sss){
					double aaa=angle+frandom(-20,20);
					sss.pitch=pitch;sss.angle=angle;
					sss.vel=(cos(aaa),sin(aaa),2);
					if(chm>1)sss.vel*=frandom(0.5,2);
					sss.vel+=vel;
					sss.target=self;
				}
			}
		}
		#### C 2 offset(1,34);
		#### C 2 offset(2,34);
		#### C 2 offset(4,34);
		#### C 6 offset(0,36){
			if(invoker.weaponstatus[0]&SAWDF_UNLOADONLY){
				setweaponstate("unloadend");
				return;
			}

			//play animation to search pockets as appropriate
			if(invoker.weaponstatus[0]&SAWDF_FROMPOCKETS)
				A_StartSound("weapons/pocket",9);
				else setweaponstate("reloadnopocket");
		}
		#### C 3 offset(2,35);
		#### C 3 offset(0,35);
		#### C 3 offset(0,34);
	reloadnopocket:
		#### D 4 offset(1,35){
			//set frame to L
			FDSingleHandSpriteCheck(11);
		}
		#### # 2 offset(0,36);
		#### E 2 offset(0,40){
			//set frame to M
			FDSingleHandSpriteCheck(12);
		}
		#### # 1 offset(0,46);
		#### # 2 offset(0,54);

		TNT1 A 4{
			//take up to 2 shells in hand
			int ssh=0;
			if(invoker.weaponstatus[0]&SAWDF_FROMPOCKETS){
				ssh=min(2,countinv("HDShellAmmo"));
				if(ssh>0)A_TakeInventory("HDShellAmmo",ssh);
			}

			//if the above leaves you with nothing, abort
			if(ssh<1){
				A_SetTics(0);
				return;
			}

			//transfer from hand to chambers
			ssh--;
			while(ssh>=0){
				invoker.weaponstatus[SAWDS_CHAMBER2-ssh]=2;
				ssh--;
			}
		}
		TNT1 A 3 A_StartSound("weapons/sawedsshotl",8);
		SWSG B 2 offset(0,46) A_CheckPistolHand();
		#### B 1 offset(0,42);
		#### K 2 offset(0,42) A_StartSound("weapons/sawedsshotc",8);
		#### A 2;
		goto ready;
	unloadend:
		SWSG C 4 {
		A_StartSound("weapons/sawedsshotl",8,CHANF_OVERLAP);
		A_CheckPistolHand();
		}
		#### B 2 offset(0,46);
		#### B 1 offset(0,42);
		#### K 2 offset(0,42) A_StartSound("weapons/sawedsshotc",8);
		#### A 1;
		goto nope;

	unload:
		#### K 2 offset(0,34){
		invoker.weaponstatus[0]|=SAWDF_UNLOADONLY;
		}goto unloadstart;

	altreload:
	swappistols:
		---- A 0 A_SwapHandguns();
		---- A 0{
			bool id=(Wads.CheckNumForName("id",0)!=-1);
			bool offhand=invoker.wronghand;
			bool lefthanded=(id!=offhand);
			if(lefthanded){
				A_Overlay(1025,"raiseleft");
				A_Overlay(1026,"lowerright");
			}else{
				A_Overlay(1025,"raiseright");
				A_Overlay(1026,"lowerleft");
			}
		}
		TNT1 A 5;
		SWSG A 0 A_CheckPistolHand();
		goto nope;
	lowerleft:
		SWSG A 0 A_JumpIf(Wads.CheckNumForName("id",0)!=-1,2);
		SW2G A 0;
		#### B 1 offset(-6,38);
		#### B 1 offset(-12,48);
		#### B 1 offset(-20,60);
		#### B 1 offset(-34,76);
		#### B 1 offset(-50,86);
		stop;
	lowerright:
		SW2G A 0 A_JumpIf(Wads.CheckNumForName("id",0)!=-1,2);
		SWSG A 0;
		#### B 1 offset(6,38);
		#### B 1 offset(12,48);
		#### B 1 offset(20,60);
		#### B 1 offset(34,76);
		#### B 1 offset(50,86);
		stop;
	raiseleft:
		SWSG A 0 A_JumpIf(Wads.CheckNumForName("id",0)!=-1,2);
		SW2G A 0;
		#### A 1 offset(-50,86);
		#### A 1 offset(-34,76);
		#### A 1 offset(-20,60);
		#### A 1 offset(-12,48);
		#### A 1 offset(-6,38);
		stop;
	raiseright:
		SW2G A 0 A_JumpIf(Wads.CheckNumForName("id",0)!=-1,2);
		SWSG A 0;
		#### A 1 offset(50,86);
		#### A 1 offset(34,76);
		#### A 1 offset(20,60);
		#### A 1 offset(12,48);
		#### A 1 offset(6,38);
		stop;
	whyareyousmiling:
		#### B 1 offset(0,48);
		#### B 1 offset(0,60);
		#### B 1 offset(0,76);
		TNT1 A 7;
		SWSG A 0{
			invoker.wronghand=!invoker.wronghand;
			A_CheckPistolHand();
		}
		#### B 1 offset(0,76);
		#### B 1 offset(0,60);
		#### B 1 offset(0,48);
		goto nope;

	spawn:
		SGSW A -1;
		stop;
	}
	override void InitializeWepStats(bool idfa){
		weaponstatus[SAWDS_CHAMBER1]=2;
		weaponstatus[SAWDS_CHAMBER2]=2;
		handshells=0;
	}
}
enum sawedstatus{
	SAWDF_UNLOADONLY=1,
	SAWDF_DOUBLE=2,
	SAWDF_FROMPOCKETS=4,

	SAWDS_CHAMBER1=1,
	SAWDS_CHAMBER2=2,
	//3 is for side saddles
	SAWDS_HEAT1=4,
	SAWDS_HEAT2=5,
};


class SawedSpawn:IdleDummy{
	states{
	spawn:
		TNT1 A 0 nodelay{
			let zzz=SawedSlayer(spawn("SawedSlayer",pos,ALLOW_REPLACE));
			HDF.TransferSpecials(self, zzz);
			spawn("ShellBoxPickup",pos+(3,0,0),ALLOW_REPLACE);
		}stop;
	}
}
