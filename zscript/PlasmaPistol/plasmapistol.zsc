			if(invoker.weaponstatus[PLPS_FUSION]==1) A_StartSound("weapon/plpistolfire_marathon", 10, CHANF_OVERLAP);
			else A_StartSound("weapon/plpistolfire", 10, CHANF_OVERLAP);
			invoker.weaponstatus[PLPS_HEAT]+=random(4,8);
			if(invoker.weaponstatus[PLPS_HEAT] >= 100)
			{
				invoker.weaponstatus[PLPS_HEAT]+=25;
				A_StartSound("weapon/plpistoloverheatsmall", 11, CHANF_OVERLAP, volume: 0.35);
			}
			A_PlasmaPistolZap();
			invoker.weaponstatus[PLPS_CHARGE]=0;
		}
		#### C 0 A_JumpIf(invoker.weaponstatus[PLPS_HEAT] > 100, "Overheat");
		#### C 1 Offset(0, 33);
