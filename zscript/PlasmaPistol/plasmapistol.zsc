			A_OverlayPivotAlign(-1000, PSPA_CENTER, PSPA_CENTER);*/
			A_StartSound("weapon/plpistolwoosh", 13);
			A_StopSound(CHAN_WEAPON);
		}
		Goto nope;
		
	Overheat:
		#### C 0 
		{
			A_StartSound("weapon/plpistolsteam", CHAN_WEAPON, CHANF_LOOPING, volume: 0.15);
			//A_Overlay(-1000, "LightDone");
		}
	Overheatloop:
		#### C 1 
		{
			A_WeaponReady(WRF_ALL|WRF_NOPRIMARY);
			if(!random(0,6))A_StartSound("weapon/plpistolcrackle", 12, volume: 0.25);
			A_MuzzleClimb(frandom(-0.1,0.1),frandom(-0.1,0.1));
		}
		#### A 0 A_JumpIf(invoker.weaponstatus[PLPS_HEAT] <= 90, "Ready");
		Loop;
		
	Flash:
		ZUSF B 2 Bright A_Light1();
		//ZUSF B 1 Bright A_OverlayAlpha(1000, 0.3);
		Goto LightDone;
	Flash2:
		ZUSF B 1 Bright A_Light2();
		ZUSF A 2 Bright A_Light1();
		//ZUSF B 1 Bright A_OverlayAlpha(1000, 0.3);
		Goto LightDone;
	FlashCharge:
		ZUSF CCDD 1 BRIGHT 
		{
			double ball = invoker.fuck / 50;
			A_OverlayScale(-1000, ball);
			double lightpower = invoker.fuck;
			actor lighter = Spawn("PlasmaPistolChargeLight", pos+gunpos());
			PlasmaPistolChargeLight(lighter).args[3]=lightpower;
		}
		Loop;
	FlashUncharge:
		TNT1 A 1 A_OverlayAlpha(-1000, 0.9);
		TNT1 A 1 A_OverlayAlpha(-1000, 0.6);
		TNT1 A 1 A_OverlayAlpha(-1000, 0.3);
		TNT1 A 1 A_OverlayAlpha(-1000, 0.05);
		TNT1 A 0 A_Overlay(-1000, "FlashUncharge");
		Goto Lightdone;
	beep:
		TNT1 A 1;
		TNT1 A 0 A_JumpIf(invoker.weaponstatus[PLPS_CHARGE] < 50, "beep");
		ZUSF X 3 BRIGHT A_StartSound("weapon/plpistolchargebeep", 12, CHANF_OVERLAP);
		TNT1 A 34;
		Loop;
		
	HeatDelay:
		TNT1 AAAAAAAAAAAAAA 1 {invoker.weaponstatus[PLPS_HEAT]++;}
	HeatDelay2:
		TNT1 AAAAA 2 {invoker.weaponstatus[PLPS_HEAT]++;}
		TNT1 AAAA 3 {invoker.weaponstatus[PLPS_HEAT]++;}
		TNT1 AAA 4 {invoker.weaponstatus[PLPS_HEAT]++;}
		Stop;
		
	unload:
		#### A 0{
			invoker.weaponstatus[0]|=PLPF_JUSTUNLOAD;
			if(invoker.weaponstatus[PLPS_BATTERY]>=0)
				return resolvestate("unmag");
			return resolvestate("nope");
		}
	unmag:
		#### A 2 offset(0,33){
			A_SetCrosshair(21);
			A_MuzzleClimb(frandom(-1.2,-2.4),frandom(1.2,2.4));
		}
		#### A 3 offset(0,35);
		#### A 2 offset(0,40) A_StartSound("weapons/plasopen",8);
		#### A 0{
			int bat=invoker.weaponstatus[PLPS_BATTERY];
			A_MuzzleClimb(frandom(-1.2,-2.4),frandom(1.2,2.4));
			if(
				(
					bat<0
				)||(
					!PressingUnload()&&!PressingReload()
				)
			)return resolvestate("dropmag");
			return resolvestate("pocketmag");
		}

	dropmag:
		---- A 0{
			int bat=invoker.weaponstatus[PLPS_BATTERY];
			invoker.weaponstatus[PLPS_BATTERY]=-1;
			if(bat>=0){
				HDMagAmmo.SpawnMag(self,"HDBattery",bat);
			}
		}goto magout;

	pocketmag:
		---- A 0{
			int bat=invoker.weaponstatus[PLPS_BATTERY];
			invoker.weaponstatus[PLPS_BATTERY]=-1;
			if(bat>=0){
				HDMagAmmo.GiveMag(self,"HDBattery",bat);
			}
		}
		#### A 8 offset(0,43) A_StartSound("weapons/pocket",9);
		#### A 8 offset(0,42) A_StartSound("weapons/pocket",9);
		goto magout;

	magout:
		---- A 0 A_JumpIf(invoker.weaponstatus[0]&PLPF_JUSTUNLOAD,"Reload3");
		goto loadmag;

	reload:
		#### A 0{
			invoker.weaponstatus[0]&=~PLPF_JUSTUNLOAD;
			if(
				invoker.weaponstatus[PLPS_BATTERY]<20
				&&countinv("HDBattery")
			)setweaponstate("unmag");
		}goto nope;

	loadmag:
		#### A 4 offset(0,42);
		#### A 2 offset(0,43){if(health>39)A_SetTics(0);}
		#### AA 2 offset(0,42);
		#### A 2 offset(0,44) A_StartSound("weapons/pocket",9);
		#### A 4 offset(0,43) A_StartSound("weapons/pocket",9);
		#### A 6 offset(0,42);
		#### A 8 offset(0,38)A_StartSound("weapons/plasload",8);
		#### A 4 offset(0,37){if(health>39)A_SetTics(0);}
		#### A 4 offset(0,36)A_StartSound("weapons/plasclose",8);

		#### A 0{
			let mmm=HDMagAmmo(findinventory("HDBattery"));
			if(mmm)invoker.weaponstatus[PLPS_BATTERY]=mmm.TakeMag(true);
		}goto reload3;

	reload3:
		#### A 6 offset(0,40){
			A_StartSound("weapons/plasclose2",8);
		}
		#### A 2 offset(0,36);
		#### A 4 offset(0,33);
		goto nope;

	user3:
		#### A 0 A_MagManager("HDBattery");
		goto ready;
		

	altreload:
	swappistols:
		---- A 0 A_SwapHandguns();
		---- A 0{
			bool id=(Wads.CheckNumForName("id",0)!=-1);
			bool offhand=invoker.wronghand;
			bool lefthanded=(id!=offhand);
			if(lefthanded){
				A_Overlay(1025,"raiseleft");
				A_Overlay(1026,"lowerright");
			}else{
				A_Overlay(1025,"raiseright");
				A_Overlay(1026,"lowerleft");
			}
		}
		TNT1 A 5;
		ZUSG A 0 A_CheckPistolHand();
		goto nope;
	lowerleft:
		ZUSG A 0;
		#### B 1 offset(-6,38);
		#### B 1 offset(-12,48);
		#### B 1 offset(-20,60);
		#### B 1 offset(-34,76);
		#### B 1 offset(-50,86);
		stop;
	lowerright:
		ZUS2 A 0;
		#### B 1 offset(6,38);
		#### B 1 offset(12,48);
		#### B 1 offset(20,60);
		#### B 1 offset(34,76);
		#### B 1 offset(50,86);
		stop;
	raiseleft:
		ZUSG A 0;
		#### A 1 offset(-50,86);
		#### A 1 offset(-34,76);
		#### A 1 offset(-20,60);
		#### A 1 offset(-12,48);
		#### A 1 offset(-6,38);
		stop;
	raiseright:
		ZUS2 A 0;
		#### A 1 offset(50,86);
		#### A 1 offset(34,76);
		#### A 1 offset(20,60);
		#### A 1 offset(12,48);
		#### A 1 offset(6,38);
		stop;
	whyareyousmiling:
		#### B 1 offset(0,48);
		#### B 1 offset(0,60);
		#### B 1 offset(0,76);
		TNT1 A 7;
		ZUSG A 0{
			invoker.wronghand=!invoker.wronghand;
			A_CheckPistolHand();
		}
		#### B 1 offset(0,76);
		#### B 1 offset(0,60);
		#### B 1 offset(0,48);
		goto nope;
		
 	Spawn:
		ZUSP A -1;
		Stop;
	}
	override void initializewepstats(bool idfa){
		weaponstatus[PLPS_BATTERY]=20;
		weaponstatus[PLPS_HEAT]=0;
		weaponstatus[PLPS_SHOTS]=0;
		weaponstatus[PLPS_CHARGE]=0;
	}
	override void loadoutconfigure(string input){

		int fusion=getloadoutvar(input,"fusion",1);
		if(fusion>0)weaponstatus[PLPS_FUSION]=1;
	}
}

enum plpstatus{
	PLPF_JUSTUNLOAD=1,
	
	PLPS_FLAGS=0,
	PLPS_BATTERY=1,
	PLPS_CHARGE=2,
	PLPS_HEAT=3,
	PLPS_SHOTS=4,
	PLPS_FUSION=5
};

class PlasmaPistolSpotFlash:IdleDummy{
	default{
		+puffonactors +hittracer +puffgetsowner +rollsprite +rollcenter +forcexybillboard
		renderstyle "add";
		obituary "%o was roasted by %k's particle splatter.";
		decal "Scorch";
		seesound "weapons/plasmaf";
		deathsound "weapon/plpistolhit";
	}
	double impactdistance;
	double impactcharge;
	override void postbeginplay(){
		if(impactdistance>impactcharge){
			destroy();
			return;
		}
		super.postbeginplay();

		double impactfalloff = sqrt(impactdistance * 0.5) ** 0.3;
		
		//fuck it, use old calculation if charge shot so that it actually stays
		//powerful, and use the new one for the normal shots so they actually
		//deal good damage at range
		
		double impactcloseness=impactcharge-impactfalloff;
		if(impactcharge>1400) impactcloseness=impactcharge-impactdistance;
		
		scale*=(impactcloseness)*0.0006;
		alpha=scale.y+0.3;
		vel=(frandom(-1.0,1.0),frandom(-1.0,1.0),frandom(-0.5,1.5));

		int n=int(max(impactcloseness*0.03,2));
		int n1=n*3/5;
		int n2=n*2/5;
		//a_logint(n);a_logint(n1);a_logint(n2);
		//a_logint(impactcharge);a_logint(impactfalloff);a_logint(impactdistance);
		if(tracer){
			if(impactcharge>1400) HDF.Give(tracer,"Heat",n*3);
			else HDF.Give(tracer,"Heat",n);
			int dmgflags=target&&target.player?DMG_PLAYERATTACK:0;
			if(impactcharge>1400) tracer.damagemobj(self,target,random(n1,n),"electrical",dmgflags);
			else tracer.damagemobj(self,target,n1,"electrical",dmgflags);
		}
		A_HDBlast(
			n1,random(1,n),n2,"electrical",
			n,-n,
			immolateradius:n1,immolateamount:random(4,8)*n2/-10,immolatechance:n
		);

		pitch=frandom(80,90);
		angle=frandom(0,360);
		A_SpawnItemEx("PlasmaPistolSpotFlashLight",flags:SXF_NOCHECKPOSITION|SXF_SETTARGET);
		A_SpawnChunks("HDGunSmoke",clamp(n2*3/5,4,7),3,6);
		A_StartSound(deathsound);
		A_AlertMonsters();
	}
	states{
	spawn:
		ZFXE FF 1 bright;
		ZFXE AAA 1 bright A_FadeIn(0.1);
		ZFXE BCDE 1 bright A_FadeOut(0.1);
		stop;
	}
}

class PlasmaPistolSpotFlashLight:PointLight{
	override void postbeginplay(){
		super.postbeginplay();
		args[0]=128;
		args[1]=256;
		args[2]=96;
		args[3]=64;
		args[4]=0;
	}
	override void tick(){
		if(isfrozen())return;
		args[3]+=randompick(-10,5,-20);
		if(args[3]<1)destroy();
	}
}

class PlasmaPistolChargeLight:PointLight{
	double fucker;
	override void postbeginplay(){
		super.postbeginplay();
		args[0]=96;
		args[1]=256;
		args[2]=96;
		//args[3]=0;
		args[4]=0;
	}
	override void tick(){
		if(isfrozen())return;
		args[3]+=random(-20, -10);
		if(args[3]<1)destroy();
	}
}

//LINGERING THUNDER 2: THE SEQUEL: BECAUSE I NEED TO CHANGE THE COLOR
//OF THE DYNAMIC LIGHT AND THIS IS THE EASIEST WAY I CAN THINK OF!
//and also because im scared of zscript
class GreenLingeringThunder:IdleDummy{
	int startingstamina;
	default{
		stamina 256;
	}
	override void postbeginplay(){
		super.postbeginplay();
		startingstamina=stamina;
	}
	void A_Zap(){
		if(stamina<1){destroy();return;}
		stamina-=5;
		blockthingsiterator zit=blockthingsiterator.create(self,96+(stamina>>2));
		int icount=0;
		bool haszapped=false;
		while(zit.next()){
			actor zt=zit.thing;
			if(
				!zt
				||(!zt.bshootable&&!zt.bsolid)
				||abs(zt.pos.z-pos.z)>96
				||zt.floorz+(stamina>>2)<zt.pos.z
				||random(0,3)
				||!checksight(zt)
			)continue;
			haszapped=true;
			int zappower=Zap(zt,self,target,stamina);
			stamina-=max(2,zappower>>3);
		}
		if(!haszapped){
			double oldrad=radius;
			a_setsize(stamina,height);
			Zap(self,self,target,stamina,true);
			a_setsize(oldrad,height);
		}
		A_SetTics(max(1,min(random(4,24),int(sqrt(startingstamina-stamina)))));
	}
	static int Zap(actor victim,actor inflictor,actor source,int baseamount,bool nodmg=false){
		//create arc
		double ztr=victim.radius;
		vector3 nodes[4];
		int len=min(35,baseamount);
		nodes[0]=victim.pos+(frandom(-ztr,ztr),frandom(-ztr,ztr),frandom(0,victim.height));
		nodes[1]=nodes[0]+(frandom(-len,len),frandom(-len,len),frandom(-len,len));
		nodes[2]=nodes[1]+(frandom(-len,len),frandom(-len,len),frandom(-(len>>1),len));
		nodes[3]=nodes[2]+(frandom(-len,len),frandom(-len,len),frandom(-len*2/3,(len>>1)));
		for(int i=1;i<4;i++){
			vector3 pastnode=nodes[i-1];
			vector3 particlepos=nodes[i]-pastnode;
			int iterations=int(particlepos.length());
			vector3 particlemove=particlepos/iterations;
			particlepos=pastnode-victim.pos;
			for(int i=0;i<iterations;i++){
				victim.A_SpawnParticle("white",
					SPF_RELATIVE|SPF_FULLBRIGHT,(len>>1),frandom(1,7),0,
					particlepos.x,particlepos.y,particlepos.z,
					frandom(-0.1,0.1),frandom(-0.1,0.1),frandom(0.1,0.2),
					frandom(-0.1,0.1),frandom(-0.1,0.1),-0.05
				);
				particlepos+=particlemove+(frandom(-1,1),frandom(-1,1),frandom(-1,1));
			}
		}

		int zappower=random(baseamount>>2,baseamount);
		victim.A_StartSound("weapons/plasidle",CHAN_AUTO,volume:frandom(0.2,0.6));
		victim.A_StartSound("misc/arccrackle",CHAN_AUTO);
		victim.A_StartSound("weapons/plascrack",CHAN_AUTO,volume:frandom(0.2,0.6));
		actor bsfl=spawn("PlasmaPistolSpotFlashLight",victim.pos,ALLOW_REPLACE);
		bsfl.target=victim;

		//make bodies spasm
		if(
			victim.bcorpse
			&&victim.bshootable
			&&victim.mass
			&&!!victim.findstate("dead")
		){
			victim.vel.z+=3.*zappower/victim.mass;
		}

		if(!nodmg)victim.damagemobj(inflictor,source,zappower,"electrical",source&&source.player?DMG_PLAYERATTACK:0);
		return zappower;
	}
	states{
	spawn:
		TNT1 A 1 A_Zap();
		wait;
	}
}
