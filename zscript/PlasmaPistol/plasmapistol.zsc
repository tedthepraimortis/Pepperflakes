const HDLD_PLPISTOL="plp";
class HDPlasmaPistol : HDCellWeapon
{
	Default
	{
		+hdweapon.fitsinbackpack
		+hdweapon.reverseguninertia
		scale 0.2;
		weapon.selectionorder 50;
		weapon.slotnumber 2;
		weapon.slotpriority 1.2;
		weapon.kickback 30;
		weapon.bobrangex 0.1;
		weapon.bobrangey 0.6;
		weapon.bobspeed 2.5;
		obituary "$PEPPER_OBITUARY_PLASMAPISTOL";
		inventory.pickupmessage "$PEPPER_PICKUP_PLASMAPISTOL";
		weapon.bobstyle "normal";
		inventory.icon "ZUSPB0";
		Tag "$PEPPER_TAG_PLASMAPISTOL";
		hdweapon.refid "plp";
		hdweapon.barrelsize 20,0.3,0.5;
		//hdweapon.barrelsize 28,1.6,3;
		+WEAPON.NOAUTOFIRE
	}

	
	bool wronghand;
	
	override bool AddSpareWeapon(actor newowner){return AddSpareWeaponRegular(newowner);}
	
	override hdweapon GetSpareWeapon(actor newowner,bool reverse,bool doselect){return GetSpareWeaponRegular(newowner,reverse,doselect);}
	
	action void A_SwapHandguns(){
		let mwt=SpareWeapons(findinventory("SpareWeapons"));
		if(!mwt){
			setweaponstate("whyareyousmiling");
			return;
		}
		int pistindex=mwt.weapontype.find(invoker.getclassname());
		if(pistindex==mwt.weapontype.size()){
			setweaponstate("whyareyousmiling");
			return;
		}
		A_WeaponBusy();

		array<string> wepstat;
		string wepstat2="";
		mwt.weaponstatus[pistindex].split(wepstat,",");
		for(int i=0;i<wepstat.size();i++){
			if(i)wepstat2=wepstat2..",";
			wepstat2=wepstat2..invoker.weaponstatus[i];
			invoker.weaponstatus[i]=wepstat[i].toint();
		}
		mwt.weaponstatus[pistindex]=wepstat2;

		invoker.wronghand=!invoker.wronghand;
	}
	
	override void tick()
	{
		super.tick();
		drainheat(PLPS_HEAT,1);
		//if(PLPS_HEAT < 1) self.A_StopSound(CHAN_WEAPON);
	}
	
	override double gunmass(){
		return 4+(weaponstatus[PLPS_BATTERY]<0?0:2);
	}
	
	override double weaponbulk(){
		return 60+(weaponstatus[1]>=0?ENC_BATTERY_LOADED:0);
	}
	
	override string,double getpickupsprite(){return "ZUSPA0",0.4;}

	override void DrawHUDStuff(HDStatusBar sb,HDWeapon hdw,HDPlayerPawn hpl)
	{
		if(sb.hudlevel==1){
			sb.drawbattery(-54,-4,sb.DI_SCREEN_CENTER_BOTTOM,reloadorder:true);
			sb.drawnum(hpl.countinv("HDBattery"),-46,-8,sb.DI_SCREEN_CENTER_BOTTOM);
		}
		int bat=hdw.weaponstatus[PLPS_BATTERY];
		int charge=hdw.weaponstatus[PLPS_CHARGE];
		int heat=hdw.weaponstatus[PLPS_HEAT];
		int fuck=hdw.weaponstatus[PLPS_SHOTS];
		
		if(bat>0)sb.drawwepnum(bat,20);
		else if(!bat)sb.drawstring(
			sb.mamountfont,"00000",
			(-16,-9),sb.DI_TEXT_ALIGN_RIGHT|sb.DI_TRANSLATABLE|sb.DI_SCREEN_CENTER_BOTTOM,
			Font.CR_DARKGRAY
		);
		
		if(heat<100)sb.drawwepnum(clamp(charge,0, 50) ,50,posy:-10);//alwaysprecise:TRUE
		
		if(heat>=100 && !hd_debug)
		{
			sb.drawstring(sb.pnewsmallfont, "OVER", (-19,-24), sb.DI_SCREEN_CENTER_BOTTOM|sb.DI_TEXT_ALIGN_RIGHT, Font.CR_RED, scale:(0.5,0.5));
			sb.drawstring(sb.pnewsmallfont, "HEAT", (-19,-17), sb.DI_SCREEN_CENTER_BOTTOM|sb.DI_TEXT_ALIGN_RIGHT, Font.CR_RED, scale:(0.5,0.5));
		}
		
		if(bat>0)
		{
			if(heat<100)sb.drawstring(sb.pnewsmallfont, "%", (-17,-21), sb.DI_SCREEN_CENTER_BOTTOM|sb.DI_TEXT_ALIGN_RIGHT, Font.CR_DARKGRAY, scale:(0.5,0.5));
			if(heat<100)sb.drawnum(heat,-23,-21,sb.DI_SCREEN_CENTER_BOTTOM|sb.DI_TEXT_ALIGN_RIGHT,Font.CR_RED);
			if(heat<80)sb.drawnum(heat,-23,-21,sb.DI_SCREEN_CENTER_BOTTOM|sb.DI_TEXT_ALIGN_RIGHT,Font.CR_YELLOW);
			if(heat<60)sb.drawnum(heat,-23,-21,sb.DI_SCREEN_CENTER_BOTTOM|sb.DI_TEXT_ALIGN_RIGHT,Font.CR_ORANGE);
			if(heat<30)sb.drawnum(heat,-23,-21,sb.DI_SCREEN_CENTER_BOTTOM|sb.DI_TEXT_ALIGN_RIGHT,Font.CR_DARKGRAY);
			if(heat<1)sb.drawnum(heat,-23,-21,sb.DI_SCREEN_CENTER_BOTTOM|sb.DI_TEXT_ALIGN_RIGHT,Font.CR_BLACK);
		}
		
		if(hd_debug)sb.drawnum(fuck,-23,-33,sb.DI_SCREEN_CENTER_BOTTOM|sb.DI_TEXT_ALIGN_RIGHT,Font.CR_WHITE);
		if(hd_debug)sb.drawnum(bat,-23,-27,sb.DI_SCREEN_CENTER_BOTTOM|sb.DI_TEXT_ALIGN_RIGHT,Font.CR_WHITE);
		if(hd_debug)sb.drawnum(heat,-23,-21,sb.DI_SCREEN_CENTER_BOTTOM|sb.DI_TEXT_ALIGN_RIGHT,Font.CR_WHITE);
	}
	
	override string gethelptext(){
		return
		LWPHELP_FIRESHOOT.."  (Hold for Charge Shot)\n"
		..LWPHELP_ALTFIRE.."  (While holding fire) Cancel Charge\n"
		..LWPHELP_ALTRELOAD.."  Quick-Swap (if available)\n"
		..LWPHELP_RELOAD.."  Reload mag\n"
		..LWPHELP_MAGMANAGER
		..LWPHELP_UNLOADUNLOAD
		;
	}
	
	override void DrawSightPicture(
		HDStatusBar sb,HDWeapon hdw,HDPlayerPawn hpl,
		bool sightbob,vector2 bob,double fov,bool scopeview,actor hpc
	){
		int cx,cy,cw,ch;
		[cx,cy,cw,ch]=screen.GetClipRect();
		sb.SetClipRect(
			-16+bob.x,-4+bob.y,32,16,
			sb.DI_SCREEN_CENTER
		);
		vector2 bobb=bob*1.2;
//		bobb.y=clamp(bobb.y,-8,8);
		sb.drawimage(
			"tbfrntsit",(0,0)+bobb,sb.DI_SCREEN_CENTER|sb.DI_ITEM_TOP
		);
		sb.SetClipRect(cx,cy,cw,ch);
		sb.drawimage(
			"tbbaksit",(0,0)+bob,sb.DI_SCREEN_CENTER|sb.DI_ITEM_TOP,
			alpha:0.9
		);
	}
	
	override void failedpickupunload(){
		failedpickupunloadmag(PLPS_BATTERY,"HDBattery");
	}
	
	override void consolidate(){
		CheckBFGCharge(PLPS_BATTERY);
	}
	
	override void DropOneAmmo(int amt){
		if(owner){
			owner.A_DropInventory("HDBattery",amt);
		}
	}
	
	override void ForceBasicAmmo(){
		owner.A_TakeInventory("HDBattery");
		owner.A_GiveInventory("HDBattery");
	}
	
	override void OnDrop(actor dropper)
	{
		//if(self.weaponstatus[PLPS_CHARGE]>0)self.A_PlasmaPistolZap();
		dropper.A_StopSound(CHAN_WEAPON);
		super.OnDrop(dropper);
	}
	
	static void PlasmaPistolZap(
		actor caller,
		double zoffset=32,
		int charge=0,
		int battery=200,
		int fusion=0
	)
	{
		//determine angle
		double shootangle=caller.angle;
		double shootpitch=caller.pitch;
		vector3 shootpos=(0,0,zoffset);
		let hdp=hdplayerpawn(caller);
		if(hdp&&hdp.scopecamera){
			shootangle=hdp.scopecamera.angle;
			shootpitch=hdp.scopecamera.pitch;
			shootpos=hdp.gunpos;
		}
		shootangle+=frandom(-0.35,0.35);
		shootpitch+=frandom(-0.35,0.25);
		
		//create the line
		flinetracedata tlt;
		caller.linetrace(
			shootangle,
			8000+200*battery,
			shootpitch,
			flags:TRF_NOSKY|TRF_ABSOFFSET,
			offsetz:shootpos.z,
			offsetforward:shootpos.x,
			offsetside:shootpos.y,
			data:tlt
		);
		if(
			tlt.hittype==Trace_HitNone
			||(
				tlt.hitline&&(
					tlt.hitline.special==Line_Horizon
					||(
						tlt.linepart==2
						&&tlt.hitsector.gettexture(0)==skyflatnum
					)||(
						tlt.linepart==1
						&&tlt.hitline.sidedef[1]
						&&hdmath.oppositesector(tlt.hitline,tlt.hitsector).gettexture(0)==skyflatnum
					)
				)
			)
		)return;
		
		//alt does a totally different thing
		//if(charge >= 30)
		//{
		if(tlt.hittype==Trace_HitNone||tlt.distance>2000)return;
		actor bbb=spawn("plasmapistolspotflash",tlt.hitlocation-tlt.hitdir,ALLOW_REPLACE);
		if(fusion==1) bbb.deathsound="weapon/plpistolhit_marathon";
		bbb.setz(clamp(bbb.pos.z,bbb.floorz,bbb.ceilingz-8));
		if(!random(0,3))(greenlingeringthunder.zap(bbb,bbb,caller,40,true));
		if(charge>=50)
		{
			plasmapistolspotflash(bbb).impactdistance=tlt.distance-16*battery;
			plasmapistolspotflash(bbb).impactcharge=1500;
		}
		if(charge<50)
		{
			plasmapistolspotflash(bbb).impactdistance=tlt.distance-16*battery/10;
			plasmapistolspotflash(bbb).impactcharge=1200;
		}
		bbb.angle=caller.angle;
		bbb.A_SprayDecal("Scorch",12);
		bbb.pitch=caller.pitch;
		bbb.target=caller;
		bbb.tracer=tlt.hitactor; //damage inflicted on the puff's end
		if(tlt.hitline)doordestroyer.CheckDirtyWindowBreak(tlt.hitline,0.005*battery,tlt.hitlocation);
		//return;
		//}

		int basedmg=int(max(0,20-tlt.distance*(1./50.)));
		int dmgflags=caller&&caller.player?DMG_PLAYERATTACK:0; //don't know why the player damagemobj doesn't work

		if(tlt.hitline)doordestroyer.CheckDirtyWindowBreak(tlt.hitline,0.003*basedmg,tlt.hitlocation);
		
		//wet actor
		if(
			tlt.hitactor
		){
			actor hitactor=tlt.hitactor;
			if(hitactor.bloodtype=="ShieldNotBlood"){
				hitactor.damagemobj(null,caller,random(1,(battery<<2)),"Balefire",dmgflags);
			}else if(
				hitactor.bnodamage
				||hitactor.bnoblood
				||hitactor.bloodtype=="NotQuiteBloodSplat"
				||random(0,7)
				||hitactor.countinv("ImmunityToFire")
				||HDWoundFixer.CheckCovered(hitactor,true)
			){
				//dry actor - ping damage and continue
				if(!random(0,5))(greenlingeringthunder.zap(hitactor,hitactor,caller,40,true));
				hdf.give(hitactor,"Heat",(basedmg>>1));
				hitactor.damagemobj(null,caller,1,"electrical",dmgflags);
			}else{
				//wet actor
				if(!random(0,7))(greenlingeringthunder.zap(hitactor,hitactor,caller,(basedmg<<1),true));
				hdf.give(hitactor,"Heat",(basedmg<<1));
				hitactor.damagemobj(null,caller,basedmg,"electrical",dmgflags);
				actor sss=spawn("HDGunsmoke",tlt.hitlocation,ALLOW_REPLACE);
				sss.vel=(0,0,1)-tlt.hitdir;
				return;
			}
		}
	}
	
	Action void A_PlasmaPistolZap()
	{
		//if(invoker.weaponstatus[PLPS_HEAT]>100)return;
		int battery=invoker.weaponstatus[PLPS_BATTERY];
		int fusion=invoker.weaponstatus[PLPS_FUSION];
		if(battery<1)
		{
			setweaponstate("nope");
			return;
		}
		
		A_ZoomRecoil(0.99);
		//A_StartSound("weapons/plasidle");
		if(!random(0,6))A_StartSound("weapon/plpistolcrackle", 12, volume: 0.3);
		double a0 = 0.0;
		if(countinv("IsMoving")>9)a0 = 0.7;
		if(invoker.weaponstatus[PLPS_CHARGE]>=50)a0 = a0+2.7;;
		A_MuzzleClimb(frandom(-0.3-a0,0.3+a0),frandom(-0.3-a0,0.3-a0));
		
		//the actual call
		HDPlasmaPistol.PlasmaPistolZap(
			self,
			gunheight(),
			invoker.weaponstatus[PLPS_CHARGE],
			invoker.weaponstatus[PLPS_CHARGE]*4,
			fusion
		);
		
		if(invoker.weaponstatus[PLPS_CHARGE]>=50)invoker.weaponstatus[PLPS_BATTERY]-=randompick(3,3,3,4,4);
		else
		{
			if(invoker.weaponstatus[PLPS_SHOTS] >= 3)
			{
				invoker.weaponstatus[PLPS_BATTERY]-=randompick(0,1,1,2,2,2);
				invoker.weaponstatus[PLPS_SHOTS]=0;
			}
			else invoker.weaponstatus[PLPS_SHOTS]++;
		}
		//if(invoker.weaponstatus[PLPS_HEAT]>=100)invoker.weaponstatus[PLPS_BATTERY]-=randompick(1,2,2,3);
		if(invoker.weaponstatus[PLPS_BATTERY]<0)
		{
			invoker.weaponstatus[PLPS_BATTERY]=0;
			A_StartSound("weapon/plpistolwoosh", 12);
		}
	}
	
	action void A_CheckPistolHand()
	{
		if(invoker.wronghand)player.getpsprite(PSP_WEAPON).sprite=getspriteindex("ZUS2A0");
	}
	
	double fuck;
	int fuck2;
	States
	{
	
	select0:
		ZUSG A 0{
			if(!countinv("NulledWeapon"))invoker.wronghand=false;
			A_TakeInventory("NulledWeapon");
			A_CheckPistolHand();
		}
		#### C 0 A_StopSound(CHAN_WEAPON);
		#### A 0 A_Overlay(-1000, "LightDone");
		#### C 1 A_Raise();
		#### C 1 A_Raise(30);
		#### B 1 A_Raise(30);
		#### B 1 A_Raise(24);
		#### A 1 A_Raise(18);
		wait;
	deselect0:
		ZUSG A 0 A_CheckPistolHand();
		#### C 0 A_StopSound(CHAN_WEAPON);
		#### A 0 A_Overlay(-1000, "LightDone");
		#### AAB 1 A_Lower();
		#### B 1 A_Lower(18);
		#### C 1 A_Lower(24);
		#### C 1 A_Lower(30);
		wait;
		
	Ready:
		ZUSG A 0 
		{
			A_CheckPistolHand();
			invoker.bNOAUTOFIRE = TRUE;
		}
		#### A 0 A_StopSound(CHAN_WEAPON);
		#### A 0 A_JumpIf(invoker.weaponstatus[PLPS_HEAT] > 100, "Overheat");
		#### A 0 {invoker.weaponstatus[PLPS_CHARGE]=0; invoker.bNOAUTOFIRE = FALSE;}
		#### A 1 A_WeaponReady(WRF_ALL|WRF_NOSECONDARY);
		goto readyend;
	user3:
		#### A 0 A_MagManager("HDBattery");
		goto ready;
		
	Fire:
		#### A 0 
		{
			if(invoker.weaponstatus[PLPS_BATTERY]<1)
			{
				setweaponstate("nope");
				return;
			}
			invoker.weaponstatus[PLPS_CHARGE] = 0;
			invoker.fuck = 0;
			invoker.fuck2 = 0;
			A_Overlay(1001, "LightDone");
			invoker.bNOAUTOFIRE = FALSE;
		}
	Charge:
		#### A 1
		{
			invoker.weaponstatus[PLPS_HEAT]++;
			
			if(invoker.weaponstatus[PLPS_CHARGE] >= 15 && invoker.fuck2 > 35 && invoker.weaponstatus[PLPS_HEAT] < 100) 
			{
				invoker.weaponstatus[PLPS_HEAT]++;
				invoker.fuck2 = 0;
			}
			else if(invoker.weaponstatus[PLPS_CHARGE] >= 15 && invoker.weaponstatus[PLPS_HEAT] < 100) invoker.fuck2++;
			
			if(invoker.weaponstatus[PLPS_CHARGE] <= 50)
			{
				invoker.weaponstatus[PLPS_CHARGE]++;
				invoker.fuck=invoker.weaponstatus[PLPS_CHARGE];
			}
			
			if(invoker.weaponstatus[PLPS_CHARGE] > 50)
				A_WeaponOffset(player.getpsprite(PSP_WEAPON).x+frandom(-3.0, 3.0), player.getpsprite(PSP_WEAPON).y+frandom(-3.0, 3.0));
			else if(invoker.weaponstatus[PLPS_CHARGE] > 40)
				A_WeaponOffset(player.getpsprite(PSP_WEAPON).x+frandom(-2.0, 2.0), player.getpsprite(PSP_WEAPON).y+frandom(-2.0, 2.0));
			else if(invoker.weaponstatus[PLPS_CHARGE] > 30)
				A_WeaponOffset(player.getpsprite(PSP_WEAPON).x+frandom(-1.0, 1.0), player.getpsprite(PSP_WEAPON).y+frandom(-1.0, 1.0));
			else if(invoker.weaponstatus[PLPS_CHARGE] == 15)
			{
				
				if(invoker.weaponstatus[PLPS_FUSION]==1) 
				{
					A_StartSound("weapon/plpistolcharge_marathon", CHAN_WEAPON);
					A_Overlay(1000, "beep");
				}
				else
				{
					A_Overlay(-1000, "FlashCharge");
					A_OverlayFlags(-1000, PSPF_RENDERSTYLE | PSPF_ALPHA, 1);
					A_OverlayAlpha(-1000, 0.9);
					A_OverlayRenderstyle(-1000, STYLE_Add);
					A_OverlayPivotAlign(-1000, PSPA_CENTER, PSPA_CENTER);
					A_StartSound("weapon/plpistolcharge", CHAN_WEAPON, CHANF_LOOPING);
				}
				//A_StartSound("weapon/plpistolcharge_marathon", CHAN_WEAPON);
			}
		}
		#### A 0 A_JumpIf((GetPlayerInput(MODINPUT_BUTTONS) & BT_ALTATTACK), "Altfire");
		#### A 0 A_Refire("Charge");
		#### A 0 A_StopSound(CHAN_WEAPON);
		#### A 0 A_Overlay(-1000, "LightDone");
		#### A 0 A_JumpIf(invoker.weaponstatus[PLPS_CHARGE] >= 50, "FireLarge");//A_StartSound("weapon/plpistolcharge", CHAN_WEAPON, CHANF_LOOPING);
		Goto FireSmall;
	FireSmall:
		#### A 2 Offset(0, 35)
		{
			//A_Overlay(1000, "Flash");
			A_GunFlash();
			A_OverlayFlags(1000, PSPF_RENDERSTYLE | PSPF_ALPHA, 1);
			A_OverlayAlpha(1000, 0.9);
			A_OverlayRenderstyle(1000, STYLE_Add);
