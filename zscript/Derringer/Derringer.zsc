class HDDerringer : PGHandgun
{
	default{
		+hdweapon.fitsinbackpack
		+hdweapon.reverseguninertia
		scale 0.42;
		weapon.selectionorder 50;
		weapon.slotnumber 2;
		weapon.slotpriority 2;
		weapon.kickback 30;
		weapon.bobrangex 0.1;
		weapon.bobrangey 0.6;
		weapon.bobspeed 2.5;
		weapon.bobstyle "normal";
		obituary "$OB_PISTOL";
		inventory.pickupmessage "$PEPPER_PICKUP_DERRINGER";
		tag "$PEPPER_TAG_DERRINGER";
		hdweapon.refid "4dr";
		hdweapon.barrelsize 8,0.3,0.6;

		hdweapon.ammo1 "FourMilAmmo",1;

//		hdweapon.loadoutcodes "";
	}
	override double weaponbulk(){
		int chm=weaponstatus[DERS_CHAMBERS];
		return 12+(chm==3?ENC_426_LOADED*2:(chm>0?ENC_426_LOADED:0));
	}
	override double gunmass(){
		int chm=weaponstatus[DERS_CHAMBERS];
		return 1.2+(chm==3?0.02:(chm>0?0.01:0));
	}
	override void failedpickupunload(){
		int chb=weaponstatus[DERS_CHAMBERS];
		int derch=(chb==3?2:(chb>0?1:0));
		A_DropItem("FourMilAmmo",derch);
	}
	override string,double getpickupsprite(){return "DRNPA0",1.;}
	override void DrawHUDStuff(HDStatusBar sb,HDWeapon hdw,HDPlayerPawn hpl){
		if(sb.hudlevel==1){
			sb.drawimage("RCLSA3A7",(-47,-10),sb.DI_SCREEN_CENTER_BOTTOM,scale:(2.1,2.55));
			sb.drawnum(hpl.countinv("FourMilAmmo"),-43,-8,sb.DI_SCREEN_CENTER_BOTTOM);
			
			int chm=hdw.weaponstatus[DERS_CHAMBERS];
			if(chm==3||chm==1)sb.drawrect(-18,-10,3,3); //Left side, ch1
			if(chm==3||chm==2)sb.drawrect(-26,-10,3,3); //Right side, ch2
		}
	}
	override string gethelptext(){
		LocalizeHelp();
		return
		LWPHELP_FIRESHOOT
		..LWPHELP_ALTRELOAD..StringTable.Localize("$PISWH_ALTRELOAD")
		..LWPHELP_RELOAD.."  Reload Loose 4mm\n"
		..LWPHELP_UNLOAD.."  Break & Purge rounds\n"
		;
	}
	override void DrawSightPicture(
		HDStatusBar sb,HDWeapon hdw,HDPlayerPawn hpl,
		bool sightbob,vector2 bob,double fov,bool scopeview,actor hpc
	){
		int cx,cy,cw,ch;
		[cx,cy,cw,ch]=screen.GetClipRect();
		vector2 scc;
		vector2 bobb=bob*1.3;

		//if slide is pushed back, throw sights off line
		if(hpl.player.getpsprite(PSP_WEAPON).frame>=2){
			sb.SetClipRect(
				-10+bob.x,-10+bob.y,20,19,
				sb.DI_SCREEN_CENTER
			);
			bobb.y-=2;
			scc=(0.7,0.8);
		}else{
			sb.SetClipRect(
				-8+bob.x,-9+bob.y,16,15,
				sb.DI_SCREEN_CENTER
			);
			scc=(0.6,0.6);
		}
		sb.drawimage(
			"frntsite",(0,0)+bobb,sb.DI_SCREEN_CENTER|sb.DI_ITEM_TOP,
			scale:scc
		);
		sb.SetClipRect(cx,cy,cw,ch);
		sb.drawimage(
			"backsite",(0,0)+bob,sb.DI_SCREEN_CENTER|sb.DI_ITEM_TOP,
			alpha:0.9,
			scale:scc
		);
	}
	override void DropOneAmmo(int amt){
		if(owner){
			amt=clamp(amt,1,10); //Check later
			if(owner.countinv("FourMilAmmo"))owner.A_DropInventory("FourMilAmmo",amt*2);
		}
	}
	override void ForceBasicAmmo(){
		owner.A_TakeInventory("HDPistolAmmo");
		ForceOneBasicAmmo("HD9mMag15");
	}
	action void A_CheckPistolHand(){
		if(invoker.wronghand)player.getpsprite(PSP_WEAPON).sprite=getspriteindex("ZD2GA0");
	}
	states{
	select0:
		ZD1G A 0{
			if(!countinv("NulledWeapon"))invoker.wronghand=false;
			A_TakeInventory("NulledWeapon");
			A_CheckPistolHand();
		}
		#### A 0 A_JumpIf(invoker.weaponstatus[PISS_CHAMBER]>0,2);
		#### C 0;
		---- A 1 A_Raise();
		---- A 1 A_Raise(30);
		---- A 1 A_Raise(30);
		---- A 1 A_Raise(24);
		---- A 1 A_Raise(18);
		wait;
	deselect0:
		ZD1G A 0 A_CheckPistolHand();
		#### A 0 A_JumpIf(invoker.weaponstatus[PISS_CHAMBER]>0,2);
		#### C 0;
		---- AAA 1 A_Lower();
		---- A 1 A_Lower(18);
		---- A 1 A_Lower(24);
		---- A 1 A_Lower(30);
		wait;

	ready:
		ZD1G A 0 A_CheckPistolHand();
		#### A 0 A_JumpIf(invoker.weaponstatus[PISS_CHAMBER]>0,2);
		#### C 0;
		#### # 0 A_SetCrosshair(21);
		#### # 1 A_WeaponReady(WRF_ALL);
		goto readyend;
	user3:
		---- A 0 A_MagManager("HD4mMag");
		goto ready;
	althold:
	hold:
		goto nope;
	fire:
		---- A 0{
			invoker.weaponstatus[0]&=~DERF_UNLOAD;
			if(invoker.weaponstatus[DERS_CHAMBERS])setweaponstate("shoot");
		}goto nope;
	shoot:
		#### B 1{
			if(invoker.weaponstatus[DERS_CHAMBERS]>0)A_GunFlash();
		}
		#### C 1{
			bool gb=gunbraced();
			hdplayerpawn(self).gunbraced=false;
			double recoilside=randompick(-1,1);
			double pushforce=frandom(5,8)*player.crouchfactor;
			if(
				gb
				&&player.onground
				&&pressingzoom()
			){
				A_MuzzleClimb(
					recoilside*2,-4.,
					recoilside*1,-2.,
					recoilside*0.4,-1.,
					recoilside*0.2,-0.4,
					wepdot:true
				);
			}else{
				pushforce*=frandom(0.2,0.3);
				A_MuzzleClimb(
					recoilside*5,-frandom(5.,8.),
					recoilside*4,-frandom(3.,6.),
					recoilside*3,-frandom(2.,4.),
					recoilside*2,-frandom(1.,2.),
					wepdot:true
				);
			}
/*			A_MuzzleClimb( //CRANK THAT SHIT
				-frandom(0.8,1.),-frandom(1.2,1.6),
				frandom(0.4,0.5),frandom(0.6,0.8)
			);
*/		}
		#### C 0{
			if(invoker.weaponstatus[DERS_CHAMBERS]>=0){
				A_StartSound("weapons/pistoldry",8,CHANF_OVERLAP,0.9);
				setweaponstate("nope");
			}
		}
		#### B 1{
			A_WeaponReady(WRF_NOFIRE);
			
			invoker.weaponstatus[DERS_CHAMBERS]==0;
		}goto ready;
	flash:
		ZD2F A 0 A_JumpIf(invoker.wronghand,2);
		ZD1F A 0;
		---- A 1 bright{
			HDFlashAlpha(64);
			A_Light1();
			int chm=invoker.weaponstatus[DERS_CHAMBERS];
			int amt=(chm==3?2:(chm>0?1:0));
			let bbb=HDBulletActor.FireBullet(self,"HDB_426",spread:2.,speedfactor:frandom(0.97,1.03),amount:amt);
			if(
				frandom(0,ceilingz-floorz)<bbb.speed*0.3
			)A_AlertMonsters(256);
			invoker.weaponstatus[DERS_CHAMBERS]=0;

			A_ZoomRecoil(0.995);
			A_MuzzleClimb(-frandom(0.4,1.2),-frandom(0.4,1.6));
		}
		---- A 0 A_StartSound("weapons/pistol",CHAN_WEAPON);
		---- A 0 A_Light0();
		stop;
	unload:
		---- A 0{invoker.weaponstatus[0]|=DERF_UNLOAD;}
	reload:
		---- A 0 A_JumpIf(
			!(invoker.weaponstatus[0]&DERF_UNLOAD)
			&&(
				invoker.weaponstatus[DERS_CHAMBERS]==3
				||!(countinv("FourMilAmmo"))
			)
			,"nope"
		);
		#### B 3 offset(0,34);
		#### B 3 offset(1,39);
		#### B 2 offset(3,46);
		#### B 1 offset(6,54){
			if(invoker.weaponstatus[0]&DERF_UNLOAD){
				A_StartSound("weapons/bigcrack",8,CHANF_OVERLAP);
				A_SpawnItemEx(
					"WallChunk",
					12,0,height-12,	 
					4,frandom(-2,2),frandom(.4,1),
					0,SXF_TRANSFERPITCH
				);
				A_SpawnItemEx(
					"WallChunk",
					12,0,height-12,	 
					4,frandom(-2,2),frandom(.4,1),
					0,SXF_TRANSFERPITCH
				);
				invoker.weaponstatus[DERS_CHAMBERS] = 0;
			}
			else if(random(1,8)<=1){
				A_TakeInventory("FourMilAmmo",1);
				A_StartSound("weapons/bigcrack",8,CHANF_OVERLAP);
				A_SpawnItemEx("HDSmokeChunk",12,0,height-12,4,frandom(-2,2),frandom(2,4));
				damagemobj(invoker,self,1,"hot",DMG_NO_ARMOR);
//				breakchance=min(breakchance+25,80);
				setweaponstate("reloadend");
			}
		}
		#### C 1 offset(0,39){
			A_MuzzleClimb(frandom(0.4,0.5),-frandom(0.6,0.8));
			A_StartSound("weapons/pischamber2",8,CHANF_OVERLAP);
			int chb=invoker.weaponstatus[DERS_CHAMBERS];
			
			if(invoker.weaponstatus[0]&DERF_UNLOAD){
				if(chb==3){
					//give 2
				}
				if(chb<3&&chb>0){
					//give 1
				}
			}else{
				if(chb==0){
					invoker.weaponstatus[DERS_CHAMBERS]=1;
					A_TakeInventory("FourMilAmmo",1);
				}else if(chb<3){
					invoker.weaponstatus[DERS_CHAMBERS]=3;
					A_TakeInventory("FourMilAmmo",1);
				}
			}
		}
	reloadend:
/*		---- B 3 offset(0,35);
		---- A 2 offset(3,46);
		---- A 1 offset(2,42);
		---- A 1 offset(2,38);
		---- A 1 offset(1,34);
*/		goto nope;

	user1:
	altreload:
	swappistols:
		---- A 0 A_SwapHandguns();
		---- A 0{
			bool id=(Wads.CheckNumForName("id",0)!=-1);
			bool offhand=invoker.wronghand;
			bool lefthanded=(id!=offhand);
			if(lefthanded){
				A_Overlay(1025,"raiseleft");
				A_Overlay(1026,"lowerright");
			}else{
				A_Overlay(1025,"raiseright");
				A_Overlay(1026,"lowerleft");
			}
		}
		TNT1 A 5;
		ZD1G A 0 A_CheckPistolHand();
		goto nope;
	lowerleft:
		ZD1G A 0 A_JumpIf(Wads.CheckNumForName("id",0)!=-1,2);
		ZD2G A 0;
		#### A 1 offset(-6,38);
		#### A 1 offset(-12,48);
		#### A 1 offset(-20,60);
		#### A 1 offset(-34,76);
		#### A 1 offset(-50,86);
		stop;
	lowerright:
		ZD2G A 0 A_JumpIf(Wads.CheckNumForName("id",0)!=-1,2);
		ZD1G A 0;
		#### A 1 offset(6,38);
		#### A 1 offset(12,48);
		#### A 1 offset(20,60);
		#### A 1 offset(34,76);
		#### A 1 offset(50,86);
		stop;
	raiseleft:
		ZD1G A 0 A_JumpIf(Wads.CheckNumForName("id",0)!=-1,2);
		ZD2G A 0;
		#### A 1 offset(-50,86);
		#### A 1 offset(-34,76);
		#### A 1 offset(-20,60);
		#### A 1 offset(-12,48);
		#### A 1 offset(-6,38);
		stop;
	raiseright:
		ZD2G A 0 A_JumpIf(Wads.CheckNumForName("id",0)!=-1,2);
		ZD1G A 0;
		#### A 1 offset(50,86);
		#### A 1 offset(34,76);
		#### A 1 offset(20,60);
		#### A 1 offset(12,48);
		#### A 1 offset(6,38);
		stop;
	whyareyousmiling:
		#### A 1 offset(0,48);
		#### A 1 offset(0,60);
		#### A 1 offset(0,76);
		TNT1 A 7;
		ZD1G A 0{
			invoker.wronghand=!invoker.wronghand;
			A_CheckPistolHand();
		}
		#### A 1 offset(0,76);
		#### A 1 offset(0,60);
		#### A 1 offset(0,48);
		goto nope;


	spawn:
		DNGP A -1 nodelay{
			if(invoker.weaponstatus[DERS_CHAMBERS]==0){
				brollsprite=true;brollcenter=true;
				roll=randompick(1,2,3)*90;
			}
		}
		stop;
	}
	override void initializewepstats(bool idfa){
		weaponstatus[DERS_CHAMBERS]=3;
	}
}
enum derrstatus{
	DERF_UNLOAD=1,
	DERF_COCKED=2,
	
	DERS_CHAMBERS=1,	//0 unloaded, 1 OX , 2 X0 , 3 OO
};