const ENC_355MAG_EMPTY=(ENC_9MAG_EMPTY*0.8);

class HD355mag:HDMagAmmo{
	default{
		hdmagammo.maxperunit 12;
		hdmagammo.roundtype "HDRevolverAmmo";
		hdmagammo.roundbulk ENC_355;
		hdmagammo.magbulk ENC_355MAG_EMPTY;
		hdpickup.refid "312";
		tag "$PEPPER_TAG_355MAG";
		inventory.pickupmessage "$PEPPER_PICKUP_355MAG";
		scale 0.46;
		inventory.maxamount 1000;
	}
	override string,string,name,double getmagsprite(int thismagamt){
		string magsprite;
		switch(thismagamt){
			case 0: magsprite = "3MAGA0"; break;
			case 1: magsprite = "3MAGB0"; break;
			case 2: magsprite = "3MAGC0"; break;
			case 3: case 4: magsprite = "3MAGD0"; break;
			case 5: case 6: magsprite = "3MAGE0"; break;
			case 7: case 8: magsprite = "3MAGF0"; break;
			case 9: case 10: magsprite = "3MAGG0"; break;
			case 11: case 12: magsprite = "3MAGH0"; break;
			default: magsprite = "3MAGA0"; break;
		}
		return magsprite,"PBRSA0","HDRevolverAmmo",0.8;
	}
	override void GetItemsThatUseThis(){
		itemsthatusethis.push("HDHelzing");
	}
	states(actor){
	spawn:
		3MAG ABCDEFGH -1 nodelay{
			if(!mags.size()){destroy();return;}
			int amt=mags[0];
			switch(amt){
				case 1: frame=1; break;
				case 2: frame=2; break;
				case 3: case 4: frame=3; break;
				case 5: case 6: frame=4; break;
				case 7: case 8: frame=5; break;
				case 9: case 10: frame=6; break;
				case 11: case 12: frame=7; break;
				default: frame=8; break;
			}
			//console.printf("amt: "..amt);
		}
		stop;
	spawnempty:
		3MAG A -1{
			brollsprite=true;brollcenter=true;
			roll=randompick(1,1,1,1,3,3,3,3,0,2)*90;
		}stop;
	}
}

class HD355EmptyMag:IdleDummy{
	override void postbeginplay(){
		super.postbeginplay();
		HDMagAmmo.SpawnMag(self,"HD355mag",0);
		destroy();
	}
}

class HDB_355HOLY:HDBulletActor{
	default{
		pushfactor 0.3;
		mass 99;
		speed 1600;
		accuracy 240;
		stamina 900;
		woundhealth 500;
		hdbulletactor.hardness 3;
	}
	override actor Puff(){
		if(max(abs(pos.x),abs(pos.y))>=32768)return null;
		setorigin(pos-(2*(cos(angle),sin(angle)),0),false);
		A_SprayDecal("HelzingScorch",16);
		if(vel==(0,0,0))A_ChangeVelocity(cos(pitch),0,-sin(pitch),CVF_RELATIVE|CVF_REPLACE);
		else vel*=0.01;

		A_HDBlast(
			blastradius:24,blastdamagetype:"Holy",
			immolateradius:128,immolateamount:96,immolatechance:96,
			source:target
		);
		DistantQuaker.Quake(self,3,35,256,12);
		doordestroyer.destroydoor(self,frandom(1,frandom(32,80)),frandom(1,frandom(16,48)));
		actor aaa=Spawn("HolyXpl",pos,ALLOW_REPLACE);
			  aaa=Spawn("SmallChunker",pos,ALLOW_REPLACE);
		bmissile=false;
		if(!instatesequence(curstate,findstate("death")))setstatelabel("death");
		return null;
	} 
	override void onhitactor(actor hitactor,vector3 hitpos,vector3 vu,int flags){
		double impact=(speed*speed*0.000001)*0.1*mass;
		double spbak=speed;
		let hdmb=hdmobbase(hitactor);
		let shields=HDMagicShield(hitactor.findinventory("HDMagicShield"));
		super.onhitactor(hitactor,hitpos,vu,flags);
		if(spbak-speed>10)puff();
		if(hd_debug)console.printf(hitactor.getclassname().." resisted, impact:  "..impact);
		hitactor.damagemobj(self,target,1,"holy",DMG_FORCED);
		actor aaa=Spawn("HolyXpl",pos,ALLOW_REPLACE);
		if(hdmb&&shields&&shields.amount>1)shields.amount-=2000;
		A_HDBlast(
			blastradius:64,blastdamagetype:"Holy",
			immolateradius:24,immolateamount:96,immolatechance:96,
			source:target
		);
	}
}

class HolyXpl:HDExplosion{
	states{
	spawn:
	death:
		HLXP B 0 nodelay{
			if(max(abs(pos.x),abs(pos.y),abs(pos.z))>=32768){destroy();return;}
			vel.z+=4;
			A_StartSound(deathsound,CHAN_BODY);
			let xxx=spawn("HDExplosionLight",pos);
			xxx.target=self;
		}
		HLXP BB 0 A_SpawnItemEx("ParticleWhiteSmall", 0,0,0, vel.x+random(-2,2),vel.y+random(-2,2),vel.z,0,SXF_ABSOLUTEMOMENTUM|SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS);
		HLXP BBBB 0 A_SpawnItemEx("HDSmoke", 0,0,0, vel.x+frandom(-2,2),vel.y+frandom(-2,2),vel.z,0,SXF_ABSOLUTEMOMENTUM|SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS);
		HLXP B 0 A_Jump(256,"fade");
	fade:
		HLXP B 1 A_FadeOut(0.1);
		HLXP C 1 A_FadeOut(0.2);
		HLXP DD 1 A_FadeOut(0.2);
		TNT1 A 20;
		stop;
	}
}
class SmallChunker:WallChunker{
	states{
	spawn:
		TNT1 AAAAAAAAAA 0 A_SpawnItemEx("HugeWallChunk",0,0,4,frandom(6,12),0,frandom(-3,12)*chunkdir,frandom(0,360),SXF_NOCHECKPOSITION);
		TNT1 AAAAAAAAAAAAAAA 0 A_SpawnItemEx("BigWallChunk",0,0,4,frandom(7,18),0,frandom(-3,14)*chunkdir,frandom(0,360),SXF_NOCHECKPOSITION);
		TNT1 AA 0 A_SpawnItemEx ("HDSmoke",-1,0,1,frandom(-2,2),0,0,frandom(0,360),SXF_NOCHECKPOSITION);
		stop;
	}
}
class SmallestChunker:WallChunker{
	states{
	spawn:
		TNT1 AA 0 A_SpawnItemEx("HugeWallChunk",0,0,4,frandom(6,12),0,frandom(-3,12)*chunkdir,frandom(0,360),SXF_NOCHECKPOSITION);
		TNT1 AAAAA 0 A_SpawnItemEx("BigWallChunk",0,0,4,frandom(7,18),0,frandom(-3,14)*chunkdir,frandom(0,360),SXF_NOCHECKPOSITION);
		TNT1 A 0 A_SpawnItemEx ("HDSmoke",-1,0,1,frandom(-2,2),0,0,frandom(0,360),SXF_NOCHECKPOSITION);
		stop;
	}
}
