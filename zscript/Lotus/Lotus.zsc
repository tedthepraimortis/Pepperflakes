class HDLotus:PGHandgun{
	bool cylinderopen;
	default{
		+hdweapon.fitsinbackpack
		scale 0.5;
		weapon.selectionorder 776;
		weapon.slotnumber 8;
		weapon.slotpriority 3;
		weapon.kickback 30;
		weapon.bobrangex 0.2;
		weapon.bobrangey 0.8;
		weapon.bobspeed 2.5;
		PGHandgun.CustomPickupMsg true;
		weapon.bobstyle "normal";
		obituary "$PEPPER_OBITUARY_LOTUS";
		tag "$PEPPER_TAG_LOTUS";
		hdweapon.refid "l7c";
		hdweapon.barrelsize 20,1,2;
	
	hdweapon.loadoutcodes "
			\cusa - 0/1, Single Action Trigger
			\cuscope - 0/1, Boss-Replica Midrange Scope
			\cubarrel - 0/1, Full-Length Rifle Barrel
			\cusuppressor - 0/1, Tsuchinoko Dual-Purpose Suppressor
			\cubulletdrop - 0-600, amount of compensation for bullet drop
			\cuzoom - 18-50, 10x the resulting FOV in degrees";
	}
	override double gunmass(){
		double brl=weaponstatus[LOTS_BARREL]==1;
		double qui=weaponstatus[LOTS_BARREL]==2;
		double sco=weaponstatus[0]&LOTF_SCOPE;
		return 12+(brl?4:0)+(qui?2:0)+(sco?1:0);
	}
	override double weaponbulk(){
		double blk=0;
		double brl=weaponstatus[LOTS_BARREL]==1;
		double qui=weaponstatus[LOTS_BARREL]==2;
		double sco=weaponstatus[0]&LOTF_SCOPE;
		for(int i=LOTS_CYL1;i<=LOTS_CYL6;i++){
			int wi=weaponstatus[i];
			if(wi==LOTS_RIFLERND)blk+=ENC_776_LOADED;
		}
		return 75+blk+(brl?25:0)+(qui?25:0)+(sco?15:0);
	}
	override string,double getpickupsprite(){
		string spr;
		int brl=weaponstatus[LOTS_BARREL];
		if(weaponstatus[0]&LOTF_SCOPE){
			if(brl==0)spr="B";
			if(brl==1)spr="D";
			if(brl==2)spr="F";
		}else{
			if(brl==0)spr="A";
			if(brl==1)spr="C";
			if(brl==2)spr="E";
		}return "RRVL"..spr.."0",1.;
	}
	override string pickupmessage(){
		string msg=Stringtable.Localize("$PEPPER_PICKUP_LOTUS_NORMAL");
		if(weaponstatus[0]&LOTF_PETUNIA)msg=Stringtable.Localize("$PEPPER_PICKUP_SWEET_PETUNIA");
		if(weaponstatus[0]&LOTF_SCOPE){
			if(weaponstatus[LOTS_BARREL]==2)msg=msg..Stringtable.Localize("$PEPPER_PICKUP_LOTUS_SCOPE_SUPPRESSOR");
			if(weaponstatus[LOTS_BARREL]==1)msg=msg..Stringtable.Localize("$PEPPER_PICKUP_LOTUS_SCOPE_BARREL");
			if(weaponstatus[LOTS_BARREL]==0)msg=msg..Stringtable.Localize("$PEPPER_PICKUP_LOTUS_SCOPE");
		}
		else{
			if(weaponstatus[LOTS_BARREL]==2)msg=msg..Stringtable.Localize("$PEPPER_PICKUP_LOTUS_SUPPRESSOR");
			if(weaponstatus[LOTS_BARREL]==1)msg=msg..Stringtable.Localize("$PEPPER_PICKUP_LOTUS_BARREL");
		}
		return msg;
	}
		override void postbeginplay(){
		super.postbeginplay();
		weaponspecial=1337;
		if(weaponstatus[LOTS_BARREL]==1){	//Full-Barrel
			barrellength=32;
			bfitsinbackpack=false;
			bobrangex*=4.05;
			bobrangey*=2.1;
			bobspeed*=0.50;
		}if(weaponstatus[LOTS_BARREL]==2){	//Suppressor
			barrellength=28;
			barrelwidth=3;
			bobrangex*=1.44;
			bobrangey*=1.8;
			bobspeed*=0.66;
//			bfitsinbackpack=false;		//Maybe?
		}
	}

	override void DrawHUDStuff(HDStatusBar sb,HDWeapon hdw,HDPlayerPawn hpl){
		if(sb.hudlevel==1){
			sb.drawimage("TEN7A0",(-47,-10),sb.DI_SCREEN_CENTER_BOTTOM,scale:(1.6,1.6));
			sb.drawnum(hpl.countinv("SevenMilAmmo"),-44,-8,sb.DI_SCREEN_CENTER_BOTTOM);
		}
		if(
			sb.hudlevel==1
			&&hpl.countinv("SevenMilAmmoRecast")
			){
			sb.drawimage("TEN7A0",(-69,-10),sb.DI_SCREEN_CENTER_BOTTOM,scale:(1.6,1.6));
			sb.drawnum(hpl.countinv("SevenMilAmmoRecast"),-66,-8,sb.DI_SCREEN_CENTER_BOTTOM);
		}
		int plf=hpl.player.getpsprite(PSP_WEAPON).frame;
		for(int i=LOTS_CYL1;i<=LOTS_CYL6;i++){
			double drawangle=i*(360./6.)-150;
			vector2 cylpos;
			if(plf==4){
				drawangle-=45.;
				cylpos=(-30,-14);
			}else if(cylinderopen){
				drawangle-=90;
				cylpos=(-34,-12);
			}else{
				cylpos=(-22,-20);
			}
			double cdrngl=cos(drawangle);
			double sdrngl=sin(drawangle);
			if(
				!cylinderopen
				&&sb.hud_aspectscale.getbool()
			){
				cdrngl*=1.1;
				sdrngl*=(1./1.1);
			}
			vector2 drawpos=cylpos+(cdrngl,sdrngl)*5;
			sb.fill(
				hdw.weaponstatus[i]>0?
				color(255,240,230,40)
				:color(200,30,26,24),
				drawpos.x,
				drawpos.y,
				3,3,
				sb.DI_SCREEN_CENTER_BOTTOM|sb.DI_ITEM_RIGHT
			);
		}
		if(hdw.weaponstatus[0]&LOTF_SCOPE){
			sb.drawstring(
				sb.mAmountFont,string.format("%.1f",hdw.weaponstatus[LOTS_ZOOM]*0.1),
				(-16,-8),sb.DI_SCREEN_CENTER_BOTTOM|sb.DI_TEXT_ALIGN_RIGHT,Font.CR_DARKGRAY
			);
		}
/*		sb.drawstring(
			sb.mAmountFont,string.format("%.1f",hdw.weaponstatus[LOTS_DROPADJUST]*0.1),
			(-16,-18),sb.DI_SCREEN_CENTER_BOTTOM|sb.DI_TEXT_ALIGN_RIGHT,Font.CR_WHITE
		);
*/	}
	override string gethelptext(){
		if(cylinderopen)return
		LWPHELP_FIRE.." Close cylinder\n"
		..LWPHELP_ALTFIRE.." Cycle cylinder \(Hold "..LWPHELP_ZOOM.." to reverse\)\n"
		..LWPHELP_UNLOAD.." Hit extractor \(double-tap to dump live rounds\)\n"
		..LWPHELP_RELOAD.." Load round \(Hold "..LWPHELP_FIREMODE.." to force using Recasts\)\n"
		;
		return
		LWPHELP_FIRESHOOT
		..LWPHELP_ALTFIRE.." Pull back hammer\n"
		..LWPHELP_UNLOAD.."/"..LWPHELP_RELOAD.." Open cylinder\n"
		..(weaponstatus[0]&LOTF_SCOPE?LWPHELP_ZOOM.." + "..LWPHELP_FIREMODE.." Adjust Zoom\n":"")..
		((weaponstatus[LOTS_BARREL]>0||weaponstatus[0]&LOTF_SCOPE)?
		"\nInstalled Upgrades: ":"")
		..(weaponstatus[0]&LOTF_SA?"\n- Single-Action Trigger":"")
		..(weaponstatus[0]&LOTF_PETUNIA?"\n- BhE Custom All-Range Huntmaster Scope \n- Strange Illegible Markings":"")
		..((weaponstatus[0]&LOTF_SCOPE&&!weaponstatus[0]&LOTF_PETUNIA)?"\n- BhE Huntmaster Scope":"")
		..(weaponstatus[LOTS_BARREL]==1?"\n- Extended Barrel w/ Foregrip":"")
		..(weaponstatus[LOTS_BARREL]==2?"\n- Tsuchinoko Dual-Purpose Silencer":"")
		;
	}
	override void DrawSightPicture(
		HDStatusBar sb,HDWeapon hdw,HDPlayerPawn hpl,
		bool sightbob,vector2 bob,double fov,bool scopeview,actor hpc,string whichdot
	){
		int cx,cy,cw,ch;
		[cx,cy,cw,ch]=screen.GetClipRect();
		vector2 scc;
		vector2 bobb=bob*1.3;

		sb.SetClipRect(
			-8+bob.x,-4+bob.y,16,10,
			sb.DI_SCREEN_CENTER
		);
		scc=(0.9,0.9);

		sb.drawimage(
			"lotuftst",(0,0)+bobb,sb.DI_SCREEN_CENTER|sb.DI_ITEM_TOP,
			alpha:0.9,scale:scc
		);
		sb.SetClipRect(cx,cy,cw,ch);
		sb.drawimage(
			"lotubkst",(0,0)+bob,sb.DI_SCREEN_CENTER|sb.DI_ITEM_TOP,
			scale:scc
		);
		if(scopeview&&hdw.weaponstatus[0]&LOTF_SCOPE&&!cylinderopen){
			int scaledyoffset=60;
			int scaledwidth=89;
			vector2 sclhalf=(0.5,0.5);
			double degree=0.1*hdw.weaponstatus[LOTS_ZOOM];
			double deg=1/degree;
			int cx,cy,cw,ch;
			[cx,cy,cw,ch]=screen.GetClipRect();
			sb.SetClipRect(-44+bob.x,16+bob.y,scaledwidth,scaledwidth,
				sb.DI_SCREEN_CENTER);
            sb.fill(color(255,0,0,0),
					bob.x-44,scaledyoffset+bob.y-44,
					88,88,sb.DI_SCREEN_CENTER|sb.DI_ITEM_CENTER
				);

            texman.setcameratotexture(hpc,"HDXCAM_BOSS",degree);
            let cam     = texman.CheckForTexture("HDXCAM_BOSS",TexMan.Type_Any);
            let reticle = texman.CheckForTexture("bossret1",TexMan.Type_Any);

            vector2 frontoffs=(0,scaledyoffset)+bob*3;

            double camSize  = texman.GetSize(cam);
            sb.DrawCircle(cam, frontoffs, 0.125,usePixelRatio:true);

            let reticleScale = camSize / texman.GetSize(reticle);
           
            sb.DrawCircle(reticle, (0,scaledyoffset)+bob, .5*reticleScale,uvScale:.5);
				

				//let holeScale    = camSize / texman.GetSize(hole);
				//let hole    = texman.CheckForTexture("scophole",TexMan.Type_Any);
				//sb.DrawCircle(hole, (0, scaledyoffset) + bob, .5 * holeScale, bob * 5, 1.5);
			
			screen.SetClipRect(cx,cy,cw,ch);

			sb.drawimage(
				"libscope",(0,scaledyoffset)+bob,sb.DI_SCREEN_CENTER|sb.DI_ITEM_CENTER,
				scale:(1.24,1.24)
			);
			sb.drawstring(
				sb.mAmountFont,string.format("%.1f",degree),
				(6+bob.x,105+bob.y),sb.DI_SCREEN_CENTER|sb.DI_TEXT_ALIGN_RIGHT,
				Font.CR_BLACK
			);
            sb.drawstring(
				sb.mAmountFont,string.format("%i",hdw.weaponstatus[LOTS_DROPADJUST]),
				(6+bob.x,9+bob.y),sb.DI_SCREEN_CENTER|sb.DI_TEXT_ALIGN_RIGHT,
				Font.CR_BLACK
			);
		}
    }
	override void DropOneAmmo(int amt){
		if(owner){
			amt=clamp(amt,18,60);
			if(owner.countinv("SevenMilAmmo"))owner.A_DropInventory("SevenMilAmmo",amt);
		}
	}
	override void ForceBasicAmmo(){
		owner.A_SetInventory("SevenMilAmmo",6);
	}
	override void initializewepstats(bool idfa){
		weaponstatus[LOTS_CYL1]=LOTS_RIFLERND;
		weaponstatus[LOTS_CYL2]=LOTS_RIFLERND;
		weaponstatus[LOTS_CYL3]=LOTS_RIFLERND;
		weaponstatus[LOTS_CYL4]=LOTS_RIFLERND;
		weaponstatus[LOTS_CYL5]=LOTS_RIFLERND;
		weaponstatus[LOTS_CYL6]=LOTS_RIFLERND;
		
		weaponstatus[LOTS_ZOOM]=24;
        weaponstatus[LOTS_DROPADJUST]=160;
		if(!(weaponstatus[LOTS_BARREL]>0))weaponstatus[LOTS_BARREL]=0;
	}
	action void A_RotateCylinder(bool clockwise=true){
		invoker.RotateCylinder(clockwise);
		A_StartSound("weapons/lotuscyl",8);
	}
	void RotateCylinder(bool clockwise=true){
		if(clockwise){
			int cylbak=weaponstatus[LOTS_CYL1];
			weaponstatus[LOTS_CYL1]=weaponstatus[LOTS_CYL6];
			weaponstatus[LOTS_CYL6]=weaponstatus[LOTS_CYL5];
			weaponstatus[LOTS_CYL5]=weaponstatus[LOTS_CYL4];
			weaponstatus[LOTS_CYL4]=weaponstatus[LOTS_CYL3];
			weaponstatus[LOTS_CYL3]=weaponstatus[LOTS_CYL2];
			weaponstatus[LOTS_CYL2]=cylbak;
		}else{
			int cylbak=weaponstatus[LOTS_CYL1];
			weaponstatus[LOTS_CYL1]=weaponstatus[LOTS_CYL2];
			weaponstatus[LOTS_CYL2]=weaponstatus[LOTS_CYL3];
			weaponstatus[LOTS_CYL3]=weaponstatus[LOTS_CYL4];
			weaponstatus[LOTS_CYL4]=weaponstatus[LOTS_CYL5];
			weaponstatus[LOTS_CYL5]=weaponstatus[LOTS_CYL6];
			weaponstatus[LOTS_CYL6]=cylbak;
		}
	}
	action void A_LoadRound(){
		if(invoker.weaponstatus[LOTS_CYL1]>0)return;
		bool userecast=(
			player.cmd.buttons&BT_FIREMODE
			||!countinv("SevenMilAmmo")
		);
		if(userecast&&!countinv("SevenMilAmmoRecast"))return;
		class<inventory>ammotype=userecast?"SevenMilAmmoRecast":"SevenMilAmmo";
		A_TakeInventory(ammotype,1,TIF_NOTAKEINFINITE);
		invoker.weaponstatus[LOTS_CYL1]=userecast?LOTS_RECASTRND:LOTS_RIFLERND;
		A_StartSound("weapons/lotusload",8,CHANF_OVERLAP);
	}
	action void A_OpenCylinder(){
		A_StartSound("weapons/lotusopen",8);
		invoker.weaponstatus[0]&=~LOTF_COCKED;
		invoker.cylinderopen=true;
		A_SetHelpText();
	}
	action void A_CloseCylinder(){
		A_StartSound("weapons/lotusclose",8);
		invoker.cylinderopen=false;
		A_SetHelpText();
	}
	action void A_HitExtractor(){
		double cosp=cos(pitch);
		for(int i=LOTS_CYL1;i<=LOTS_CYL6;i++){
			int thischamber=invoker.weaponstatus[i];
			if(thischamber<1)continue;
			if(thischamber==LOTS_RIFLERNDSPENT){
				actor aaa=spawn(
					"HDSpent7mm",
					(pos.xy,pos.z+height-10)
					+(cosp*cos(angle),cosp*sin(angle),sin(pitch))*7,
					ALLOW_REPLACE
				);
				aaa.vel=vel+(frandom(-1,1),frandom(-1,1),-1);
				invoker.weaponstatus[i]=0;
			}
		}
		A_StartSound("weapons/lotuseject",8,CHANF_OVERLAP);
	}
	action void A_ExtractAll(){
		double cosp=cos(pitch);
		bool gotany=false;
		for(int i=BUGS_CYL1;i<=BUGS_CYL6;i++){
			int thischamber=invoker.weaponstatus[i];
			if(thischamber<1)continue;
			if(thischamber==LOTS_RIFLERNDSPENT)
			{
				actor aaa=spawn("HDSpent7mm",
					(pos.xy,pos.z+height-14)
					+(cosp*cos(angle),cosp*sin(angle),sin(pitch)-2)*3,
					ALLOW_REPLACE
				);
				aaa.vel=vel+(frandom(-0.3,0.3),frandom(-0.3,0.3),-1);
				if(thischamber==LOTS_RIFLERNDSPENT)aaa.scale.y=0.85;
				invoker.weaponstatus[i]=0;
			}else{
				//select factory or recast
				class<inventory>ammotype=
					thischamber==LOTS_RIFLERND?
					"SevenMilAmmo":"SevenMilAmmoRecast";
				if(A_JumpIfInventory(ammotype,0,"null")){
					actor aaa=spawn(ammotype,
						(pos.xy,pos.z+height-14)
						+(cosp*cos(angle),cosp*sin(angle),sin(pitch)-2)*3,
						ALLOW_REPLACE
					);
					aaa.vel=vel+(frandom(-1,1),frandom(-1,1),-1);
				}else{
					A_GiveInventory(ammotype,1);
					gotany=true;
				}
				invoker.weaponstatus[i]=0;
			}
		}
		if(gotany)A_StartSound("weapons/pocket",9);
	}
	action void A_FireRevolver(){
		invoker.weaponstatus[0]&=~LOTF_COCKED;
		int cyl=invoker.weaponstatus[LOTS_CYL1];
		int brl=invoker.weaponstatus[LOTS_BARREL];
        int scp=invoker.weaponstatus[LOTF_SCOPE];
		double velo=-1;
		double zrcl=0.795;
		double spread=1.4;
		if(brl==1)spread=1.1;
		if(brl==0)velo=0.98;	// + 0.87
		if(brl==1)velo=1.07;	// + 0.09
		if(brl==2)velo=1.02;    // + 0.04
		if(invoker.weaponstatus[0]&LOTF_PETUNIA)velo=1.444; //Flick's personal touch, inscribed for her great^n grandson
		bool recast=cyl==LOTS_RECASTRND;
		if(
			cyl!=LOTS_RIFLERND
			&&cyl!=LOTS_RECASTRND
			){
			A_StartSound("weapons/lotusclick",8,CHANF_OVERLAP);
			return;
		}
		invoker.weaponstatus[LOTS_CYL1]=1;
		let bbb=HDBulletActor.FireBullet(self,recast?"HDB_776r":"HDB_776",spread:spread,aimoffy:scp?(-HDCONST_GRAVITY/1000.)*invoker.weaponstatus[LOTS_DROPADJUST]:0,speedfactor:velo);
		if(
			frandom(0,ceilingz-floorz)<bbb.speed*0.4
		)A_AlertMonsters(brl==2?128:0); //maybe crank up difference?
		if(brl==1)zrcl=0.925;
		if(brl==2)zrcl=0.875;
		
		A_GunFlash();
		A_Light1();
		A_ZoomRecoil(zrcl);
		HDFlashAlpha(72);
		A_StartSound((brl==2?"weapons/lotusquiet":"weapons/lotusbang"),CHAN_WEAPON,CHANF_OVERLAP); //BANG!! You can't hit me.
		if(brl>0)A_MuzzleClimb(-frandom(3.8,4.6),-frandom(4.6,5.0));
		else A_MuzzleClimb(-frandom(4.4,5.2),-frandom(5.2,5.6));
	}
	int cooldown;
	action void A_ReadyOpen(){
		A_WeaponReady(WRF_NOFIRE|WRF_ALLOWUSER3);
		if(justpressed(BT_ALTATTACK))setweaponstate("open_rotatecylinder");
		else if(justpressed(BT_RELOAD)){
			if(
				(
					invoker.weaponstatus[LOTS_CYL1]>0
					&&invoker.weaponstatus[LOTS_CYL2]>0
					&&invoker.weaponstatus[LOTS_CYL3]>0
					&&invoker.weaponstatus[LOTS_CYL4]>0
					&&invoker.weaponstatus[LOTS_CYL5]>0
					&&invoker.weaponstatus[LOTS_CYL6]>0
				)||(
					!countinv("SevenMilAmmo")
					&&!countinv("SevenMilAmmoRecast")
				)
			)setweaponstate("open_closecylinder");
			else setweaponstate("open_loadround");
		}else if(justpressed(BT_ATTACK))setweaponstate("open_closecylinder");
		else if(justpressed(BT_UNLOAD)){
			if(!invoker.cooldown){
				setweaponstate("open_dumpcylinder");
				invoker.cooldown=6;
			}else{
				setweaponstate("open_dumpcylinder_all");
			}
		}
		if(invoker.cooldown>0)invoker.cooldown--;
	}
	action void A_RoundReady(int rndnm){
		int gunframe=-1;
		if(invoker.weaponstatus[rndnm]>0)gunframe=player.getpsprite(PSP_WEAPON).frame;
		let thissprite=player.getpsprite(LOTS_OVRCYL+rndnm);
		switch(gunframe){
		case 4: //E
			thissprite.frame=0;
			break;
		case 5: //F
			thissprite.frame=1;
			break;
		case 6: //G
			thissprite.frame=pressingzoom()?4:2;
			break;
		default:
			thissprite.sprite=getspriteindex("TNT1A0");
			thissprite.frame=0;
			return;break;
		}
	}
	action void A_CockHammer(bool yes=true){
		if(yes)invoker.weaponstatus[0]|=LOTF_COCKED;
		else invoker.weaponstatus[0]&=~LOTF_COCKED;
	}
	action void A_CheckLotusSprite(){
		bool hasscope=invoker.weaponstatus[0]&LOTF_SCOPE; //has either scope
		int hasbarrel=invoker.weaponstatus[LOTS_BARREL];
		if(hasscope){
			if(hasbarrel==0)player.getpsprite(PSP_WEAPON).sprite=getspriteindex("RRSCA0");
			if(hasbarrel==1)player.getpsprite(PSP_WEAPON).sprite=getspriteindex("LRSCA0");
			if(hasbarrel==2)player.getpsprite(PSP_WEAPON).sprite=getspriteindex("RSLCA0");
		}else{
			if(hasbarrel==0)player.getpsprite(PSP_WEAPON).sprite=getspriteindex("RRRVA0");
			if(hasbarrel==1)player.getpsprite(PSP_WEAPON).sprite=getspriteindex("LRRVA0");
			if(hasbarrel==2)player.getpsprite(PSP_WEAPON).sprite=getspriteindex("RRSLA0");
		}
	}
/*
	A normal ready
	B ready cylinder midframe
	C hammer fully cocked (maybe renumber these lol)
	D recoil frame
	E cylinder swinging out - left hand passing to right
	F cylinder swung out - held in right hand, working chamber in middle
	G cylinder swung out midframe
*/
	states{
	spawn:
		RRVL ABCDEF -1 nodelay{
			int brl=invoker.weaponstatus[LOTS_BARREL];
			if(invoker.weaponstatus[0]&LOTF_SCOPE){
				if(brl==0)frame=1;
				if(brl==1)frame=3;
				if(brl==2)frame=5;
			}else{
				if(brl==0)frame=0;
				if(brl==1)frame=2;
				if(brl==2)frame=4;
			}
		}stop;
	round1:RVC1 A 1 A_RoundReady(LOTS_CYL1);wait;
	round2:RVC2 A 1 A_RoundReady(LOTS_CYL2);wait;
	round3:RVC3 A 1 A_RoundReady(LOTS_CYL3);wait;
	round4:RVC4 A 1 A_RoundReady(LOTS_CYL4);wait;
	round5:RVC5 A 1 A_RoundReady(LOTS_CYL5);wait;
	round6:RVC6 A 1 A_RoundReady(LOTS_CYL6);wait;
	select0:
		RRRV A 0{
			A_TakeInventory("NulledWeapon");
			invoker.cylinderopen=false;
			invoker.weaponstatus[0]&=~LOTF_COCKED;

			//uncock all spare revolvers
			if(findinventory("SpareWeapons")){
				let spw=SpareWeapons(findinventory("SpareWeapons"));
				for(int i=0;i<spw.weapontype.size();i++){
					if(spw.weapontype[i]==invoker.getclassname()){
						string spw2=spw.weaponstatus[i];
						string spw1=spw2.left(spw2.indexof(","));
						spw2=spw2.mid(spw2.indexof(","));
						int stat0=spw1.toint();
						stat0&=~LOTF_COCKED;
						spw.weaponstatus[i]=stat0..spw2;
					}
				}
			}

			A_Overlay(LOTS_OVRCYL+LOTS_CYL1,"round1");
			A_Overlay(LOTS_OVRCYL+LOTS_CYL2,"round2");
			A_Overlay(LOTS_OVRCYL+LOTS_CYL3,"round3");
			A_Overlay(LOTS_OVRCYL+LOTS_CYL4,"round4");
			A_Overlay(LOTS_OVRCYL+LOTS_CYL5,"round5");
			A_Overlay(LOTS_OVRCYL+LOTS_CYL6,"round6");
		}
		---- A 1 A_Raise();
		---- A 1 A_Raise(40);
		---- A 1 A_Raise(40);
		---- A 1 A_Raise(25);
		---- A 1 A_Raise(20);
		wait;
	deselect0:
		RRRV A 0 A_CheckLotusSprite();
		#### A 0 A_JumpIf(!invoker.cylinderopen,"deselect0a");
		#### F 2;
		---- E 2 A_CloseCylinder();
		---- A 1;
		goto deselect0a;
	deselect0a:
		#### AA 1 A_Lower();
		---- A 1 A_Lower(20);
		---- A 1 A_Lower(34);
		---- A 1 A_Lower(50);
		wait;
	ready:
		RRRV A 0 {
			A_CheckLotusSprite();
			A_CheatFail();
			}
		#### A 0 A_JumpIf(invoker.cylinderopen,"readyopen");
		#### C 0 A_JumpIf(invoker.weaponstatus[0]&LOTF_COCKED,2);
		#### A 0;
		---- A 1{
			if(pressingzoom()&&invoker.weaponstatus[0]&LOTF_SCOPE){
				if(player.cmd.buttons&BT_USE)
					A_ZoomAdjust(LOTS_DROPADJUST,0,600,BT_USE);
				else{
					if(invoker.weaponstatus[0]&LOTF_PETUNIA)A_ZoomAdjust(LOTS_ZOOM,10,75);
					else A_ZoomAdjust(LOTS_ZOOM,18,50);
				}
				A_WeaponReady(WRF_NONE);
			}else A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3|WRF_ALLOWUSER4);
		}goto readyend;
	fire:
		#### A 0{
			if(invoker.weaponstatus[0]&LOTF_COCKED)setweaponstate("hammertime");
			else if(invoker.weaponstatus[0]&LOTF_SA)setweaponstate("firefail");
			}
		#### B 2 offset(0,34);
		#### C 4 offset(0,36) A_RotateCylinder();
		#### A 0 offset(0,32);
	hammertime:
		#### A 0 A_ClearRefire();
		#### A 1 A_FireRevolver();
		goto nope;
	firefail:
		#### A 0 A_ClearRefire();
		#### A 1 A_StartSound("weapons/lotusclick",8,CHANF_OVERLAP);
		goto nope;
	firerecoil:
		#### D 2;
		#### A 0;
		goto nope;
	flash:
		RRCF A 0 A_JumpIf(invoker.weaponstatus[0]&LOTF_SCOPE&&invoker.weaponstatus[LOTS_BARREL]==0,6);
		LRVF A 0 A_JumpIf(!(invoker.weaponstatus[0]&LOTF_SCOPE)&&invoker.weaponstatus[LOTS_BARREL]==1,5);
		LSCF A 0 A_JumpIf(invoker.weaponstatus[0]&LOTF_SCOPE&&invoker.weaponstatus[LOTS_BARREL]==1,4);
		TNT1 A 0 A_JumpIf(!(invoker.weaponstatus[0]&LOTF_SCOPE)&&invoker.weaponstatus[LOTS_BARREL]==2,3);	
		TNT1 A 0 A_JumpIf(invoker.weaponstatus[0]&LOTF_SCOPE&&invoker.weaponstatus[LOTS_BARREL]==2,2);		
		RRVF A 0;
		#### A 1 bright;
		---- A 0 A_Light0();
		---- A 0 setweaponstate("firerecoil");
		stop;
		RRRV ABCD 0;
		stop;
	altfire:
		#### A 0 A_JumpIf(invoker.weaponstatus[0]&LOTF_COCKED,"uncock");
		#### B 1 offset(0,34) A_ClearRefire();
		#### B 2 offset(0,36) A_RotateCylinder();
	cocked:
		#### C 0 A_CockHammer();
		---- A 0 A_JumpIf(pressingaltfire(),"nope");
		goto readyend;
	uncock:
		#### C 1 offset(0,38);
		#### B 1 offset(0,34);
		#### A 2 offset(0,36) A_StartSound("weapons/lotuscyl",8,CHANF_OVERLAP);
		#### A 0 A_CockHammer(false);
		goto nope;
	reload:
	unload:
		#### C 0 A_JumpIf(!(invoker.weaponstatus[0]&LOTF_COCKED),3);
		#### B 2 offset(0,35)A_CockHammer(false);
		#### A 2 offset(0,33);
		#### E 3 A_OpenCylinder();
		goto readyopen;
	openslow:
		#### A 1 offset(2,39);
		#### A 1 offset(4,50);
		#### A 1 offset(8,64);
		#### A 1 offset(10,86);
		#### A 1 offset(12,96);
		#### E 1 offset(-7,66);
		#### E 1 offset(-6,56);
		#### E 1 offset(-2,40);
		#### E 1 offset(0,32);
		#### E 1 A_OpenCylinder();
		goto readyopen;
	readyopen:
		#### F 1 A_ReadyOpen();
		goto readyend;
	open_rotatecylinder:
		#### G 3 A_RotateCylinder(pressingzoom());
		#### F 3 A_JumpIf(!pressingaltfire(),"readyopen");
		loop;
	open_loadround:
		#### F 3;
		#### F 2 A_LoadRound();
		goto open_rotatecylinder;
	open_closecylinder:
		#### E 2 A_JumpIf(pressingfire(),"open_fastclose");
		#### E 0 A_CloseCylinder();
		#### E 1 offset(0,32);
		#### E 1 offset(-2,40);
		#### E 1 offset(-6,56);
		#### E 1 offset(-7,66);
		#### A 1 offset(12,96);
		#### A 1 offset(10,86);
		#### A 1 offset(8,64);
		#### A 1 offset(4,50);
		#### A 1 offset(2,39);
		goto nope;
	open_fastclose:
		#### E 2;
		#### A 0 A_CloseCylinder();
		goto nope;
	open_dumpcylinder:
		#### F 3 A_HitExtractor();
		goto readyopen;
	open_dumpcylinder_all:
		#### F 1 offset(0,34);
		#### F 1 offset(0,42);
		#### F 1 offset(0,54);
		#### F 1 offset(0,68);
		TNT1 A 6 A_ExtractAll();
		
		RRSC F 0 A_JumpIf(invoker.weaponstatus[0]&LOTF_SCOPE&&invoker.weaponstatus[LOTS_BARREL]==0,6);
		LRRV F 0 A_JumpIf(!(invoker.weaponstatus[0]&LOTF_SCOPE)&&invoker.weaponstatus[LOTS_BARREL]==1,5);
		LRSC F 0 A_JumpIf(invoker.weaponstatus[0]&LOTF_SCOPE&&invoker.weaponstatus[LOTS_BARREL]==1,4);
		RRSL F 0 A_JumpIf(!(invoker.weaponstatus[0]&LOTF_SCOPE)&&invoker.weaponstatus[LOTS_BARREL]==2,3);
		RSLC F 0 A_JumpIf(invoker.weaponstatus[0]&LOTF_SCOPE&&invoker.weaponstatus[LOTS_BARREL]==2,2);
		RRRV F 0;
		
		#### F 1 offset(0,68);
		#### F 1 offset(0,54);
		#### F 1 offset(0,42);
		#### F 1 offset(0,34);
		goto readyopen;
	}
	override void loadoutconfigure(string input){
		int sa=getloadoutvar(input,"sa",1);
		if(sa>=0)weaponstatus[0]|=LOTF_SA;
		int scope=getloadoutvar(input,"scope",1);
		if(scope>=0)weaponstatus[0]|=LOTF_SCOPE;
		int barrel=getloadoutvar(input,"barrel",1);
		if(barrel>=0)weaponstatus[LOTS_BARREL]=1;
        if(barrel>0)weaponstatus[LOTS_DROPADJUST]=100;
		int suppressor=getloadoutvar(input,"suppressor",1);
		if(suppressor>=0)weaponstatus[LOTS_BARREL]=2;
        if(suppressor>0)weaponstatus[LOTS_DROPADJUST]=100;
		
		int bulletdrop=getloadoutvar(input,"bulletdrop",3);
		if(bulletdrop>=0)weaponstatus[LOTS_DROPADJUST]=clamp(bulletdrop,0,600);
		int zoom=getloadoutvar(input,"zoom",3);
		if(zoom>0)weaponstatus[LOTS_ZOOM]=clamp(zoom,18,50);
		
		int sweetpetunia=getloadoutvar(input,"guidingmoonlight",1); //Oh Sweet Petunia, canon Agt. Espinosa
		if(
			sweetpetunia>=0
			&&pepper_cheats>0
		){
			weaponstatus[0]|=LOTF_PETUNIA;
			weaponstatus[0]|=LOTF_SCOPE;
			weaponstatus[LOTS_BARREL]=2;
		}
		else if(sweetpetunia>0)weaponstatus[0]|=CHEATF_FAIL;
	}
}
enum lotusvolverStats{
	//chamber 1 is the shooty one
	LOTS_CYL1=1,
	LOTS_CYL2=2,
	LOTS_CYL3=3,
	LOTS_CYL4=4,
	LOTS_CYL5=5,
	LOTS_CYL6=6,
	LOTS_OVRCYL=355,

	LOTS_RIFLERNDSPENT=1,
	LOTS_RIFLERND=2,
	LOTS_RECASTRND=3,
	LOTS_BARREL=7, //0 none, 1 xbarrel, 2 suppressor
	LOTS_ZOOM=8, //18-50 zoom, 10-75 for Petunia
	LOTS_DROPADJUST=9,

	LOTF_COCKED=1,
	LOTF_SCOPE=2, //Lotus Scope
	LOTF_SA=4, //Single-Action Trigger
	LOTF_PETUNIA=8 //Agt. Espinosa's Sweet Petunia
}

class LotusSpawn:IdleDummy{
	states{
	spawn:
		TNT1 A 0 nodelay{
			let zzz=HDLotus(spawn("HDLotus",pos,ALLOW_REPLACE));
			if(!zzz)return;
			HDF.TransferSpecials(self, zzz);
			if(!random(0,4))zzz.weaponstatus[0]|=LOTF_SCOPE;
			if(!random(0,2)){
				if(!random(0,2))zzz.weaponstatus[LOTS_BARREL]=1;
				else zzz.weaponstatus[LOTS_BARREL]=2;
			}
			spawn("HD7mBoxPickup",pos+(3,0,0),ALLOW_REPLACE);
		}stop;
	}
}
